    "HINT_FLOW_03": [
        "YOU CAN START PLAYING\nDAY II LEVELS EVEN\nBEFORE COMPLETING DAY I",
        "\u60a8\u751a\u81f3\u53ef\u4ee5\u5728\n\u5b8c\u6210\u7b2c\u4e00\u5929\u5173\u5361\u524d\n\u73a9\u7b2c\u4e8c\u5929\u5173\u5361",
        "DAY I \u3092\u30af\u30ea\u30a2\u3057\u3066\u3044\u306a\u304f\u3066\u3082\nDAY II \u3092\u904a\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u3088\uff01",
        "VOUS POUVEZ COMMENCER \u00c0 JOUER\nAUX NIVEAUX DU JOUR II\nAVANT D'AVOIR TERMIN\u00c9 LE JOUR I",
        "DU KANNST MIT DEN\nLEVELN VON TAG II ANFANGEN,\nBEVOR DU TAG I ABGESCHLOSSEN HAST",
        "1\uc77c\ucc28 \ub808\ubca8\uc744\n\uc644\ub8cc\ud558\uc9c0 \uc54a\uc544\ub3c4\n2\uc77c\ucc28 \ub808\ubca8\uc744 \uc2dc\uc791\ud560 \uc218 \uc788\uc5b4\uc694.",
        "PUOI COMINCIARE A GIOCARE\nAI LIVELLI GIORNO II ANCHE PRIMA\nDI AVER COMPLETATO GIORNO I!",
        "\u0423\u0420\u041e\u0412\u041d\u0418 \u0414\u041d\u042f II \u041c\u041e\u0416\u041d\u041e \u041d\u0410\u0427\u0410\u0422\u042c\n\u041f\u0420\u041e\u0425\u041e\u0414\u0418\u0422\u042c \u0414\u0410\u0416\u0415 \u0414\u041e\n\u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041d\u0418\u042f \u0414\u041d\u042f I",
        "NEM\u016e\u017dE\u0160 ZA\u010c\u00cdT HR\u00c1T\n\u00daROVN\u011a ZE DNE II NE\u017d\nDOKON\u010c\u00cd\u0160 DEN I",
        "VOIT ALOITTAA 2. P\u00c4IV\u00c4N\nKENTTIEN PELAAMISEN JO\nENNEN 1. P\u00c4IV\u00c4N L\u00c4P\u00c4ISY\u00c4",
        "VOC\u00ca PODE COME\u00c7AR A JOGAR\nOS N\u00cdVEIS DO DIA 2 MESMO\nSEM COMPLETAR O DIA 1",
        "PUEDES EMPEZAR A JUGAR\nLOS NIVELES DEL D\u00cdA II\nSIN COMPLETAR EL D\u00cdA I"
    ],
    "POP_PUSH_ENABLED_NOTE": [
        "YOU WILL RECEIVE INFO WHEN\nNEW LEVELS AND CONTENT ARE AVAILABLE",
        "\u60a8\u4f1a\u5728\u65b0\u5173\u5361\u548c\u5185\u5bb9\n\u63a8\u51fa\u65f6\u83b7\u5f97\u901a\u77e5\u3002",
        "\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u3084\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u5229\u7528\u53ef\u80fd\u306b\n\u306a\u3063\u305f\u6642\u306b\u304a\u77e5\u3089\u305b\u3092\u53d7\u3051\u53d6\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002",
        "VOUS RECEVREZ DES INFOS SUR LES \nNOUVEAUX NIVEAUX ET CONTENUS.",
        "DU ERH\u00c4LTST INFOS, WENN NEUE LEVEL\nUND INHALTE VERF\u00dcGBAR SIND.",
        "\uc0c8 \ub808\ubca8\uacfc \ucf58\ud150\uce20\uac00 \uc788\uc73c\uba74\n\uc815\ubcf4\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\n(\uac1c\ubc1c\uc790\ub85c\ubd80\ud130 - \uc2a4\ud338 \uc544\ub2d8)",
        "RICEVERAI UN AVVISO QUANDO\nNUOVI LIVELLI E CONTENUTI SONO DISPONIBILI.",
        "\u0412\u042b \u0411\u0423\u0414\u0415\u0422\u0415 \u041f\u041e\u041b\u0423\u0427\u0410\u0422\u042c \u0418\u041d\u0424\u041e\u0420\u041c\u0410\u0426\u0418\u042e\n\u041e \u0414\u041e\u0421\u0422\u0423\u041f\u041d\u041e\u0421\u0422\u0418 \u041d\u041e\u0412\u042b\u0425 \u0423\u0420\u041e\u0412\u041d\u0415\u0419 \u0418 \u041a\u041e\u041d\u0422\u0415\u041d\u0422\u0410.",
        "V P\u0158\u00cdPAD\u011a DOSTUPNOSTI NOV\u00ddCH \u00daROVN\u00cd A OBSAHU\nOBDR\u017d\u00cd\u0160 INFORMACE",
        "SAAT ILMOITUKSEN UUSISTA\nKENTIST\u00c4 JA SIS\u00c4LL\u00d6ST\u00c4,\nKUN NE JULKAISTAAN.",
        "VOC\u00ca RECEBER\u00c1 INFORMA\u00c7\u00d5ES QUANDO\nNOVOS N\u00cdVEIS E CONTE\u00daDOS ESTIVEREM DISPON\u00cdVEIS.",
