    "ACH_45": [
        "DO NOT STOP TIME IN THE LEVEL FLIPPING IN SINGLE PLAYER",
        "\u5728\u5355\u4eba\u6e38\u620f\u4e2d\u5728\u7ffb\u8f6c\u4e00\u5173\u4e0d\u505c\u6b62\u65f6\u95f4",
        "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30fb\u30e2\u30fc\u30c9\u3067\u30ec\u30d9\u30eb\u300cFLIPPING\u300d\u3067\u6642\u9593\u3092\u6b62\u3081\u306a\u3044",
