        "\uc2dc\uc2a4\ud15c\uc5d0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc0c8 \ub370\uc774\ud130 \uc0dd\uc131",
