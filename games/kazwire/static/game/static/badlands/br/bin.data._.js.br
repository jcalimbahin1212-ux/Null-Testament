    "ACH_44": [
        "DO NOT PRESS ANY BUTTONS IN THE LEVEL UNBUTTON IN SINGLE PLAYER",
        "\u5728\u5355\u4eba\u6e38\u620f\u4e2d\u5728\u53d6\u6d88\u6309\u94ae\u4e00\u5173\u4e0d\u6309\u4efb\u4f55\u6309\u94ae",
        "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30fb\u30e2\u30fc\u30c9\u3067\u30ec\u30d9\u30eb\u300cUNBUTTON\u300d\u3067\u30dc\u30bf\u30f3\u3092\u4e00\u3064\u3082\u62bc\u3055\u306a\u3044",
