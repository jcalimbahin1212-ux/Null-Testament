        "TREME A C\u00c2MERA DO JOGO",
        "HACE VIBRAR LA C\u00c1MARA DEL JUEGO"
    ],
    "HELP_OBJECTPROPERTIES_84_4": [
        "TAKES THE GAME CAMERA TO THIS POSITION",
        "\u5c06\u6e38\u620f\u955c\u5934\u5e26\u5230\u8fd9\u4e2a\u4f4d\u7f6e",
        "\u30b2\u30fc\u30e0\u30ab\u30e1\u30e9\u3092\u3053\u306e\u4f4d\u7f6e\u3078\u79fb\u52d5\u3055\u305b\u307e\u3059",
        "AM\u00c8NE LA CAM\u00c9RA DANS CETTE POSITION",
        "F\u00dcHRT DIE KAMERA AN DIESE POSITION",
        "\uac8c\uc784 \uce74\uba54\ub77c\ub97c \uc774 \uc704\uce58\ub85c \uc774\ub3d9",
        "PORTA LA VISUALE DI GIOCO IN QUESTA POSIZIONE",
        "\u041f\u0415\u0420\u0415\u041d\u0415\u0421\u0422\u0418 \u041a\u0410\u041c\u0415\u0420\u0423 \u0418\u0413\u0420\u042b \u0412 \u042d\u0422\u041e\u0422 \u041f\u0423\u041d\u041a\u0422",
