    "HINT_RERUN_01": [
        "PLAYING WITH HEADPHONES\nGIVES THE BEST\nGAMING EXPERIENCE",
        "\u6234\u4e0a\u8033\u673a\u73a9\u6e38\u620f\n\u611f\u53d7\u6700\u4f73\n\u6e38\u620f\u4f53\u9a8c",
        "\u30d8\u30c3\u30c9\u30db\u30f3\u3092\u4ed8\u3051\u3066\u30d7\u30ec\u30a4\u3059\u308b\u3068\n\u30b2\u30fc\u30e0\u3092\u3082\u3063\u3068\u697d\u3057\u3081\u308b\u3088",
        "JOUEZ AVEC DES \u00c9COUTEURS\nPOUR PROFITER PLEINEMENT\nDU JEU",
        "SPIELEN MIT KOPFH\u00d6RER\nBIETET DAS\nBESTE SPIELERLEBNIS",
        "\ud5e4\ub4dc\ud3f0\uc744 \ucc29\uc6a9\ud558\uba74\n\uac8c\uc784\uc5d0 \ub354\n\ubab0\uc785\ud560 \uc218 \uc788\uc5b4\uc694.",
        "GIOCA CON LE CUFFIE\nPER GODERE DI UNA MIGLIORE\nESPERIENZA DI GIOCO!",
