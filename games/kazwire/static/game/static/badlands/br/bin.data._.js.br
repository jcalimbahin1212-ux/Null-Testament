    "ACH_46": [
        "SAVE TWO CLONES IN THE LEVEL OBLIVION IN SINGLE PLAYER",
        "\u5728\u5355\u4eba\u6e38\u620f\u4e2d\u5728\u9057\u5fd8\u4e00\u5173\u62ef\u6551\u4e24\u4e2a\u514b\u9686",
        "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30fb\u30e2\u30fc\u30c9\u3067\u30ec\u30d9\u30eb\u300cOBLIVION\u300d\u3067\u30af\u30ed\u30fc\u30f3\u30922\u4f53\u6551\u3046",
        "SAUVEZ DEUX CLONES DANS LE NIVEAU OBLIVION EN MODE SOLO",
        "RETTE ZWEI KLONE IM LEVEL AUSRADIERT (EINZELSPIELER)",
        "\uc2f1\uae00\ud50c\ub808\uc774\uc5d0\uc11c\uc624\ube14\ub9ac\ube44\uc5b8 \ub808\ubca8\uc5d0\uc11c \ud074\ub860 2\ub9c8\ub9ac \uad6c\ucd9c",
        "SALVA DUE CLONI IN OBLIO DA GIOCATORE SINGOLO",
        "\u0421\u041f\u0410\u0421\u0418\u0422\u0415 \u0414\u0412\u0423\u0425 \u041a\u041b\u041e\u041d\u041e\u0412 \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u0415  \u00ab\u0417\u0410\u0411\u0412\u0415\u041d\u0418\u0415\u00bb \u0412 \u0420\u0415\u0416\u0418\u041c\u0415 \u041e\u0414\u0418\u041d\u041e\u0427\u041d\u041e\u0419 \u0418\u0413\u0420\u042b",
        "ZACHRA\u0147 DVA KLONY V \u00daROVNI ZAPOMENUT\u00cd (JEDNOHO HR\u00c1\u010cE)",
        "PELASTA 2 KLOONIA KADOTUS-KENT\u00c4SS\u00c4 YKSINPELISS\u00c4",
        "SALVE DOIS CLONES NO N\u00cdVEL ESQUECIMENTO EM SINGLE PLAYER",
        "SALVA A DOS CLONES EN EL NIVEL OBLIVION EN EL MODO DE 1 JUGADOR"
    ],
