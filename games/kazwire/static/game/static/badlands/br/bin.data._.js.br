    "IAP_DAY_II_DESC": [
        "- 40 NEW LEVELS\n- 120 NEW MISSIONS\n- 17 NEW ACHIEVEMENTS\n- REMOVES ALL ADS\n- PLAY INSTANTLY",
        "- 40\u4e2a\u65b0\u5173\u5361\n- 120\u4e2a\u65b0\u4efb\u52a1\n- 17\u4e2a\u65b0\u6210\u5c31\n- \u79fb\u9664\u6240\u6709\u5e7f\u544a\n- \u7acb\u5373\u6e38\u620f",
        "\uff0d40\u306e\u65b0\u3057\u3044\u30ec\u30d9\u30eb\n\uff0d120\u306e\u65b0\u3057\u3044\u30df\u30c3\u30b7\u30e7\u30f3\n\uff0d17\u306e\u65b0\u3057\u3044\u5b9f\u7e3e \n\uff0d\u5168\u3066\u306e\u5e83\u544a\u3092\u6392\u9664\n\uff0d\u4eca\u3059\u3050\u30d7\u30ec\u30a4\u53ef\u80fd",
        "- 40 NOUVEAUX NIVEAUX\n- 120 NOUVELLES MISSIONS\n- 17 NOUVEAUX SUCC\u00c8S\n- SUPPRIME LES PUBS\n- JOUEZ INSTANTAN\u00c9MENT",
        "- 40 NEUE LEVEL\n- 120 NEUE MISSIONEN\n- 17 NEUE ERFOLGE\n- ENTFERNT ALLE WERBUNG\n- SOFORT ZU SPIELEN",
        "- 40\uac1c\uc758 \uc0c8 \ub808\ubca8\n- 120\uac1c\uc758 \uc0c8 \ubbf8\uc158\n- 17\uac1c\uc758 \uc0c8 \ub3c4\uc804 \uacfc\uc81c\n- \ubaa8\ub4e0 \uad11\uace0 \uc81c\uac70\n- \ube60\ub978 \ud50c\ub808\uc774",
        "- 40 NUOVI LIVELLI\n- 120 NUOVE MISSIONI\n- 17 NUOVI OBIETTIVI\n- RIMUOVI LE PUBBLICIT\u00c0\n- GIOCA IMMEDIATAMENTE",
        "- 40 \u041d\u041e\u0412\u042b\u0425 \u0423\u0420\u041e\u0412\u041d\u0415\u0419\n- 120 \u041d\u041e\u0412\u042b\u0425 \u0417\u0410\u0414\u0410\u041d\u0418\u0419\n- 17 \u041d\u041e\u0412\u042b\u0425 \u0414\u041e\u0421\u0422\u0418\u0416\u0415\u041d\u0418\u0419\n- \u0423\u0414\u0410\u041b\u0415\u041d\u0410 \u0412\u0421\u042f \u0420\u0415\u041a\u041b\u0410\u041c\u0410\n- \u0418\u0413\u0420\u0410\u0419\u0422\u0415 \u0411\u0415\u0417 \u041f\u0420\u041e\u041c\u0415\u0414\u041b\u0415\u041d\u0418\u042f",
        "- 40 NOV\u00ddCH \u00daROVN\u00cd\n- 120 NOV\u00ddCH MIS\u00cd\n- 17 NOV\u00ddCH OCEN\u011aN\u00cd\n- BEZ REKLAM\n- OKAM\u017dIT\u00c9 HRAN\u00cd",
        "- 40 UUTTA KENTT\u00c4\u00c4\n- 120 UUTTA TEHT\u00c4V\u00c4\u00c4\n- 17 UUTTA SAAVUTUSTA\n- MAINOSTEN POISTO\n- PELAA HETI!",
