    "HINT_FLOW_00": [
        "COMPLETED A LEVEL?\nPLAY IT AGAIN TO SAVE\nMORE CLONES!",
        "\u901a\u8fc7\u4e86\u4e00\u5173\uff1f\n\u518d\u73a9\u4e00\u6b21\n\u62ef\u6551\u66f4\u591a\u514b\u9686\uff01",
        "\u30ec\u30d9\u30eb\u3092\u5168\u90e8\u30af\u30ea\u30a2\u3067\u304d\u305f\uff1f\n\u3082\u3046\u4e00\u5ea6\u30d7\u30ec\u30a4\u3057\u3066\u3001\n\u3082\u3063\u3068\u591a\u304f\u306e\u30af\u30ed\u30fc\u30f3\u3092\u6551\u304a\u3046\uff01",
        "VOUS AVEZ TERMIN\u00c9 UN NIVEAU\u00a0?\nREJOUEZ-Y POUR SAUVER\nPLUS DE CLONES\u00a0!",
        "EIN LEVEL ABGESCHLOSSEN?\nSPIELE IHN NOCH EINMAL,\nUM MEHR KLONE ZU RETTEN!",
        "\ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub098\uc694?\n\ud074\ub860\uc744 \ub354 \uad6c\ucd9c\ud558\ub824\uba74\n\ub2e4\uc2dc \ud50c\ub808\uc774\ud558\uc138\uc694!",
        "HAI COMPLETATO UN LIVELLO?\nGIOCALO DI NUOVO PER\nSALVARE ALTRI CLONI!",
        "\u0423\u0420\u041e\u0412\u0415\u041d\u042c \u041f\u0420\u041e\u0419\u0414\u0415\u041d?\n\u041f\u0420\u041e\u0419\u0414\u0418\u0422\u0415 \u0415\u0413\u041e \u0415\u0429\u0415 \u0420\u0410\u0417, \u0427\u0422\u041e\u0411\u042b \u0421\u041f\u0410\u0421\u0422\u0418\n\u0411\u041e\u041b\u042c\u0428\u0415 \u041a\u041b\u041e\u041d\u041e\u0412!",
