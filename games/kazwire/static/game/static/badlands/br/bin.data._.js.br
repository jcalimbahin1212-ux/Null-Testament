    "CONNECT_INTERNET_CROSS_SAVE": [
        "YOU ARE NOT CONNECTED TO THE INTERNET. CROSS-SAVE DATA WON'T BE SYNCED.",
        "\u60a8\u672a\u8fde\u63a5\u81f3\u7f51\u7edc\u3002\u5c06\u4e0d\u540c\u6b65CROSS-SAVE\u6570\u636e\u3002",
        "\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u306b\u63a5\u7d9a\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u30af\u30ed\u30b9\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306f\u540c\u671f\u3055\u308c\u307e\u305b\u3093\u3002",
        "VOUS N'\u00caTES PAS CONNECT\u00c9 \u00c0 INTERNET. LES DONN\u00c9ES DE SAUVEGARDE CROSS-SAVE NE SERONT PAS SYNCHRONIS\u00c9ES.",
        "DU BIST NICHT MIT DEM INTERNET VERBUNDEN. CROSS-SAVE-DATEN WERDEN NICHT SYNCHRONISIERT.",
        "\uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uad50\ucc28 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",
        "NON SEI COLLEGATO A INTERNET. IL SALVATAGGIO CROSS-SAVE NON SAR\u00c0 SINCRONIZZATO.",
        "\u0412\u042b \u041d\u0415 \u041f\u041e\u0414\u041a\u041b\u042e\u0427\u0415\u041d\u042b \u041a \u0418\u041d\u0422\u0415\u0420\u041d\u0415\u0422\u0423. \u0414\u0410\u041d\u041d\u042b\u0415 CROSS-SAVE \u041d\u0415 \u0411\u0423\u0414\u0423\u0422 \u0421\u0418\u041d\u0425\u0420\u041e\u041d\u0418\u0417\u0418\u0420\u041e\u0412\u0410\u041d\u042b.",
        "NEJSTE P\u0158IPOJENI K S\u00cdTI INTERNET. DATA CLOUDU CROSS-SAVE NEBUDOU SYNCHRONIZOV\u00c1NA.",
        "ET OLE YHTEYDESS\u00c4 INTERNETIIN. CROSS-SAVE-TIETOJA EI SYNKRONOIDA.",
        "VOC\u00ca N\u00c3O EST\u00c1 CONECTADO \u00c0 INTERNET. OS DADOS DE CROSS-SAVE N\u00c3O SER\u00c3O SINCRONIZADOS.",
        "NO EST\u00c1S CONECTADO A INTERNET. LOS DATOS CROSS-SAVE NO SE SINCRONIZAR\u00c1N."
    ],
