        "\u7531\u4e8e\u53d7\u5230\u5bb6\u957f\u63a7\u5236\u9650\u5236\uff0c\u60a8\u7684\u201cPLAYSTATION NETWORK\u201d\u5728\u7ebf\u670d\u52a1\u5df2\u7981\u7528\u3002",
        "\u30da\u30a2\u30ec\u30f3\u30bf\u30eb\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u5236\u9650\u304c\"PLAYSTATION NETWORK\"\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u304b\u3051\u3089\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u30b5\u30fc\u30d3\u30b9\u306b\u63a5\u7d9a\u3067\u304d\u307e\u305b\u3093\u3002",
        "LES SERVICES EN LIGNE SERONT DESACTIVES SUR VOTRE COMPTE \"PLAYSTATION NETWORK\" EN RAISON DE RESTRICTIONS LIEES AU CONTROLE PARENTAL.",
        "ONLINE-DIENSTE SIND FUER DEIN \"PLAYSTATION NETWORK\"-KONTO AUFGRUND DER KINDERSICHERUNG DEAKTIVIERT.",
        "\uc790\ub140 \ubcf4\ud638 \uc81c\ud55c\uc774 \uc124\uc815\ub418\uc5b4 \uc788\uc5b4 \"PLAYSTATION NETWORK\" \uacc4\uc815\uc758 \uc628\ub77c\uc778 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",
        "I SERVIZI ONLINE DEL TUO \"PLAYSTATION NETWORK\" SONO DISABILITATATI PER LE RESTRIZIONI DEL CONTROLLO GENITORI.",
        "\u0421\u0415\u0422\u0415\u0412\u042b\u0415 \u0421\u041b\u0423\u0416\u0411\u042b \u041e\u0422\u041a\u041b\u042e\u0427\u0415\u041d\u042b \u0414\u041b\u042f \u0412\u0410\u0428\u0415\u0419 \u0423\u0427\u0415\u0422\u041d\u041e\u0419 \u0417\u0410\u041f\u0418\u0421\u0418 \"PLAYSTATION NETWORK\" \u0418\u0417-\u0417\u0410 \u041e\u0413\u0420\u0410\u041d\u0418\u0427\u0415\u041d\u0418\u0419 \u0420\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u0421\u041a\u041e\u0413\u041e \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042f.",
        "ONLINE SLU\u017dBY JSOU VE VA\u0160EM \u00da\u010cTU \u201ePLAYSTATION NETWORK\u201c ZAK\u00c1Z\u00c1NY Z D\u016eVODU OMEZEN\u00cd RODI\u010cOVSK\u00c9HO Z\u00c1MKU.",
        "\"PLAYSTATION NETWORK\"-TILISI VERKKOPALVELUT EIV\u00c4T OLE K\u00c4YT\u00d6SS\u00c4 LAPSILUKKOASETUSTEN VUOKSI.",
        "OS SERVI\u00c7OS ONLINE EST\u00c3O DESABILITADOS NA SUA CONTA \"PLAYSTATION NETWORK\" DEVIDO A RESTRI\u00c7\u00d5ES DE CONTROLE PARENTAL.",
        "LOS SERVICIOS ONLINE ESTAN DESACTIVADOS EN TU CUENTA DE \"PLAYSTATION NETWORK\" POR RESTRICCIONES DE CONTROL PARENTAL."
    ],
