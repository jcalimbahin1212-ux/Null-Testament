        "STOPS GAME CAMERA MOVEMENT",
        "\u505c\u6b62\u6e38\u620f\u955c\u5934\u79fb\u52a8",
        "\u30b2\u30fc\u30e0\u30ab\u30e1\u30e9\u306e\u79fb\u52d5\u3092\u505c\u6b62\u3055\u305b\u307e\u3059",
        "ARR\u00caTE LE MOUVEMENT DE LA CAM\u00c9RA",
        "STOPPT DIE SPIELKAMERA-BEWEGUNG",
        "\uac8c\uc784 \uce74\uba54\ub77c \uc774\ub3d9 \uc815\uc9c0",
        "INTERROMPE MOVIMENTO VISUALE DI GIOCO",
        "\u041f\u0420\u0415\u041a\u0420\u0410\u0422\u0418\u0422\u042c \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u0415 \u041a\u0410\u041c\u0415\u0420\u042b",
