    "OVERSCAN_INFO": [
        "USE UP\/DOWN ARROWS TO ADJUST THE SCREEN'S SIZE. PRESS",
        "\u4f7f\u7528\u5411\u4e0a\/\u5411\u4e0b\u7bad\u5934\u8c03\u6574\u5c4f\u5e55\u7684\u5927\u5c0f\u3002\u6309\u4e0b",
        "\u4e0a\u4e0b\u306e\u77e2\u5370\u3092\u4f7f\u3063\u3066\u753b\u9762\u30b5\u30a4\u30ba\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u62bc\u3059\uff1a",
        "UTILISEZ LES TOUCHES HAUT\/BAS POUR AJUSTER LA TAILLE DE L'\u00c9CRAN. APPUYEZ SUR",
        "BENUTZE DIE RICHTUNGSTASTEN, UM DIE BILDSCHIRMGR\u00d6\u00dfE ANZUPASSEN. DR\u00dcCKE",
        "\uc704\/\uc544\ub798 \ud654\uc0b4\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud654\uba74 \ud06c\uae30\ub97c \uc870\uc808\ud569\ub2c8\ub2e4. \ub204\ub974\uae30",
        "USA LE FRECCE SU\/GI\u00d9 PER MODIFICARE LE DIMENSIONI DELLO SCHERMO. PREMI",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0421\u0422\u0420\u0415\u041b\u041a\u0418 \u0412\u0412\u0415\u0420\u0425\/\u0412\u041d\u0418\u0417 \u0414\u041b\u042f \u041d\u0410\u0421\u0422\u0420\u041e\u0419\u041a\u0418 \u0420\u0410\u0417\u041c\u0415\u0420\u0410 \u042d\u041a\u0420\u0410\u041d\u0410. \u041d\u0410\u0416\u041c\u0418\u0422\u0415",
        "PRO NASTAVEN\u00cd VELIKOSTI OBRAZOVKY POU\u017dIJTE \u0160IPKY NAHORU\/DOL\u016e. STISKNUT\u00cdM",
        "MUUTA N\u00c4YT\u00d6N KOKOA YL\u00c4- JA ALANUOLELLA. HYV\u00c4KSY MUUTOKSET JA JATKA PAINAMALLA",
        "USE AS SETAS PARA CIMA\/BAIXO PARA AJUSTAR O TAMANHO DA TELA. PRESSIONE",
        "PULSA ARRIBA\/ABAJO PARA AJUSTAR EL TAMA\u00d1O DE LA PANTALLA. PULSA"
    ],
