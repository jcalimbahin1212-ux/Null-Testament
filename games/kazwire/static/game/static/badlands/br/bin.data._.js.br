    "ACH_57": [
        "NO ONE DIES AND NO CLONE POWERUPS COLLECTED IN THE LEVEL HIGH SPEED IN COOP",
        "\u5728\u5408\u4f5c\u6a21\u5f0f\u4e0b\u5728\u7b2c\u9ad8\u901f\u5173\u5361\u4e2d\u65e0\u4eba\u5458\u4f24\u4ea1\uff0c\u800c\u4e14\u6ca1\u6709\u6536\u96c6\u5230\u514b\u9686\u80fd\u529b\u5347\u7ea7\u9053\u5177",
        "\u5354\u529b\u30e2\u30fc\u30c9\u3067\u30ec\u30d9\u30ebHIGH SPEED\u3067\u4e00\u4eba\u3082\u6b7b\u306a\u305a\u3001\u30af\u30ed\u30fc\u30f3\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u53d6\u3089\u306a\u3044",
        "PERSONNE NE MEURT ET AUCUN POWER-UP DE CLONE N'EST COLLECT\u00c9 AU NIVEAU HIGH SPEED EN COOP",
        "NIEMAND STIRBT UND KEINE KLON-POWERUPS GESAMMELT IM LEVEL HIGH SPEED IM KOOP-MODUS",
        "\ud611\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c\uc0ac\ub9dd\uc790\ub3c4 \uc5c6\uace0 \ud074\ub860 \ud30c\uc6cc\uc5c5\ub3c4 \uc218\uc9d1\ud558\uc9c0 \uc54a\uc740 \ub808\ubca8 \ud558\uc774 \uc2a4\ud53c\ub4dc",
        "NESSUNO MUORE E NESSUN POWER-UP \u00c8 RACCOLTO NEL LIVELLO RAZZO IN COOP",
        "\u041d\u0418\u041a\u0422\u041e \u041d\u0415 \u0423\u041c\u0418\u0420\u0410\u0415\u0422 \u0418 \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u0415 \u00ab\u0421\u041a\u041e\u0420\u041e\u0421\u0422\u042c\u00bb \u041d\u0415 \u041f\u041e\u0414\u0411\u0418\u0420\u0410\u042e\u0422 \u0411\u041e\u041d\u0423\u0421\u042b \u041a\u041b\u041e\u041d\u041e\u0412 \u0412 \u0421\u041e\u0412\u041c\u0415\u0421\u0422\u041d\u041e\u041c \u0420\u0415\u0416\u0418\u041c\u0415",
        "NIKDO NEZEM\u0158E A \u017d\u00c1DN\u00c9 BONUSY NEBUDOU POSB\u00cdR\u00c1NY V \u00daROVNI RYCHLOST V KOOPERACI",
        "EI KUOLEMIA EIK\u00c4 YHT\u00c4\u00c4N KER\u00c4TTY\u00c4 KLOONILIS\u00c4VOIMAA \nYHTEISPELISS\u00c4 KENT\u00c4SS\u00c4 VIUHAHDUS",
        "NINGU\u00c9M MORRE + SEM PODERES CLONE COLETADOS NO N\u00cdVEL ALTA VEL\u00d4 EM COOP",
        "NADIE MUERE NI COGE PODERES DE CLON EN EL NIVEL HIGH SPEED EN MODO COOPERATIVO"
    ],
