        "LEVEL-ERZEUGER",
        "\ub808\ubca8 \uc81c\uc791\uae30",
        "CREATORE LIVELLI",
        "\u041a\u041e\u041d\u0421\u0422\u0420\u0423\u041a\u0422\u041e\u0420 \u0423\u0420\u041e\u0412\u041d\u0415\u0419",
