    "DLC_END_SCREEN_DESC_2": [
        "GET THE FULL DAYDREAM PACK\nWITH 7 MORE LEVELS",
        "\u83b7\u5f97\u5b8c\u6574\u7684\u767d\u65e5\u68a6\u5173\u5361\u5305\n\u65b0\u589e7\u4e2a\u5173\u5361",
        "\u300c\u767d\u663c\u5922\u300d\u30d1\u30c3\u30af\u5b8c\u5168\u7248\u3092\u624b\u306b\u5165\u308c\u3066\n7\u3064\u306e\u8ffd\u52a0\u30ec\u30d9\u30eb\u3092\u5165\u624b\u3057\u3088\u3046",
        "ACHETEZ LE PACK R\u00caVE \u00c9VEILL\u00c9 COMPLET\nAVEC 7 NIVEAUX SUPPL\u00c9MENTAIRES",
        "ERHALTE DAS TAGTRAUMPAKET\nMIT 7 WEITEREN LEVELN",
        "\ubc31\uc77c\ubabd \ud329\uc73c\ub85c\n7\uac1c\uc758 \ucd94\uac00 \ub808\ubca8\uc744 \uc990\uae30\uc138\uc694.",
        "PRENDI IL PACK DAYDREAM \nCOMPLETO (7 LIVELLI EXTRA)",
        "\u041f\u041e\u041b\u0423\u0427\u0418\u0422\u0415 \u041f\u041e\u041b\u041d\u042b\u0419 \u041d\u0410\u0411\u041e\u0420  \u00ab\u0414\u0415\u041d\u042c \u041c\u0415\u0427\u0422\u042b\u00bb\n\u0421 7 \u041d\u041e\u0412\u042b\u041c\u0418 \u0423\u0420\u041e\u0412\u041d\u042f\u041c\u0418",
        "Z\u00cdSKEJ CEL\u00dd BAL\u00cd\u010cEK BLOUZN\u011aN\u00cd.\nS DAL\u0160\u00cdMI 7 \u00daROVN\u011aMI",
        "OSTA P\u00c4IV\u00c4UNI-T\u00c4YS-\nPAKETTI: 7 LIS\u00c4KENTT\u00c4\u00c4",
        "RECEBA O PACOTE DEVANEIO\nCOM MAIS 7 N\u00cdVEIS",
        "CONSIGUE EL PACK D\u00cdA DE\nENSUE\u00d1O CON 7 NIVELES M\u00c1S"
