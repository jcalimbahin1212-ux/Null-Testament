        "LLEVA LA C\u00c1MARA DEL JUEGO A ESTA POSICI\u00d3N"
    ],
    "HELP_OBJECTPROPERTIES_93": [
        "SIGNAL IS SENT AFTER THE SET DURATION",
        "\u4fe1\u53f7\u5728\u8bbe\u5b9a\u65f6\u957f\u540e\u53d1\u9001",
        "\u4e00\u5b9a\u6642\u9593\u5f8c\u306b\u30b7\u30b0\u30ca\u30eb\u304c\u9001\u4fe1\u3055\u308c\u307e\u3059",
        "LE SIGNAL EST ENVOY\u00c9 APR\u00c8S LA DUR\u00c9E D\u00c9FINIE",
        "SIGNAL WIRD NACH DER FESTGELEGTEN DAUER GESENDET",
        "\uae30\uac04 \uc124\uc815 \ud6c4\uc5d0 \uc2e0\ud638 \ubcf4\ub0c4",
        "IL SEGNALE VIENE TRASMESSO DOPO LA DURATA IMPOSTATA",
        "\u0421\u0418\u0413\u041d\u0410\u041b \u0411\u0423\u0414\u0415\u0422 \u041e\u0422\u041f\u0420\u0410\u0412\u041b\u0415\u041d \u041f\u041e \u0418\u0421\u0422\u0415\u0427\u0415\u041d\u0418\u0418 \u0412\u042b\u0421\u0422\u0410\u0412\u041b\u0415\u041d\u041d\u041e\u0419 \u0417\u0410\u0414\u0415\u0420\u0416\u041a\u0418",
        "SIGN\u00c1L JE POSL\u00c1N PO UPLYNUT\u00cd NASTAVEN\u00c9HO \u010cASU",
        "SIGNAALI L\u00c4HETET\u00c4\u00c4N ASETETUN AJAN P\u00c4\u00c4TYTTY\u00c4",
        "O SINAL \u00c9 ENVIADO AP\u00d3S A DURA\u00c7\u00c3O DEFINIDA",
        "LA SE\u00d1AL SE ENV\u00cdA TRAS LA DURACI\u00d3N ESTABLECIDA"
    ],
    "HELP_OBJECTPROPERTIES_94": [
        "THE DURATION BEFORE FIRST SIGNAL IS SENT FORWARD",
        "\u53d1\u9001\u7b2c\u4e00\u4e2a\u4fe1\u53f7\u524d\u7684\u65f6\u957f",
        "\u6700\u521d\u306e\u30b7\u30b0\u30ca\u30eb\u304c\u9001\u308a\u51fa\u3055\u308c\u308b\u307e\u3067\u306e\u6642\u9593",
        "LA DUR\u00c9E AVANT QUE LE PREMIER SIGNAL SOIT TRANSMIS",
        "ZEITSPANNE VOR WEITERLEITUNG DES ERSTEN SIGNALS",
        "\uccab \uc2e0\ud638 \uc804\uc758 \uae30\uac04\uc774 \ubcf4\ub0b4\uc9d0",
        "LA DURATA CHE INTERCORRE PRIMA CHE IL PRIMO SEGNALE SIA TRASMESSO",
        "\u0417\u0410\u0414\u0415\u0420\u0416\u041a\u0410 \u041f\u0415\u0420\u0415\u0414 \u041e\u0422\u041f\u0420\u0410\u0412\u041a\u041e\u0419 \u041f\u0415\u0420\u0412\u041e\u0413\u041e \u0421\u0418\u0413\u041d\u0410\u041b\u0410",
        "UPLYNUL\u00dd \u010cAS PO KTER\u00c9M JE PRVN\u00cd SIGN\u00c1L POSL\u00c1N VP\u0158ED",
        "AIKA ENNEN ENSIMM\u00c4ISEN SIGNAALIN L\u00c4HETT\u00c4MIST\u00c4",
        "A DURA\u00c7\u00c3O ANTES DO PRIMEIRO SINAL SER ENVIADO ADIANTE",
        "LA DURACI\u00d3N ANTES DE QUE SE ENV\u00cdE LA SE\u00d1AL"
    ],
    "HELP_OBJECTPROPERTIES_96": [
        "HOW MANY TIMES SIGNAL WILL BE SENT",
        "\u4fe1\u53f7\u5c06\u53d1\u9001\u591a\u5c11\u6b21",
        "\u30b7\u30b0\u30ca\u30eb\u304c\u9001\u3089\u308c\u308b\u56de\u6570",
        "LE NOMBRE DE FOIS O\u00d9 LE SIGNAL SERA ENVOY\u00c9",
        "WIE OFT EIN SIGNAL GESENDET WIRD",
        "\uc2e0\ud638\uac00 \ubcf4\ub0b4\uc9c8 \ud69f\uc218",
        "NUMERO DI TRASMISSIONI DEL SEGNALE",
        "\u0421\u041a\u041e\u041b\u042c\u041a\u041e \u0420\u0410\u0417 \u0411\u0423\u0414\u0415\u0422 \u041e\u0422\u041f\u0420\u0410\u0412\u041b\u0415\u041d \u0421\u0418\u0413\u041d\u0410\u041b",
        "KOLIKR\u00c1T BUDE SIGN\u00c1L POSL\u00c1N",
        "L\u00c4HETETT\u00c4VIEN SIGNAALIEN M\u00c4\u00c4R\u00c4",
        "QUANTAS VEZES O SINAL SER\u00c1 ENVIADO",
        "CU\u00c1NTAS VECES SE MANDAR\u00c1 LA SE\u00d1AL"
    ],
    "HELP_OBJECTPROPERTIES_62": [
        "IF ENABLED, THE PIVOT POINT IS AFFECTED BY PHYSICAL FORCES",
        "\u5982\u542f\u7528\uff0c\u8f74\u5fc3\u70b9\u5c06\u53d7\u7269\u7406\u4f5c\u7528\u529b\u7684\u5f71\u54cd",
        "\u6709\u52b9\u306e\u72b6\u614b\u3060\u3068\u3001\u56de\u8ee2\u306e\u4e2d\u5fc3\u70b9\u304c\u7269\u7406\u6cd5\u5247\u306b\u5f71\u97ff\u3055\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "SI ACTIV\u00c9, DES FORCES PHYSIQUES SONT ATTRIBU\u00c9ES AU POINT DE PIVOTEMENT",
        "BEI AKTIVIERUNG WIRD DER DREHPUNKT VON PHYSIKALISCHEN KR\u00c4FTEN BEEINFLUSST",
        "\ud65c\uc131\ud654\ub418\uba74 \ud53c\ubd07 \ud3ec\uc778\ud2b8\uac00 \ubb3c\ub9ac\ub825\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4.",
        "SE ABILITATO, IL FULCRO SUBISCE FORZE FISICHE",
        "\u0415\u0421\u041b\u0418 \u0412\u041a\u041b\u042e\u0427\u0415\u041d\u041e, \u041e\u0421\u042c \u0412\u0420\u0410\u0429\u0415\u041d\u0418\u042f \u0411\u0423\u0414\u0415\u0422 \u041f\u041e\u0414\u0412\u0415\u0420\u0416\u0415\u041d\u0410 \u0414\u0415\u0419\u0421\u0422\u0412\u0418\u042e \u0424\u0418\u0417\u0418\u0427\u0415\u0421\u041a\u0418\u0425 \u0421\u0418\u041b",
        "POKUD POVOLENO, BOD OT\u00c1\u010cEN\u00cd JE OVLIVN\u011aN FYZIK\u00c1LN\u00cd SILOU",
        "JOS K\u00c4YT\u00d6SS\u00c4, FYYSISET VOIMAT VAIKUTTAVAT TUKIPISTEESEEN",
        "SE HABILITADO, O PONTO DE PIV\u00d4 \u00c9 AFETADO POR FOR\u00c7AS F\u00cdSICAS",
        "SI SE ACTIVA, LAS FUERZAS F\u00cdSICAS AFECTAN AL PUNTO DE PIVOTE."
    ],
    "HELP_OBJECTPROPERTIES_28": [
        "SCALE OBJECT BASED FROM THE CURRENT SCALE (LOCAL) OR GLOBAL SCALE",
        "\u6839\u636e\u5f53\u524d\u5927\u5c0f\uff08\u672c\u5730\uff09\u6216\u5168\u5c40\u5927\u5c0f\u7f29\u653e\u7269\u4f53",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u5927\u304d\u3055\u3092\u73fe\u5728\u306e\u30b9\u30b1\u30fc\u30eb (\u30ed\u30fc\u30ab\u30eb) \u3082\u3057\u304f\u306f\u30b0\u30ed\u30fc\u30d0\u30eb\u30b9\u30b1\u30fc\u30eb\u306b\u5fdc\u3058\u3066\u5909\u66f4\u3057\u307e\u3059",
        "REDIMENSIONNE LES OBJETS EN FONCTION DE L'\u00c9CHELLE ACTUELLE (LOCALE) OU GLOBALE",
        "SKALIERT OBJEKT BASIEREND AUF AKTUELLEM MASSSTAB (LOKAL) ODER GLOBALEM MASSSTAB",
        "\ud604\uc7ac \ube44\uc728 \ub610\ub294 \uc804\uccb4 \ube44\uc728\uc744 \uae30\uc900\uc73c\ub85c \uac1c\uccb4 \ud655\ub300",
        "RIDIMENSIONA OGGETTO IN BASE ALL'ATTUALE SCALA LOCALE O GLOBALE",
        "\u041c\u0410\u0421\u0428\u0422\u0410\u0411\u0418\u0420\u041e\u0412\u0410\u0422\u042c \u041e\u0411\u042a\u0415\u041a\u0422 \u0412 \u0417\u0410\u0412\u0418\u0421\u0418\u041c\u041e\u0421\u0422\u0418 \u041e\u0422 \u0422\u0415\u041a\u0423\u0429\u0415\u0413\u041e (\u041b\u041e\u041a\u0410\u041b\u042c\u041d\u041e\u0413\u041e) \u0418\u041b\u0418 \u0413\u041b\u041e\u0411\u0410\u041b\u042c\u041d\u041e\u0413\u041e \u041c\u0410\u0421\u0428\u0422\u0410\u0411\u0410",
        "\u0160K\u00c1LUJE OBJEKTY NA Z\u00c1KLAD\u011a SOU\u010cASN\u00c9 \u0160K\u00c1LY (LOK\u00c1LN\u00cd) NEBO GLOB\u00c1LN\u00cd \u0160K\u00c1LY",
        "MUUTA OBJEKTIN KOKOA NYKYISEEN SKAALAAN (PAIKALLINEN) TAI YLEISEEN SKAALAAN PERUSTUEN",
        "DIMENSIONE O OBJETO COM BASE NA ESCALA ATUAL (LOCAL) OU ESCALA GLOBAL",
        "ESCALA DEL OBJETO SEG\u00daN LA ESCALA ACTUAL (LOCAL) O GLOBAL"
    ],
    "HELP_OBJECTPROPERTIES_355": [
        "WHICH PLAYER'S TOUCH INPUT IS LISTENED TO",
        "\u542c\u4ece\u73a9\u5bb6\u7684\u54ea\u4e2a\u89e6\u6478\u8f93\u5165",
        "\u76e3\u8996\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30bf\u30c3\u30c1\u5165\u529b\u5143",
        "QUELLES ENTR\u00c9ES TACTILES DU JOUEUR SONT PRISES EN COMPTE",
        "AUF WELCHE EINGABE EINES SPIELERS DURCH TIPPEN REAGIERT WIRD",
        "\uc785\ub825\uc744 \ubc1b\uc744 \ud50c\ub808\uc774\uc5b4",
        "DETERMINA L'INPUT DI TOCCO CONSIDERATO",
        "\u041f\u0420\u0418\u041a\u041e\u0421\u041d\u041e\u0412\u0415\u041d\u0418\u042f \u041a\u0410\u041a\u041e\u0413\u041e \u0418\u0413\u0420\u041e\u041a\u0410 \u0421\u041b\u0415\u0414\u0423\u0415\u0422 \u041e\u0416\u0418\u0414\u0410\u0422\u042c",
        "DOTYKOV\u00dd VSTUP KTER\u00c9HO HR\u00c1\u010cE JE N\u00c1SLEDOV\u00c1N",
        "MINK\u00c4 PELAAJAN KOSKETUSSY\u00d6TETT\u00c4 SEURATAAN",
        "QUAL ENTRADA DE TOQUE DO JOGADOR \u00c9 DETECTADA",
        "A QU\u00c9 JUGADOR SE LE HACE CASO AL TOCAR LA PANTALLA"
    ],
    "HELP_OBJECTPROPERTIES_306": [
        "WHICH PLAYER'S POWER-UP EFFECTS ARE LISTENED",
        "\u542c\u4ece\u73a9\u5bb6\u7684\u54ea\u4e2a\u8f85\u52a9\u9053\u5177\u6548\u679c",
        "\u76e3\u8996\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u52b9\u679c",
        "LES EFFETS D'AM\u00c9LIORATION DU JOUEUR QUI SONT PRIS EN COMPTE",
        "AUF WELCHE POWER-UP-EFFEKTE EINES SPIELERS REAGIERT WIRD",
        "\uc785\ub825\uc744 \ubc1b\uc744 \ud50c\ub808\uc774\uc5b4\uc758 \ud30c\uc6cc\uc5c5 \ud6a8\uacfc",
        "DETERMINA GLI EFFETTI POTENZIAMENTO CONSIDERATI",
        "\u042d\u0424\u0424\u0415\u041a\u0422\u042b \u0423\u0421\u0418\u041b\u0415\u041d\u0418\u042f \u041c\u041e\u0429\u041d\u041e\u0421\u0422\u0418 \u041a\u0410\u041a\u041e\u0413\u041e \u0418\u0413\u0420\u041e\u041a\u0410 \u0421\u041b\u0415\u0414\u0423\u0415\u0422 \u041e\u0416\u0418\u0414\u0410\u0422\u042c",
        "POSILUJ\u00cdC\u00cd EFEKTY KTER\u00c9HO HR\u00c1\u010cE JSOU N\u00c1SLEDOV\u00c1NY",
        "MINK\u00c4 PELAAJAN LIS\u00c4VOIMAEFEKTEJ\u00c4 SEURATAAN",
        "QUAIS EFEITOS DE POWER-UP DO JOGADOR S\u00c3O DETECTADOS",
        "DE QU\u00c9 JUGADOR SON LOS PODERES QU\u00c9 PREVALECEN"
    ],
    "HELP_OBJECTPROPERTIES_142": [
        "HOW THE DISTANCE IS CALCULATED",
        "\u5982\u4f55\u8ba1\u7b97\u8ddd\u79bb",
        "\u8ddd\u96e2\u306e\u8a08\u7b97\u65b9\u6cd5",
        "COMMENT LA DISTANCE EST CALCUL\u00c9E",
        "WIE DIE ENTFERNUNG BERECHNET WIRD",
        "\uac70\ub9ac\uac00 \uacc4\uc0b0\ub418\ub294 \ubc29\ubc95",
        "LA MODALIT\u00c0 DI CALCOLO DELLA DISTANZA",
        "\u041a\u0410\u041a\u0418\u041c \u041e\u0411\u0420\u0410\u0417\u041e\u041c \u0420\u0410\u0421\u0421\u0427\u0418\u0422\u042b\u0412\u0410\u0415\u0422\u0421\u042f \u0420\u0410\u0421\u0421\u0422\u041e\u042f\u041d\u0418\u0415",
        "JAK JE VYPO\u010c\u00cdT\u00c1NA VZD\u00c1LENOST",
        "KUINKA ET\u00c4ISYYS LASKETAAN",
        "COMO A DIST\u00c2NCIA \u00c9 CALCULADA",
        "C\u00d3MO SE CALCULA LA DISTANCIA"
    ],
    "HELP_OBJECTPROPERTIES_338": [
        "HOW THE ANGLE IS CALCULATED. \"LOOK AT\" OPTION ALLOWS TURRET-LIKE CIRCULAR MOVEMENT",
        "\u5982\u4f55\u8ba1\u7b97\u89d2\u5ea6\u3002\u201c\u67e5\u770b\u201d\u9009\u9879\u5141\u8bb8\u70ae\u5854\u5f0f\u7684\u5706\u5468\u8fd0\u52a8",
        "\u89d2\u5ea6\u306e\u8a08\u7b97\u65b9\u6cd5\u3002\u300c\u898b\u308b\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u3076\u3068\u3001\u7832\u5854\u306e\u3088\u3046\u306b\u5186\u3092\u63cf\u3044\u3066\u52d5\u304f\u3088\u3046\u306b\u306a\u308b",
        "COMMENT L'ANGLE EST CALCUL\u00c9. L'OPTION \u00ab\u00a0REGARDER\u00a0\u00bb PERMET D'EFFECTUER UN MOUVEMENT CIRCULAIRE SEMBLABLE \u00c0 CELUI D'UNE TOURELLE.",
        "SO WIRD DER BLICKWINKEL BERECHNET. \"LOOK AT\" ERLAUBT EINE TURM\u00c4HNLICHE KREISBEWEGUNG",
        "\uac01\ub3c4\uac00 \uacc4\uc0b0\ub418\ub294 \ubc29\ubc95. \"\ubcf4\uae30\" \uc635\uc158\uc73c\ub85c \ud130\ub81b\uac19\uc740 \uc6d0\ud615 \uc774\ub3d9\uc744 \ud5c8\uc6a9\ud558\uc138\uc694.",
        "MODALIT\u00c0 DI CALCOLO DELL'ANGOLO. L'OPZIONE \"GUARDA\" CONSENTE UNA ROTAZIONE IN STILE TORRETTA",
        "\u041a\u0410\u041a\u0418\u041c \u041e\u0411\u0420\u0410\u0417\u041e\u041c \u0420\u0410\u0421\u0421\u0427\u0418\u0422\u042b\u0412\u0410\u0415\u0422\u0421\u042f \u0423\u0413\u041e\u041b. \"\u0421\u041c\u041e\u0422\u0420\u0415\u0422\u042c \u041d\u0410\" \u0420\u0410\u0417\u0420\u0415\u0428\u0410\u0415\u0422 \u041a\u0420\u0423\u0413\u041e\u0412\u041e\u0415 \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u0415 \u041f\u041e \u0422\u0418\u041f\u0423 \u041f\u0423\u041b\u0415\u041c\u0415\u0422\u041d\u041e\u0419 \u0411\u0410\u0428\u041d\u0418",
        "JAK JE VYPO\u010c\u00cdT\u00c1N \u00daHEL. MO\u017dNOST \"SLEDOV\u00c1N\u00cd\" UMO\u017dN\u00cd OT\u00c1\u010cIV\u00dd POHYB PODOBN\u00dd JAKO U V\u011a\u017d\u00cd",
        "KUINKA KULMA LASKETAAN. \"KATSO\" MAHDOLLISTAA TYKKITORNI-TYYLISEN PY\u00d6RIMISEN",
        "COMO O \u00c2NGULO \u00c9 CALCULADO. A OP\u00c7\u00c3O \"OLHAR PARA\" PERMITE MOVIMENTO CIRCULAR DO TIPO TORRE",
        "C\u00d3MO SE CALCULA EL \u00c1NGULO. LA OPCI\u00d3N \"LOOK AT\" PERMITE UN MOVIMIENTO CIRCULAR COMO UNA TORRETA"
    ],
    "HELP_OBJECTPROPERTIES_13": [
        "FROM WHICH KIND OF CURVE THE VALUES ARE CALCULATED DURING THE DURATION",
        "\u8fc7\u7a0b\u4e2d\u8ba1\u7b97\u54ea\u79cd\u66f2\u7ebf\u4e0a\u7684\u503c",
        "\u6307\u5b9a\u306e\u6642\u9593\u4e2d\u306b\u5024\u3092\u8a08\u7b97\u3059\u308b\u66f2\u7dda\u306e\u7a2e\u985e",
        "\u00c0 PARTIR DE QUEL TYPE DE COURBE LES VALEURS SONT CALCUL\u00c9ES PENDANT LA DUR\u00c9E",
        "VON WELCHER KURVENART AUS DIE WERTE W\u00c4HREND DER LAUFZEIT BERECHNET WERDEN",
        "\ucee4\ube0c\uc758 \uc720\ud615\uc5d0 \ub530\ub77c \uae30\uac04 \uc911\uc5d0 \uac12\uc774 \uacc4\uc0b0\ub429\ub2c8\ub2e4.",
        "DETERMINA IL TIPO DI CURVA DA CUI VENGONO CALCOLATI I VALORI NELLA DURATA CONSIDERATA",
        "\u0417\u041d\u0410\u0427\u0415\u041d\u0418\u042f \u041a\u0410\u041a\u041e\u0413\u041e \u0422\u0418\u041f\u0410 \u0418\u0417\u0413\u0418\u0411\u0410 \u0420\u0410\u0421\u0421\u0427\u0418\u0422\u042b\u0412\u0410\u042e\u0422\u0421\u042f \u041f\u0420\u0418 \u0417\u0410\u0414\u0415\u0420\u0416\u041a\u0415",
        "PODLE KTER\u00c9HO DRUHU K\u0158IVKY JSOU HODNOTY VYPO\u010c\u00cdT\u00c1NY B\u011aHEM UPLYNUL\u00c9HO \u010cASU",
        "MILLAISESTA K\u00c4YR\u00c4ST\u00c4 ARVOT LASKETAAN KESTOAJAN AIKANA",
        "A PARTIR DE QUE TIPO DE CURVA OS VALORES S\u00c3O CALCULADOS AO LONGO DA DURA\u00c7\u00c3O",
        "A PARTIR DE QU\u00c9 TIPO DE CURVA SE CALCULAN LOS VALORES EN DICHA DURACI\u00d3N"
    ],
    "HELP_OBJECTPROPERTIES_135": [
        "ROTATE OBJECT BASED FROM THE CURRENT ROTATION (LOCAL) OR GLOBAL ROTATION",
        "\u6839\u636e\u5f53\u524d\u65cb\u8f6c\uff08\u672c\u5730\uff09\u6216\u5168\u5c40\u65cb\u8f6c\u6765\u65cb\u8f6c\u7269\u4f53",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u73fe\u5728\u306e\u56de\u8ee2 (\u30ed\u30fc\u30ab\u30eb) \u3082\u3057\u304f\u306f\u30b0\u30ed\u30fc\u30d0\u30eb\u306a\u56de\u8ee2\u306b\u5fdc\u3058\u3066\u56de\u8ee2\u3055\u305b\u307e\u3059",
        "FAIT PIVOTER L'OBJET EN FONCTION DE LA ROTATION ACTUELLE (LOCALE) OU GLOBALE",
        "OBJEKTROTATION BASIEREND AUF AKTUELLER ROTATION (LOKAL) ODER GLOBALER ROTATION",
        "\ud604\uc7ac \ud68c\uc804 \ub610\ub294 \uc804\uccb4 \ud68c\uc804\uc73c\ub85c \uac1c\uccb4 \ud68c\uc804",
        "RUOTA OGGETTO IN BASE ALL'ATTUALE ROTAZIONE LOCALE O GLOBALE",
        "\u0412\u0420\u0410\u0429\u0410\u0422\u042c \u041e\u0411\u042a\u0415\u041a\u0422 \u041d\u0410 \u041e\u0421\u041d\u041e\u0412\u0410\u041d\u0418\u0418 \u0422\u0415\u041a\u0423\u0429\u0415\u0413\u041e (\u041b\u041e\u041a\u0410\u041b\u042c\u041d\u041e\u0413\u041e) \u0418\u041b\u0418 \u0413\u041b\u041e\u0411\u0410\u041b\u042c\u041d\u041e\u0413\u041e \u0412\u0420\u0410\u0429\u0415\u041d\u0418\u042f",
        "OT\u00c1\u010c\u00cd OBJEKT NA Z\u00c1KLAD\u011a SOU\u010cASN\u00c9 ROTACE (LOK\u00c1LN\u00cd) NEBO GLOB\u00c1LN\u00cd ROTACE",
        "PY\u00d6RIT\u00c4 OBJEKTIA NYKYISEEN PY\u00d6RIMISTAPAAN (PAIKALLINEN) TAI YLEISEEN PY\u00d6RIMISTAPAAN PERUSTUEN",
        "ROTACIONE O OBJETO COM BASE NA ROTA\u00c7\u00c3O ATUAL (LOCAL) OU ROTA\u00c7\u00c3O GLOBAL",
        "ROTA UN OBJETO SEG\u00daN LA ROTACI\u00d3N ACTUAL (LOCAL) O GLOBAL"
    ],
    "HELP_OBJECTPROPERTIES_132": [
        "MOVE OBJECT BASED FROM THE CURRENT MOVE (LOCAL) OR GLOBAL MOVEMENT",
        "\u6839\u636e\u5f53\u524d\u79fb\u52a8\uff08\u672c\u5730\uff09\u6216\u5168\u5c40\u79fb\u52a8\u6765\u79fb\u52a8\u7269\u4f53",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u73fe\u5728\u306e\u79fb\u52d5 (\u30ed\u30fc\u30ab\u30eb) \u3082\u3057\u304f\u306f\u30b0\u30ed\u30fc\u30d0\u30eb\u306a\u79fb\u52d5\u306b\u5fdc\u3058\u3066\u79fb\u52d5\u3055\u305b\u307e\u3059",
        "D\u00c9PLACE L'OBJET EN FONCTION DU MOUVEMENT ACTUEL (LOCAL) OU GLOBAL",
        "OBJEKTVERSCHIEBUNG BASIEREND AUF AKTUELLER BEWEGUNG (LOKAL) ODER GLOBALER BEWEGUNG",
        "\ud604\uc7ac \uc774\ub3d9 \ub610\ub294 \uc804\uccb4 \uc774\ub3d9\uc73c\ub85c \uac1c\uccb4 \uc774\ub3d9",
        "SPOSTA OGGETTO IN BASE ALL'ATTUALE SPOSTAMENTO LOCALE O GLOBALE",
        "\u041f\u0415\u0420\u0415\u0414\u0412\u0418\u041d\u0423\u0422\u042c \u041e\u0411\u042a\u0415\u041a\u0422 \u041d\u0410 \u041e\u0421\u041d\u041e\u0412\u0410\u041d\u0418\u0418 \u0422\u0415\u041a\u0423\u0429\u0415\u0413\u041e (\u041b\u041e\u041a\u0410\u041b\u042c\u041d\u041e\u0413\u041e) \u0418\u041b\u0418 \u0413\u041b\u041e\u0411\u0410\u041b\u042c\u041d\u041e\u0413\u041e \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u042f",
        "P\u0158EM\u00cdST\u00cd OBJEKT NA Z\u00c1KLAD\u011a SOU\u010cASN\u00c9HO POHYBU (LOK\u00c1LN\u00cdHO) NEBO GLOB\u00c1LN\u00cdHO POHYBU",
        "SIIRR\u00c4 OBJEKTIA NYKYISEEN SIIRTYMISTAPAAN (PAIKALLINEN) TAI YLEISEEN SIIRTYMISTAPAAN PERUSTUEN",
        "MOVA O OBJETO COM BASE NO MOVIMENTO ATUAL (LOCAL) OU MOVIMENTO GLOBAL",
        "MUEVE UN OBJETO SEG\u00daN EL MOVIMIENTO ACTUAL (LOCAL) O GLOBAL"
    ],
    "HELP_OBJECTPROPERTIES_137": [
        "SET THIS ICON TO BE USED AS THE PIVOT POINT FOR THE ROTATION",
        "\u5c06\u6b64\u56fe\u6807\u8bbe\u4e3a\u65cb\u8f6c\u6240\u7528\u7684\u8f74\u5fc3\u70b9",
        "\u3053\u306e\u30a2\u30a4\u30b3\u30f3\u3092\u56de\u8ee2\u306e\u4e2d\u5fc3\u70b9\u3068\u3057\u3066\u4f7f\u7528\u3059\u308b",
        "D\u00c9FINIT CETTE IC\u00d4NE POUR QU'ELLE SOIT UTILIS\u00c9E COMME POINT DE PIVOTEMENT POUR LA ROTATION",
        "DIESES SYMBOL FESTLEGEN, DAS ALS DREHPUNKT F\u00dcR DIE ROTATION DIENT",
        "\uc774 \uc544\uc774\ucf58\uc744 \ud68c\uc804\uc758 \ud53c\ubd07 \ud3ec\uc778\ud2b8\ub85c \uc0ac\uc6a9\ud558\uae30\ub85c \uc124\uc815",
        "IMPOSTA QUESTA ICONA COME FULCRO PER LA ROTAZIONE",
        "\u0412\u042b\u0411\u0420\u0410\u0422\u042c \u042d\u0422\u041e\u0422 \u0417\u041d\u0410\u0427\u041e\u041a  \u0412 \u041a\u0410\u0427\u0415\u0421\u0422\u0412\u0415 \u041e\u0421\u0415\u0412\u041e\u0419 \u0422\u041e\u0427\u041a\u0418 \u0412\u0420\u0410\u0429\u0415\u041d\u0418\u042f",
        "NASTAV TUTO IKONU, ABY BYLA POU\u017dITA JAKO BOD OT\u00c1\u010cEN\u00cd PRO ROTACI",
        "ASETA T\u00c4M\u00c4 IKONI K\u00c4YTETT\u00c4V\u00c4KSI PY\u00d6RIMISEN TUKIPISTEEN\u00c4",
        "DEFINA ESTE \u00cdCONE PARA SER USADO COMO O PONTO DE PIV\u00d4 PARA A ROTA\u00c7\u00c3O",
        "ESTABLECE ESTE ICONO PARA USARLO COMO PUNTO DE PIVOTE PARA LA ROTACI\u00d3N"
    ],
    "HELP_OBJECTPROPERTIES_61": [
        "SET WHETHER THE JOINTED OBJECTS COLLIDE WITH EACH OTHER",
        "\u8bbe\u7f6e\u8fde\u63a5\u7684\u7269\u4f53\u662f\u5426\u76f8\u4e92\u78b0\u649e",
        "\u30b8\u30e7\u30a4\u30f3\u30c8\u5316\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u540c\u58eb\u3067\u885d\u7a81\u3059\u308b\u306e\u304b\u3092\u8a2d\u5b9a\u3057\u307e\u3059",
        "D\u00c9FINIT SI LES OBJETS ASSOCI\u00c9S SE HEURTENT LES UNS AUX AUTRES",
        "FESTLEGEN, OB DIE VERBUNDENEN OBJEKTE ZUSAMMENSTOSSEN",
        "\uc5f0\uacb0\ub41c \uac1c\uccb4\uac00 \uc11c\ub85c \ucda9\ub3cc\ud560\uc9c0 \uc124\uc815",
        "IMPOSTA O DISABILITA LA COLLISIONE RECIPROCA DEGLI OGGETTI CONGIUNTI",
        "\u0412\u042b\u0411\u0420\u0410\u0422\u042c, \u041c\u041e\u0413\u0423\u0422 \u041b\u0418 \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u041d\u042b\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f \u0414\u0420\u0423\u0413 \u0421 \u0414\u0420\u0423\u0413\u041e\u041c",
        "NASTAV\u00cd, JESTLI SPOJEN\u00c9 OBJEKTY SPOLU KOLIDUJ\u00cd",
        "ASETA LIITETTYJEN OBJEKTIEN KESKIN\u00c4INEN T\u00d6RM\u00c4YS",
        "DEFINA SE OS OBJETOS CONECTADOS COLIDEM UNS COM OS OUTROS",
        "ESTABLECE SI LOS OBJETOS UNIDOS CHOCAN ENTRE S\u00cd"
    ],
    "HELP_OBJECTPROPERTIES_18": [
        "SET WHETHER THE SECOND HALF OF THE CURVE GOES BACK TO START VALUE",
        "\u8bbe\u7f6e\u66f2\u7ebf\u7684\u7b2c\u4e8c\u90e8\u5206\u662f\u5426\u8fd4\u56de\u521d\u59cb\u503c",
        "\u66f2\u7dda\u306e\u5f8c\u534a\u90e8\u5206\u304c\u521d\u671f\u5024\u306b\u623b\u3063\u3066\u3044\u308b\u306e\u304b\u3092\u8a2d\u5b9a",
        "D\u00c9FINIT SI LA DEUXI\u00c8ME PARTIE DE LA COURBE RETOURNE \u00c0 LA VALEUR DE D\u00c9PART",
        "FESTLEGEN, OB ZWEITE H\u00c4LFTE DER KURVE AUF DEN STARTWERT ZUR\u00dcCKGESETZT WIRD",
        "\ub098\uba38\uc9c0 \ubc18\uc758 \ucee4\ube0c\uac00 \uc2dc\uc791 \uac12\uc73c\ub85c \ub3cc\uc544\uac08\uc9c0 \uc124\uc815",
        "IMPOSTA O DISABILITA IL RITORNO AL VALORE INIZIALE DA PARTE DELLA SECONDA MET\u00c0 DELLA CURVA",
        "\u0412\u042b\u0411\u0420\u0410\u0422\u042c, \u0412\u041e\u0417\u0412\u0420\u0410\u0429\u0410\u0415\u0422\u0421\u042f \u041b\u0418 \u0412\u0422\u041e\u0420\u0410\u042f \u041f\u041e\u041b\u041e\u0412\u0418\u041d\u0410 \u0418\u0417\u0413\u0418\u0411\u0410 \u0412 \u0421\u0412\u041e\u0415 \u041f\u0415\u0420\u0412\u041e\u041d\u0410\u0427\u0410\u041b\u042c\u041d\u041e\u0415 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u0415",
        "NASTAV\u00cd, JESTLI SE DRUH\u00c1 POLOVINA K\u0158IVKY VRAC\u00cd ZP\u011aT NA PO\u010c\u00c1TE\u010cN\u00cd HODNOTU",
        "ASETA K\u00c4YR\u00c4N J\u00c4LKIPUOLISKO PALAAMAAN ALOITUSARVOON",
        "DEFINA SE A SEGUNDA METADE DA CURVA RETORNA PARA O VALOR INICIAL",
        "ESTABLECE SI LA SEGUNDA MITAD DE LA CURVA VUELVE AL VALOR INICIAL"
    ],
    "HELP_OBJECTPROPERTIES_21": [
        "SET THE RANDOM SEED TO GET DIFFERENT RANDOM VALUES",
        "\u8bbe\u7f6e\u968f\u673a\u79cd\u5b50\u6765\u83b7\u5f97\u4e0d\u540c\u7684\u968f\u673a\u503c",
        "\u30e9\u30f3\u30c0\u30e0\u306a\u30b7\u30fc\u30c9\u5024\u3092\u8a2d\u5b9a\u3057\u3066\u3001\u7570\u306a\u308b\u30e9\u30f3\u30c0\u30e0\u306a\u5024\u3092\u5f97\u307e\u3059",
        "D\u00c9FINIT LE NOMBRE AL\u00c9ATOIRE POUR OBTENIR DIFF\u00c9RENTES VALEURS AL\u00c9ATOIRES",
        "EINEN ZUF\u00c4LLIGEN STARTWERT FESTLEGEN, UM VERSCHIEDENE ZUFALLSWERTE ZU ERHALTEN",
        "\ubb34\uc791\uc704 \uc2dc\ub4dc\uac00 \ub2e4\ub978 \ubb34\uc791\uc704 \uac12\uc744 \ubc1b\uc744\uc9c0 \uc124\uc815",
        "IMPOSTA IL SEED CASUALE IN MODO CHE OTTENGA DIFFERENTI VALORI CASUALI",
        "\u0423\u0421\u0422\u0410\u041d\u041e\u0412\u0418\u0422\u042c \u041d\u0410\u0427\u0410\u041b\u042c\u041d\u041e\u0415 \u0421\u041b\u0423\u0427\u0410\u0419\u041d\u041e\u0415 \u0427\u0418\u0421\u041b\u041e, \u0427\u0422\u041e\u0411\u042b \u041f\u041e\u041b\u0423\u0427\u0410\u0422\u042c \u0420\u0410\u0417\u041b\u0418\u0427\u041d\u042b\u0415 \u0421\u041b\u0423\u0427\u0410\u0419\u041d\u042b\u0415 \u0427\u0418\u0421\u041b\u0410",
        "NASTAV\u00cd N\u00c1HODN\u00dd SEED K Z\u00cdSK\u00c1N\u00cd R\u016eZN\u00ddCH N\u00c1HODN\u00ddCH HODNOT",
        "ASETA SATUNNAISLUVUN JUURI ERI SATUNNAISARVOJEN SAAMISEKSI",
        "DEFINA A SEMENTE ALEAT\u00d3RIA PARA OBTER DIFERENTES VALORES ALEAT\u00d3RIOS",
        "ESTABLECE LA SEMILLA ALEATORIA PARA QUE RECIBA DISTINTOS VALORES ALEATORIOS"
    ],
    "HELP_OBJECTPROPERTIES_102": [
        "HOW STRONG THE JOINT IS. WARNING: INCREASING THE VALUE DECREASES PERFORMANCE!",
        "\u8282\u70b9\u7684\u5f3a\u5ea6\u3002\u8b66\u544a\uff1a\u589e\u52a0\u503c\u4f1a\u964d\u4f4e\u6027\u80fd\uff01",
        "\u30b8\u30e7\u30a4\u30f3\u30c8\u90e8\u306e\u5f37\u5ea6\u3002\u8b66\u544a: \u3053\u306e\u5024\u3092\u4e0a\u6607\u3055\u305b\u308b\u3068\u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u304c\u91cd\u304f\u306a\u308a\u307e\u3059\uff01",
        "R\u00c9SISTANCE DE L'ASSOCIATION. AVERTISSEMENT : AUGMENTER LA VALEUR DIMINUE LA PERFORMANCE !",
        "ST\u00c4RKE DER VERBINDUNG. WARNUNG: EINE ERH\u00d6HUNG DES WERTS VERRINGERT DIE LEISTUNG!",
        "\uc5f0\uacb0\uc758 \uac15\ub3c4. \uacbd\uace0: \uac12\uc744 \ub298\ub9ac\uba74 \uc131\ub2a5\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4!",
        "LA RESISTENZA DELLA GIUNTURA. ATTENZIONE: AUMENTANDO IL VALORE SI DIMINUISCE LA PRESTAZIONE!",
        "\u041d\u0410\u0421\u041a\u041e\u041b\u042c\u041a\u041e \u0421\u0418\u041b\u042c\u041d\u041e \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u0418\u0415. \u041f\u0420\u0415\u0414\u0423\u041f\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u0415: \u0427\u0415\u041c \u0412\u042b\u0428\u0415 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u0415, \u0422\u0415\u041c \u041d\u0418\u0416\u0415 \u041f\u0420\u041e\u0418\u0417\u0412\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c \u0418\u0413\u0420\u042b!",
        "JAK JE SILN\u00dd SPOJ. VAROV\u00c1N\u00cd: ZV\u00dd\u0160EN\u00cd T\u00c9TO HODNOTY SNI\u017dUJE V\u00ddKON",
        "LIIT\u00c4NN\u00c4N VAHVUUS. VAROITUS: ARVON NOSTAMINEN ALENTAA SUORITUSKYKY\u00c4!",
        "O QUANTO A CONEX\u00c3O \u00c9 FORTE. AVISO: AUMENTAR O VALOR REDUZ O DESEMPENHO!",
        "C\u00d3MO ES DE FUERTE LA JUNTA. AVISO: \u00a1AL AUMENTAR EL VALOR DISMINUYE EL RENDIMIENTO!"
    ],
    "HELP_OBJECTPROPERTIES_201": [
        "HOW MANY EMITTED OBJECTS CAN EXISTS AT THE SAME TIME",
        "\u540c\u65f6\u53ef\u4ee5\u5b58\u5728\u591a\u5c11\u4e2a\u53d1\u5c04\u51fa\u7684\u7269\u4f53",
        "\u30a8\u30df\u30c3\u30c8\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304c\u540c\u6642\u306b\u5b58\u5728\u3067\u304d\u308b\u6700\u5927\u6570",
        "COMBIEN D'OBJETS \u00c9MIS PEUVENT EXISTER EN M\u00caME TEMPS",
        "WIE VIELE AUSGEGEBENE OBJEKTE ZEITGLEICH EXISTIEREN K\u00d6NNEN",
        "\ud45c\uc2dc\ub41c \uac1c\uccb4\uac00 \ub3d9\uc2dc\uc5d0 \uc874\uc7ac\ud560 \uc218 \uc788\ub294 \uac1c\uc218",
        "IL NUMERO DI OGGETTI EMESSI CHE POSSONO COESISTERE NELLO STESSO MOMENTO",
        "\u0421\u041a\u041e\u041b\u042c\u041a\u041e \u0421\u0413\u0415\u041d\u0415\u0420\u0418\u0420\u041e\u0412\u0410\u041d\u041d\u042b\u0425 \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412 \u041c\u041e\u0413\u0423\u0422 \u0421\u0423\u0429\u0415\u0421\u0422\u0412\u041e\u0412\u0410\u0422\u042c \u041e\u0414\u041d\u041e\u0412\u0420\u0415\u041c\u0415\u041d\u041d\u041e",
        "KOLIK VYSLAN\u00ddCH OBJEKT\u016e M\u016e\u017dE SOU\u010cASN\u011a EXISTOVAT",
        "KUINKA MONTA TOIMINNASSA OLEVAA OBJEKTIA ON OLEMASSA YHT\u00c4AIKAISESTI",
        "QUANTOS OBJETOS EMITIDOS PODEM EXISTIR AO MESMO TEMPO",
        "CU\u00c1NTOS OBJETOS EMITIDOS PUEDEN EXISTIR AL MISMO TIEMPO"
    ],
    "HELP_OBJECTPROPERTIES_349": [
        "DO NOT AUTO-DISABLE THE OBJECT ALTHOUGH IT IS NOT IN THE SCREEN ANYMORE",
        "\u4e0d\u81ea\u52a8\u7981\u7528\u7269\u4f53\uff0c\u5373\u4f7f\u5b83\u4e0d\u518d\u51fa\u73b0\u5728\u5c4f\u5e55\u4e0a",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304c\u753b\u9762\u5916\u306b\u3042\u3063\u3066\u3082\u81ea\u52d5\u7121\u52b9\u5316\u3057\u306a\u3044",
        "NE PAS D\u00c9SACTIVER AUTOMATIQUEMENT L'OBJET M\u00caME S'IL NE SE TROUVE PLUS \u00c0 L'\u00c9CRAN",
        "KEINE AUTOMATISCHE DEAKTIVIERUNG DES OBJEKTS VORNEHMEN, AUCH WENN ES NICHT MEHR AM BILDSCHIRM IST",
        "\ud654\uba74\uc5d0 \uc5c6\ub354\ub77c\ub3c4 \uac1c\uccb4\ub97c \uc790\ub3d9 \ube44\ud65c\uc131\ud654\ud558\uc9c0 \ub9c8\uc138\uc694.",
        "NON AUTO-DISABILITARE L'OGGETTO ANCHE SE NON \u00c8 PI\u00d9 NELLO SCHERMO",
        "\u041d\u0415 \u041e\u0422\u041a\u041b\u042e\u0427\u0410\u0419\u0422\u0415 \u041e\u0411\u042a\u0415\u041a\u0422 \u0410\u0412\u0422\u041e\u041c\u0410\u0422\u0418\u0427\u0415\u0421\u041a\u0418, \u041a\u0420\u041e\u041c\u0415 \u0422\u0415\u0425 \u0421\u041b\u0423\u0427\u0410\u0415\u0412, \u041a\u041e\u0413\u0414\u0410 \u0415\u0413\u041e \u0423\u0416\u0415 \u041d\u0415\u0422 \u041d\u0410 \u042d\u041a\u0420\u0410\u041d\u0415",
        "NESPUST\u00cd AUTOMATICK\u00c9 ZAK\u00c1Z\u00c1N\u00cd OBJEKTU I KDY\u017d U\u017d NEN\u00cd NA OBRAZOVCE",
        "\u00c4L\u00c4 POISTA OBJEKTIA AUTOMAATTISESTI K\u00c4YT\u00d6ST\u00c4, VAIKKA SE EI EN\u00c4\u00c4 N\u00c4Y RUUDULLA",
        "N\u00c3O DESABILITA AUTOMATICAMENTE O OBJETO, EMBORA ELE N\u00c3O ESTEJA MAIS NA TELA",
        "NO AUTODESACTIVAR EL OBJETO AUNQUE YA NO EST\u00c9 EN LA PANTALLA"
    ],
    "HELP_OBJECTPROPERTIES_177": [
        "ENABLING THIS CHANGES THE OBJECT'S COLLISION MODEL TO A CIRCLE INCREASING GAME PERFORMANCE",
        "\u542f\u7528\u8fd9\u9879\u5c06\u628a\u7269\u4f53\u7684\u78b0\u649e\u6a21\u5f0f\u6539\u4e3a\u8f6c\u52a8\uff0c\u589e\u52a0\u6e38\u620f\u6027\u80fd",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u885d\u7a81\u5224\u5b9a\u30e2\u30c7\u30eb\u3092\u5186\u7cfb\u306b\u5909\u66f4\u3057\u3001\u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u3092\u8efd\u304f\u3057\u307e\u3059",
        "ACTIVER CECI MODIFIE LE MOD\u00c8LE DE COLLISION DE L'OBJET EN CERCLE ET AM\u00c9LIORE LA PERFORMANCE DU JEU",
        "DURCH AKTIVIERUNG WIRD DAS KOLLISIONSMODELL DES OBJEKTS AUF EINEN KREIS GE\u00c4NDERT, UM DIE SPIELLEISTUNG ZU ERH\u00d6HEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uc758 \ucda9\ub3cc \ubaa8\ub378\uc774 \uac8c\uc784 \uc131\ub2a5\uc744 \uc99d\uac00\uc2dc\ud0a4\ub294 \uc6d0\uc73c\ub85c \ubc14\ub01d\ub2c8\ub2e4.",
        "ABILITARE QUESTE MODIFICHE TRASFORMA IL MODELLO DI COLLISIONE DELL'OGGETTO IN UN CERCHIO, AUMENTANDO LA PRESTAZIONE",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u0418\u0417\u041c\u0415\u041d\u0418\u0422 \u041c\u041e\u0414\u0415\u041b\u042c \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f \u041e\u0411\u042a\u0415\u041a\u0422\u0410 \u0418 \u041f\u0420\u0415\u0412\u0420\u0410\u0422\u0418\u0422 \u0415\u0415 \u0412 \u041a\u0420\u0423\u0413, \u0423\u041b\u0423\u0427\u0428\u0418\u0412 \u041f\u0420\u041e\u0418\u0417\u0412\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c \u0418\u0413\u0420\u042b",
        "POVOLEN\u00cdM ZM\u011aN\u00cd KOLIZN\u00cd MODEL OBJEKTU NA KRUH A ZLEP\u0160\u00cd TAK V\u00ddKON",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO MUUTTAA OBJEKTIN T\u00d6RM\u00c4YSMALLIN YMPYR\u00c4KSI JA PARANTAA PELIN SUORITUSKYKY\u00c4",
        "HABILITAR ISTO ALTERA O MODELO DE COLIS\u00c3O DO OBJETO PARA C\u00cdRCULO, AUMENTANDO O DESEMPENHO DO JOGO",
        "ACTIVAR ESTO CAMBIA EL MODELO DE COLISI\u00d3N DEL OBJETO A CIRCULAR, LO QUE AUMENTA EL RENDIMIENTO DEL JUEGO"
    ],
    "HELP_OBJECTPROPERTIES_3": [
        "ENABLING THIS CHANGES THE OBJECT TO A DECORATIVE OBJECT WHICH DOES NOT COLLIDE WITH ANYTHING",
        "\u542f\u7528\u8fd9\u9879\u5c06\u628a\u7269\u4f53\u6539\u4e3a\u88c5\u9970\u6027\u7269\u4f53\uff0c\u5b83\u4e0d\u4f1a\u4e0e\u4efb\u4f55\u7269\u4f53\u78b0\u649e",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u885d\u7a81\u5224\u5b9a\u306e\u7121\u3044\u88c5\u98fe\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306b\u5909\u66f4\u3057\u307e\u3059",
        "ACTIVER CECI MODIFIE L'OBJET EN OBJET D\u00c9CORATIF QUI NE SE HEURTE \u00c0 RIEN",
        "DURCH AKTIVIERUNG WIRD DAS OBJEKT ZU EINEM DEKORATIVEN GE\u00c4NDERT, DAS MIT NICHTS ZUSAMMENSTOSSEN KANN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \uc804\ud600 \ucda9\ub3cc\ud558\uc9c0 \uc54a\ub294 \uc7a5\uc2dd \uac1c\uccb4\ub85c \ubc14\ub01d\ub2c8\ub2e4.",
        "ABILITARE QUESTE MODIFICHE TRASFORMA L'OGGETTO IN OGGETTO DECORATIVO CHE NON SUBISCE COLLISIONI",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u041f\u0420\u0415\u0412\u0420\u0410\u0422\u0418\u0422 \u041e\u0411\u042a\u0415\u041a\u0422 \u0412 \u0414\u0415\u041a\u041e\u0420\u0410\u0422\u0418\u0412\u041d\u042b\u0419 \u041e\u0411\u042a\u0415\u041a\u0422, \u041a\u041e\u0422\u041e\u0420\u042b\u0415 \u041d\u0415 \u0421\u041c\u041e\u0416\u0415\u0422 \u041d\u0418 \u0421 \u0427\u0415\u041c \u0421\u0422\u041e\u041b\u041a\u041d\u0423\u0422\u042c\u0421\u042f",
        "POVOLEN\u00cd ZM\u011aN\u00cd OBJEKT NA OKRASN\u00dd OBJEKT, KTER\u00dd S NI\u010c\u00cdM NEKOLIDUJE",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO MUUTTAA OBJEKTIN KORISTEOBJEKTIKSI, JOKA EI T\u00d6RM\u00c4\u00c4 MINK\u00c4\u00c4N KANSSA",
        "HABILITAR ISTO ALTERA O OBJETO PARA UM OBJETO DECORATIVO, QUE N\u00c3O COLIDE COM NADA",
        "ACTIVAR ESTO HACE QUE EL OBJETO PASE A SER DECORATIVO Y NO COLISIONE CON NADA"
    ],
    "HELP_OBJECTPROPERTIES_5": [
        "ENABLING THIS MAKES THE OBJECT COLLIDE WITH OTHER DYNAMIC OBJECTS",
        "\u542f\u7528\u8fd9\u9879\u5c06\u8ba9\u7269\u4f53\u4e0e\u5176\u4ed6\u52a8\u6001\u7269\u4f53\u78b0\u649e",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u4ed6\u306e\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u885d\u7a81\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI FAIT SE HEURTER L'OBJET AVEC D'AUTRES OBJETS DYNAMIQUES",
        "DURCH AKTIVIERUNG KANN DIESES OBJEKT MIT ANDEREN DYNAMISCHEN OBJEKTEN ZUSAMMENSTOSSEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \ub2e4\ub978 \ub3d9\uc801 \uac1c\uccb4\uc640 \ucda9\ub3cc\ud569\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, L'OGGETTO POTR\u00c0 SUBIRE COLLISIONI CON ALTRI OGGETTI DINAMICI",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u0417\u0410\u0421\u0422\u0410\u0412\u0418\u0422 \u041e\u0411\u042a\u0415\u041a\u0422 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f \u0421 \u0414\u0420\u0423\u0413\u0418\u041c\u0418 \u0414\u0418\u041d\u0410\u041c\u0418\u0427\u0415\u0421\u041a\u0418\u041c\u0418 \u041e\u0411\u042a\u0415\u041a\u0422\u0410\u041c\u0418",
        "POVOLEN\u00cd ZP\u016eSOB\u00cd, \u017dE OBJEKT BUDE KOLIDOVAT S OSTATN\u00cdMI DYNAMICK\u00ddMI OBJEKTY",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO SAA OBJEKTIN T\u00d6RM\u00c4\u00c4M\u00c4\u00c4N MUIDEN SIIRTYVIEN OBJEKTIEN KANSSA",
        "HABILITAR ISTO FAZ O OBJETO COLIDIR COM OUTROS OBJETOS DIN\u00c2MICOS",
        "ACTIVAR ESTO HACE QUE EL OBJETO COLISIONE CON OTROS OBJETOS DIN\u00c1MICOS"
    ],
    "HELP_OBJECTPROPERTIES_6": [
        "ENABLING THIS MAKES THE OBJECT COLLIDE WITH CUSTOM COLLISION TAGGED OBJECTS",
        "\u542f\u7528\u8fd9\u9879\u5c06\u8ba9\u7269\u4f53\u4e0e\u5176\u4ed6\u6709\u81ea\u5b9a\u4e49\u78b0\u649e\u6807\u7b7e\u7684\u7269\u4f53\u78b0\u649e",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u30ab\u30b9\u30bf\u30e0\u885d\u7a81\u5224\u5b9a\u30bf\u30b0\u306e\u4ed8\u3044\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u885d\u7a81\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI FAIT SE HEURTER L'OBJET AVEC DES OBJETS \u00c9TIQUET\u00c9S \u00c0 COLLISION PERSONNALIS\u00c9S",
        "DURCH AKTIVIERUNG KANN DIESES OBJEKT MIT SPEZIELLEN KOLLISIONSMARKIERTEN OBJEKTEN ZUSAMMENSTOSSEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \ucee4\uc2a4\ud140 \ucda9\ub3cc \ud0dc\uadf8 \uac1c\uccb4\uc640 \ucda9\ub3cc\ud569\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, L'OGGETTO POTR\u00c0 SUBIRE COLLISIONI CON ALTRI OGGETTI CON TAG COLLISIONE",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u0417\u0410\u0421\u0422\u0410\u0412\u041b\u042f\u0415\u0422 \u041e\u0411\u042a\u0415\u041a\u0422 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f \u0421 \u041e\u0411\u042a\u0415\u041a\u0422\u0410\u041c\u0418, \u041f\u041e\u041c\u0415\u0427\u0415\u041d\u041d\u042b\u041c\u0418 \u041e\u0421\u041e\u0411\u042b\u041c\u0418 \u0421\u0412\u041e\u0419\u0421\u0422\u0412\u0410\u041c\u0418 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u041d\u0418\u042f",
        "POVOLEN\u00cd ZP\u016eSOB\u00cd, \u017dE OBJEKT BUDE KOLIDOVAT S OBJEKTY S VLASTN\u00cdM OZNA\u010cEN\u00cdM KOLIZE",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO SAA OBJEKTIN T\u00d6RM\u00c4\u00c4M\u00c4\u00c4N MUKAUTETUN T\u00d6RM\u00c4YST\u00c4GIN SIS\u00c4LT\u00c4VIEN OBJEKTIEN KANSSA",
        "HABILITAR ISTO FAZ O OBJETO COLIDIR COM OBJETOS COM MARCA DE COLIS\u00c3O PERSONALIZADA",
        "ACTIVAR ESTO HACE QUE EL OBJETO COLISIONE CON OBJETOS CON ETIQUETA DE COLISI\u00d3N PERSONALIZADA"
    ],
    "HELP_OBJECTPROPERTIES_4": [
        "ENABLING THIS MAKES THE OBJECT COLLIDE WITH STATIONARY OBJECTS",
        "\u542f\u7528\u8fd9\u9879\u5c06\u8ba9\u7269\u4f53\u4e0e\u9759\u6001\u7269\u4f53\u78b0\u649e",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u56fa\u5b9a\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u885d\u7a81\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI FAIT SE HEURTER L'OBJET \u00c0 DES OBJETS STATIONNAIRES",
        "DURCH AKTIVIERUNG WIRD DAS OBJEKT MIT STANDORTGEBUNDENEN OBJEKTEN ZUSAMMENSTOSSEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \uc815\uc9c0\ub41c \uac1c\uccb4\uc640 \ucda9\ub3cc\ud569\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, L'OGGETTO POTR\u00c0 SUBIRE COLLISIONI CON OGGETTI STAZIONARI",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u041f\u041e\u0417\u0412\u041e\u041b\u0418\u0422 \u041e\u0411\u042a\u0415\u041a\u0422\u0423 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f \u0421 \u041d\u0415\u041f\u041e\u0414\u0412\u0418\u0416\u041d\u042b\u041c\u0418 \u041e\u0411\u042a\u0415\u041a\u0422\u0410\u041c\u0418",
        "POVOLEN\u00cd ZP\u016eSOB\u00cd, \u017dE OBJEKT BUDE KOLIDOVAT S NEPOHYBLIV\u00ddMI OBJEKTY.",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO SAA OBJEKTIN T\u00d6RM\u00c4\u00c4M\u00c4\u00c4N KIINTEIDEN OBJEKTIEN KANSSA",
        "HABILITAR ISTO FAZ O OBJETO COLIDIR COM OBJETOS ESTACION\u00c1RIOS",
        "ACTIVAR ESTO HACE QUE EL OBJETO COLISIONE CON OBJETOS INM\u00d3VILES"
    ],
    "HELP_OBJECTPROPERTIES_83": [
        "ENABLING THIS MAKES THE OBJECT COLLIDE WITH TOP AND BOTTOM EDGES OF THE LEVEL",
        "\u542f\u7528\u8fd9\u9879\u5c06\u8ba9\u7269\u4f53\u4e0e\u5173\u5361\u7684\u9876\u90e8\u548c\u5e95\u90e8\u8fb9\u7f18\u78b0\u649e",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u30ec\u30d9\u30eb\u4e0a\u4e0b\u306e\u7aef\u306b\u3076\u3064\u304b\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI FAIT SE HEURTER L'OBJET \u00c0 DES BORDS SUP\u00c9RIEURS ET INF\u00c9RIEURS DU NIVEAU",
        "DURCH AKTIVIERUNG WIRD DAS OBJEKT MIT DER OBEREN UND UNTEREN KANTE DES LEVELS ZUSAMMENSTOSSEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \ub808\ubca8\uc758 \uc704\uc640 \uc544\ub798 \uac00\uc7a5\uc790\ub9ac\uc640 \ucda9\ub3cc\ud569\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, L'OGGETTO POTR\u00c0 SUBIRE COLLISIONI CON IL BORDO INFERIORE E SUPERIORE DEL LIVELLO",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u041f\u041e\u0417\u0412\u041e\u041b\u0418\u0422 \u041e\u0411\u042a\u0415\u041a\u0422\u0423 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f \u0421 \u0412\u0415\u0420\u0425\u041d\u0418\u041c \u0418 \u041d\u0418\u0416\u041d\u0418\u041c \u041a\u0420\u0410\u042f\u041c\u0418 \u0423\u0420\u041e\u0412\u041d\u042f",
        "POVOLEN\u00cd ZP\u016eSOB\u00cd, \u017dE OBJEKT BUDE KOLIDOVAT S HORN\u00cdM A DOLN\u00cdM OKRAJEM \u00daROVN\u011a",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO SAA OBJEKTIN T\u00d6RM\u00c4\u00c4M\u00c4\u00c4N KENT\u00c4N ALA- JA YL\u00c4REUNAN KANSSA",
        "HABILITAR ISTO FAZ O OBJETO COLIDIR COM AS BORDAS SUPERIOR E INFERIOR DO N\u00cdVEL",
        "ACTIVAR ESTO HACE QUE EL OBJETO COLISIONE CON EL BORDE SUPERIOR E INFERIOR DEL NIVEL"
    ],
    "HELP_OBJECTPROPERTIES_109": [
        "ENABLING THIS MAKES SURE THAT HIGH SPEED OBJECTS CANNOT GO THROUGH THIS OBJECT. WARNING: DECREASES PERFORMANCE!",
        "\u542f\u7528\u8fd9\u9879\u5c06\u786e\u4fdd\u9ad8\u901f\u7269\u4f53\u4e0d\u4f1a\u7a7f\u900f\u6b64\u7269\u4f53\u3002\u8b66\u544a\uff1a\u964d\u4f4e\u6027\u80fd\uff01",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u9ad8\u901f\u3067\u79fb\u52d5\u3059\u308b\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u8cab\u901a\u3057\u306a\u304f\u306a\u308a\u307e\u3059\u3002\u8b66\u544a: \u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u304c\u91cd\u304f\u306a\u308a\u307e\u3059\uff01",
        "ACTIVER CECI GARANTIT QUE LES OBJETS \u00c0 GRANDE VITESSE NE PEUVENT PAS TRAVERSER CET OBJET. AVERTISSEMENT : DIMINUE LA PERFORMANCE !",
        "DURCH AKTIVIERUNG WIRD SICHERGESTELLT, DASS HOCHGESCHWINDIGKEITSOBJEKTE DURCH DIESES OBJEKT FLIEGEN. WARNUNG: VERRINGERT DIE LEISTUNG!",
        "\ud65c\uc131\ud654\ud558\uba74 \ube60\ub978 \uc18d\ub3c4\uc758 \uac1c\uccb4\uac00 \uc774 \uac1c\uccb4\ub97c \ud1b5\uacfc\ud558\uac8c \ud569\ub2c8\ub2e4. \uacbd\uace0: \uc131\ub2a5\uc744 \uc800\ud558\uc2dc\ud0b5\ub2c8\ub2e4!",
        "ABILITANDO QUESTA OPZIONE, GLI OGGETTI AD ALTA VELOCIT\u00c0 NON POTRANNO ATTRAVERSARE QUESTO OGGETTO. ATTENZIONE: DIMINUISCE LA PRESTAZIONE!",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u041d\u0415 \u041f\u041e\u0417\u0412\u041e\u041b\u0418\u0422 \u041e\u0411\u042a\u0415\u041a\u0422\u0410\u041c, \u0414\u0412\u0418\u0416\u0423\u0429\u0418\u041c\u0421\u042f \u0421 \u0411\u041e\u041b\u042c\u0428\u041e\u0419 \u0421\u041a\u041e\u0420\u041e\u0421\u0422\u042c\u042e, \u041f\u0420\u041e\u0425\u041e\u0414\u0418\u0422\u042c \u0421\u041a\u0412\u041e\u0417\u042c \u041e\u0411\u042a\u0415\u041a\u0422\u042b. \u041f\u0420\u0418\u041c\u0415\u0427\u0410\u041d\u0418\u0415: \u0421\u041d\u0418\u0416\u0410\u0415\u0422 \u041f\u0420\u041e\u0418\u0417\u0412\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c \u0418\u0413\u0420\u042b!",
        "POVOLEN\u00cd ZAJIST\u00cd, \u017dE RYCHLE SE POHYBUJ\u00cdC\u00cd OBJEKTY NEMOHOU PROJ\u00cdT T\u00cdMTO OBJEKTEM. VAROV\u00c1N\u00cd: SNI\u017dUJE V\u00ddKON!",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YT\u00d6\u00d6NOTTO VARMISTAA, ETTEIV\u00c4T SUURINOPEUKSISET OBJEKTIT MENE T\u00c4M\u00c4N OBJEKTIN L\u00c4PI. VAROITUS: ALENTAA SUORITUSKYKY\u00c4!",
        "HABILITAR ISTO ASSEGURA QUE OBJETOS EM ALTA VELOCIDADE N\u00c3O POSSAM ATRAVESSAR ESTE OBJETO. AVISO: REDUZ O DESEMPENHO!",
        "ACTIVAR ESTO HACE QUE LOS OBJETOS A ALTA VELOCIDAD NO PUEDAN ATRAVESAR ESTE OBJETO. AVISO: \u00a1DISMINUYE EL RENDIMIENTO!"
    ],
    "HELP_OBJECTPROPERTIES_100": [
        "CHANGES THE MASS OF THE OBJECT",
        "\u66f4\u6539\u7269\u4f53\u7684\u8d28\u91cf",
        "\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u8cea\u91cf\u3092\u5909\u66f4\u3057\u307e\u3059",
        "MODIFIE LA MASSE DE L'OBJET",
        "\u00c4NDERT DIE MASSE DES OBJEKTS",
        "\ub9ce\uc740 \uac1c\uccb4\ub97c \ubc14\uafc9\ub2c8\ub2e4.",
        "MODIFICA LA MASSA DELL'OGGETTO",
        "\u0418\u0417\u041c\u0415\u041d\u042f\u0415\u0422 \u041c\u0410\u0421\u0421\u0423 \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "M\u011aN\u00cd HMOTNOST OBJEKTU",
        "MUUTTAA OBJEKTIN MASSAA",
        "ALTERA A MASSA DO OBJETO",
        "CAMBIA LA MASA DEL OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_105": [
        "HIGH VALUES MAKES THE OBJECT FEEL VERY SLIPPERY, ICE-LIKE",
        "\u9ad8\u503c\u4f1a\u4f7f\u7269\u4f53\u611f\u89c9\u975e\u5e38\u6ed1\uff0c\u5c31\u50cf\u51b0\u4e00\u6837",
        "\u9ad8\u3044\u5024\u3092\u6307\u5b9a\u3059\u308b\u3068\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u6c37\u306e\u4e0a\u306b\u4e57\u3063\u305f\u307f\u305f\u3044\u306b\u3068\u3063\u3066\u3082\u6ed1\u308a\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002",
        "LES VALEURS \u00c9LEV\u00c9ES RENDDENT LES OBJETS TR\u00c8S GLISSANTS, COMME DE LA GLACE",
        "DURCH HOHE WERTE WIRD DAS OBJEKT SEHR GLATT, EIS\u00c4HNLICH",
        "\ub192\uc740 \uac12\uc740 \uac1c\uccb4\ub97c \uc5bc\uc74c\ucc98\ub7fc \ub9e4\uc6b0 \ubbf8\ub044\ub7fd\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.",
        "VALORI ALTI RENDONO L'OGGETTO SCIVOLOSO COME GHIACCIO",
        "\u0412\u042b\u0421\u041e\u041a\u0418\u0415 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u042f \u0414\u0415\u041b\u0410\u042e\u0422 \u041e\u0411\u042a\u0415\u041a\u0422 \u041e\u0427\u0415\u041d\u042c \u0421\u041a\u041e\u041b\u042c\u0417\u041a\u0418\u041c, \u041f\u041e\u0425\u041e\u0416\u0418\u041c \u041d\u0410 \u041b\u0415\u0414",
        "VYSOK\u00c9 HODNOTY U\u010cIN\u00cd OBJEKT VELMI KLUZK\u00dd, JAKO LED",
        "KORKEAT ARVOT MUUTTAVAT OBJEKTIN ERITT\u00c4IN LIUKKAAKSI, J\u00c4\u00c4N KALTAISEKSI",
        "VALORES ALTOS DEIXAM O OBJETO MUITO ESCORREGADIO, COMO GELO",
        "LOS VALORES ALTOS HACEN QUE EL OBJETO RESULTE MUY RESBALADIZO, COMO EL HIELO"
    ],
    "HELP_OBJECTPROPERTIES_106": [
        "CHANGE THE BOUNCINESS OF THE OBJECT",
        "\u66f4\u6539\u7269\u4f53\u7684\u5f39\u6027",
        "\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u8df3\u306d\u3084\u3059\u3055\u3092\u5909\u66f4\u3057\u307e\u3059",
        "MODIFIE LE REBOND DE L'OBJET",
        "\u00c4NDERT DIE ABPRALLST\u00c4RKE DES OBJEKTS",
        "\uac1c\uccb4\uc758 \ud295\uae40\uc744 \ubc14\uafc9\ub2c8\ub2e4.",
        "MODIFICA IL RIMBALZO DELL'OGGETTO",
        "\u0418\u0417\u041c\u0415\u041d\u0418\u0422\u042c \u0420\u0418\u041a\u041e\u0428\u0415\u0422\u0418\u0420\u041e\u0412\u0410\u041d\u0418\u0415 \u041e\u0422 \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "ZM\u011aN\u00cd ODR\u00c1\u017dEN\u00cd OBJEKTU",
        "MUUTTAA OBJEKTIN KIMMOISUUTTA",
        "ALTERAR O RICOCHETE DO OBJETO",
        "CAMBIA EL REBOTE DEL OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_107": [
        "DAMP THE OBJECT'S MOVEMENT",
        "\u51cf\u5f31\u7269\u4f53\u7684\u8fd0\u52a8",
        "\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u79fb\u52d5\u901f\u5ea6\u3092\u6291\u3048\u307e\u3059",
        "ATT\u00c9NUE LE MOUVEMENT DE L'OBJET",
        "D\u00c4MPFT DIE BEWEGUNG DES OBJEKTS",
        "\uac1c\uccb4\uc758 \uc774\ub3d9\uc744 \ubc29\ud574\ud569\ub2c8\ub2e4.",
        "SMORZA IL MOVIMENTO DELL'OGGETTO",
        "\u0413\u0410\u0421\u0418\u0422\u042c \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "ZTLUM\u00cd POHYB OBJEKTU",
        "HIDASTAA OBJEKTIN LIIKETT\u00c4",
        "AMORTECER O MOVIMENTO DO OBJETO",
        "DISMINUYE EL MOVIMIENTO DEL OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_108": [
        "DAMP THE OBJECT'S ANGULAR MOVEMENT",
        "\u51cf\u5f31\u7269\u4f53\u7684\u89d2\u8fd0\u52a8",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u89d2\u901f\u5ea6\u3092\u6291\u3048\u307e\u3059",
        "ATT\u00c9NUE LE MOUVEMENT ANGULAIRE DE L'OBJET",
        "D\u00c4MPFT DIE WINKELBEWEGUNG DES OBJEKTS",
        "\uac1c\uccb4\uc758 \uac01\ub3c4 \uc774\ub3d9\uc744 \ubc29\ud574\ud569\ub2c8\ub2e4.",
        "SMORZA IL MOVIMENTO ANGOLARE DELL'OGGETTO",
        "\u0413\u0410\u0421\u0418\u0422\u042c \u0423\u0413\u041b\u041e\u0412\u041e\u0415 \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "ZTLUM\u00cd POHYB OBJEKTU V \u00daHLECH",
        "HIDASTAA OBJEKTIN KULMITTAISTA LIIKETT\u00c4",
        "AMORTECER O MOVIMENTO ANGULAR DO OBJETO",
        "DISMINUYE EL MOVIMIENTO ANGULAR DEL OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_217": [
        "ENABLING THIS MAKES LASER BEAM BOUNCE FROM THIS OBJECT",
        "\u542f\u7528\u8fd9\u9879\u5c06\u4f7f\u6fc0\u5149\u675f\u5728\u6b64\u7269\u4f53\u4e0a\u53cd\u5f39",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u30ec\u30fc\u30b6\u30fc\u5149\u7dda\u304c\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u53cd\u5c04\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI FAIT REBONDIR LE RAYON LASER DEPUIS CET OBJET",
        "BEI AKTIVIERUNG WIRD DER LASERSTRAHL VON DIESEM OBJEKT ABPRALLEN",
        "\ud65c\uc131\ud654\ud558\uba74 \ub808\uc774\uc800 \ube54\uc774 \uc774 \uac1c\uccb4\uc5d0\uc11c \ud295\uae41\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, IL RAGGIO LASER POTR\u00c0 RIMBALZARE SU QUESTO OGGETTO",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u041f\u041e\u0417\u0412\u041e\u041b\u042f\u0415\u0422 \u041b\u0410\u0417\u0415\u0420\u0423 \u041e\u0422\u0421\u041a\u0410\u041a\u0418\u0412\u0410\u0422\u042c \u041e\u0422 \u042d\u0422\u041e\u0413\u041e \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "POVOLEN\u00cd ZP\u016eSOB\u00cd, \u017dE SE LASERY BUDOU ODR\u00c1\u017dET OD TOHOTO OBJEKTU",
        "T\u00c4M\u00c4N ASETUKSEN K\u00c4YTT\u00d6\u00d6NOTTO SAA LASERS\u00c4TEET KIMPOAMAAN T\u00c4ST\u00c4 KOHTEESTA",
        "HABILITAR ISTO FAZ O FEIXE DE LASER RICOCHETEAR A PARTIR DESTE OBJETO",
        "ACTIVAR ESTO HACE QUE EL RAYO L\u00c1SER REBOTE A PARTIR DE ESTE OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_215": [
        "ENABLING THIS MAKES THE OBJECT DESTROYABLE BY LASERS",
        "\u542f\u7528\u8fd9\u9879\u5c06\u4f7f\u7269\u4f53\u53ef\u88ab\u6fc0\u5149\u6467\u6bc1",
        "\u3053\u308c\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u30ec\u30fc\u30b6\u30fc\u306b\u3088\u3063\u3066\u7834\u58ca\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059",
        "ACTIVER CECI PERMET AUX LASERS DE D\u00c9TRUIRE CET OBJET",
        "BEI AKTIVIERUNG KANN DIESES OBJEKT VON LASERN ZERST\u00d6RT WERDEN",
        "\ud65c\uc131\ud654\ud558\uba74 \uac1c\uccb4\uac00 \ub808\uc774\uc800\ub85c \ud30c\uad34\ub429\ub2c8\ub2e4.",
        "ABILITANDO QUESTA OPZIONE, L'OGGETTO POTR\u00c0 ESSERE DISTRUTTO DAI LASER",
        "\u0412\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u0415 \u042d\u0422\u041e\u0419 \u041e\u041f\u0426\u0418\u0418 \u0414\u0415\u041b\u0410\u0415\u0422 \u041e\u0411\u042a\u0415\u041a\u0422 \u0423\u042f\u0417\u0412\u0418\u041c\u042b\u041c \u0414\u041b\u042f \u041b\u0410\u0417\u0415\u0420\u0410",
        "POVOLEN\u00cd U\u010cIN\u00cd TENTO OBJEKT ZNI\u010cITELN\u00dd LASERY",
        "T\u00c4M\u00c4N OBJEKTIN K\u00c4YT\u00d6\u00d6NOTTO MAHDOLLISTAA, ETT\u00c4 LASERS\u00c4TEET VOIVAT TUHOTA T\u00c4M\u00c4N KOHTEEN",
        "HABILITAR ISTO TORNA O OBJETO DESTRUT\u00cdVEL POR LASERS",
        "ACTIVAR ESTO HACE QUE LOS L\u00c1SERES PUEDAN DESTRUIR ESTE OBJETO"
    ],
