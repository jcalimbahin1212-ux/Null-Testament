<particle_effects folder="particles" spritesheet="particles.plist">
    <explosion maxPoor="3">
        <particle_effect maxParticles="6" filename="buff.plist" />
        <particle_effect maxParticles="24" filename="explosion.plist" />
        <particle_effect maxParticles="16" filename="black-explosion.plist" /> 
    </explosion>
    
    <avatar_explosion maxPoorBeforeLight="2" maxPoor="10" maxMediumBeforeLight="5">
        <normal>
            <particle_effect maxParticles="20" filename="avatar-explosion.plist" />
        </normal>
        <light>
            <particle_effect maxParticles="5" filename="avatar-explosion_light.plist" />
        </light>
    </avatar_explosion>

    <burdock_explosion maxPoor="5">
        <particle_effect maxParticles="10" filename="burdock-explosion.plist" />
    </burdock_explosion>
    
    <avatar_squash maxPoorBeforeLight="2" maxPoor="10" maxMediumBeforeLight="5">
        <normal>
            <particle_effect maxParticles="30" filename="squash.plist" />
        </normal>
        <light>
            <particle_effect maxParticles="10" filename="squash-light.plist" />
        </light>
    </avatar_squash>

    <avatar_hit maxPoor="3">
        <particle_effect maxParticles="5" filename="small-hit.plist" />
    </avatar_hith>

    <lazer_hit>
        <particle_effect maxParticles="20" filename="lazer-hit.plist" />
    </lazer_hit>

    <skip_checkpoint>
        <particle_effect maxParticles="50" filename="skip-1.plist" />
    </skip_checkpoint>

    <end-pipe>
        <particle_effect filename="custom-end-pipe" particlegfx="dust-cloud.png" />
    </end-pipe>

    <item_pickup maxPoor="3">
        <particle_effect maxParticles="20" filename="buff-2.plist" />
    </item_pickup>

    <item_trail>
        <particle_effect maxParticles="20" filename="item-dust.plist" />
    </item_trail>

    <blow_effect>
        <particle_effect maxParticles="20" filename="blow.plist" />
    </blow_effect>

    <magnet_effect>
        <particle_effect maxParticles="40" filename="Black-hole.plist" />
    </magnet_effect>
    
    <hilight_mission>
        <particle_effect maxParticles="20" filename="hilight-mission.plist" />
    </hilight_mission>
    
    <hilight_text>
        <particle_effect maxParticles="20" filename="hilight-text.plist" />
    </hilight_text>

    <hilight_text_2>
        <particle_effect maxParticles="20" filename="hilight-text-2.plist" />
    </hilight_text_2>

    <background>
        <particle_effect id="0" filename="custom-dust" particlegfx="spark.png" icon="spark-1.png" size="3.0" speed="25.0" amount="50" tickInReset="1" category="20" />
        <particle_effect id="1" maxParticles="10" filename="dust-2.plist" icon="spark-2.png" tickInReset="1" category="20" />
        <particle_effect id="2" maxParticles="7" filename="fire-flies.plist" icon="spark-3.png" tickInReset="1" category="20" />
        <particle_effect id="3" maxParticles="3" filename="drop.plist" icon="drop-1.png" tickInReset="0" category="20" />
        <particle_effect id="4" maxParticles="16" filename="flood-drop.plist" icon="drops-1.png" tickInReset="0" category="20" />
        <particle_effect id="5" maxParticles="10" filename="smoke.plist" icon="smoke.png" tickInReset="1" category="20" />
        <particle_effect id="6" maxParticles="40" filename="smoke-2.plist" icon="smoke-3.png" tickInReset="1" category="20" />
        <particle_effect id="7" maxParticles="40" filename="smoke-3.plist" icon="smoke-2.png" tickInReset="1" category="20" />
        <particle_effect id="8" maxParticles="25" filename="swarm-1.plist" icon="spark-4.png" tickInReset="1" category="20" />
        <particle_effect id="9" maxParticles="40" filename="volcano-1.plist" icon="spark-5.png" tickInReset="1" category="20" />
        <particle_effect id="10" maxParticles="40" filename="volcano-2.plist" icon="spark-6.png" tickInReset="1" category="20" />
        <particle_effect id="11" maxParticles="40" filename="volcano-3.plist" icon="spark-7.png" tickInReset="1" category="20" />
