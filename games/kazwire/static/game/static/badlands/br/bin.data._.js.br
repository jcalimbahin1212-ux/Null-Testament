    "ACH_HINT_63": [
        "HINT: LEVEL CLONEFEST IN COOP",
        "\u63d0\u793a\uff1a\u5408\u4f5c\u6a21\u5f0f\u4e0b\u7684\u514b\u9686\u8282\u5173",
        "\u30d2\u30f3\u30c8\uff1a\u5354\u529b\u30e2\u30fc\u30c9\u306e\u30ec\u30d9\u30eb\u300cCLONEFEST\u300d",
        "ASTUCE\u00a0: NIVEAU CLONEFEST EN COOP",
        "TIPP: LEVEL KLONFEST IM KOOP-MODUS",
        "\ud78c\ud2b8: \ud611\ub3d9 \ubaa8\ub4dc\uc758 \ub808\ubca8 \ud074\ub860\ud398\uc2a4\ud2b8",
        "SUGGERIMENTO: LIVELLO CLONEMANIA IN COOP",
        "\u041f\u041e\u0414\u0421\u041a\u0410\u0417\u041a\u0410: \u0423\u0420\u041e\u0412\u0415\u041d\u042c \u00ab\u0424\u0415\u0421\u0422\u0418\u0412\u0410\u041b\u042c\u00bb \u0412 \u0421\u041e\u0412\u041c\u0415\u0421\u0422\u041d\u041e\u041c \u0420\u0415\u0416\u0418\u041c\u0415.",
        "N\u00c1POV\u011aDA: \u00daROVE\u0147 KLONFEST V KOOPERACI",
        "VIHJE: KENTT\u00c4 KLOONIRY\u00d6PPY YHTEISPELISS\u00c4",
        "DICA: N\u00cdVEL FESTA CLONE EM COOP",
        "PISTA: NIVEL CLONEFEST EN MODO COOPERATIVO"
