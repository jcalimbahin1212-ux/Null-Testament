    "HINT_FLOW_05": [
        "YOU CAN ALSO PLAY THE SINGLE PLAYER LEVELS\nCOOPERATIVELY WITH UP TO FOUR PLAYERS",
        "\u4f60\u8fd8\u53ef\u4ee5\u73a9\u5355\u4eba\u5173\u5361\n\u5e76\u4e0e\u6700\u591a\u56db\u4f4d\u73a9\u5bb6\u5408\u4f5c",
        "\u3055\u3089\u306b\u6700\u5927 4 \u4eba\u3068\u5354\u529b\u3057\u3066\n\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u7528\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u53ef\u80fd",
        "VOUS POUVEZ \u00c9GALEMENT JOUER AUX NIVEAUX \u00c0 UN SEUL JOUEUR\nEN COOP AVEC JUSQU'\u00c0 QUATRE JOUEURS",
        "DU KANNST DIE EINZELSPIELER-LEVEL AUCH\nIM KOOP-MODUS MIT BIS ZU VIER SPIELERN SPIELEN",
        "\ub610\ud55c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ub808\ubca8\ub3c4 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc5b4\uc694.\n\ucd5c\ub300 4\uba85\uc758 \ud50c\ub808\uc774\uc5b4\uc640 \ud568\uaed8 \ud611\ub3d9\ud558\uc138\uc694.",
        "PUOI ANCHE GIOCARE AI LIVELLI GIOCATORE SINGOLO\nIN MODALIT\u00c0 COOPERATIVA FINO A QUATTRO GIOCATORI",
        "\u0422\u0410\u041a\u0416\u0415 \u0412\u042b \u041c\u041e\u0416\u0415\u0422\u0415 \u0418\u0413\u0420\u0410\u0422\u042c \u041d\u0410 \u041e\u0414\u0418\u041d\u041e\u0427\u041d\u042b\u0425 \u0423\u0420\u041e\u0412\u041d\u042f\u0425\n\u0412\u041c\u0415\u0421\u0422\u0415 \u0421 \u0414\u0420\u0423\u0413\u0418\u041c\u0418 \u0418\u0413\u0420\u041e\u041a\u0410\u041c\u0418 (\u0414\u041e 4)",
        "M\u016e\u017dE\u0160 TAK\u00c9 HR\u00c1T \u00daROVN\u011a PRO JEDNOHO HR\u00c1\u010cE\nKOOPERATIVN\u011a A\u017d SE \u010cTY\u0158MI HR\u00c1\u010cI",
        "VOIT MY\u00d6S PELATA YKSINPELIKENTTI\u00c4\nYHDESS\u00c4 JOPA NELJ\u00c4N PELAAJAN KANSSA",
        "VOC\u00ca TAMB\u00c9M PODE JOGAR OS N\u00cdVEIS PARA UM JOGADOR\nCOOPERATIVAMENTE COM AT\u00c9 QUATRO JOGADORES",
        "TAMBI\u00c9N PUEDES JUGAR LOS NIVELES DE UN JUGADOR EN\nMODO COOPERATIVO HASTA CON CUATRO JUGADORES"
    ],
