    "EDITOR_SAVE_GROUP_MAX_HIT": [
        "YOU ALREADY HAVE %I GROUPS SAVED\nDELETE GROUPS TO MAKE ROOM FOR A NEW ONE",
        "\u60a8\u5df2\u4fdd\u5b58\u4e86%I\u4e2a\u7fa4\u7ec4\n\u5220\u9664\u7fa4\u7ec4\u4ee5\u4fbf\u4fdd\u5b58\u65b0\u7fa4\u7ec4",
        "\u3059\u3067\u306b%I\u500b\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u4fdd\u5b58\u3057\u3066\u3044\u307e\u3059\n\u65b0\u3057\u3044\u30b0\u30eb\u30fc\u30d7\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u4eca\u3042\u308b\u30b0\u30eb\u30fc\u30d7\u3092\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044",
        "VOUS AVEZ D\u00c9J\u00c0 ENREGISTR\u00c9 %I GROUPES\nSUPPRIMEZ LES GROUPES POUR FAIRE DE LA PLACE \u00c0 UN NOUVEAU GROUPE",
        "DU HAST BEREITS %I GRUPPEN GESPEICHERT\nL\u00d6SCHE GRUPPEN, UM PLATZ F\u00dcR EINE NEUE ZU SCHAFFEN",
        "\uc774\ubbf8 %I\uac1c\uc758 \uadf8\ub8f9\uc744 \uc800\uc7a5\ud588\uc2b5\ub2c8\ub2e4.\n\uc0c8\ub85c \uc800\uc7a5\ud558\ub824\uba74 \uadf8\ub8f9\uc744 \uc0ad\uc81c\ud558\uc138\uc694.",
        "HAI GIA %I GRUPPI SALVATI\nCANCELLA GRUPPI PER FAR SPAZIO A UNO NUOVO",
        "\u0412\u042b \u0423\u0416\u0415 \u0421\u041e\u0425\u0420\u0410\u041d\u0418\u041b\u0418 %I \u0413\u0420\u0423\u041f\u041f\n\u0423\u0414\u0410\u041b\u0418\u0422\u0415 \u0413\u0420\u0423\u041f\u041f\u042b, \u0427\u0422\u041e\u0411\u042b \u0421\u041e\u0425\u0420\u0410\u041d\u0418\u0422\u042c \u041d\u041e\u0412\u0423\u042e",
        "M\u00c1\u0160 U\u017d ULO\u017dENO %I SKUPIN\nSMA\u017d SKUPINY, ABYS UD\u011aLAL M\u00cdSTO PRO NOV\u00c9",
        "OLET JO TALLENTANUT %I RYHM\u00c4\u00c4\nPOISTA RYHMI\u00c4, JOTTA VOIT LUODA UUDEN",
        "VOC\u00ca J\u00c1 POSSUI %I GRUPOS SALVOS\nEXCLUA GRUPOS PARA CRIAR ESPA\u00c7O PARA UM NOVO GRUPO",
        "YA TIENES %I GRUPOS GUARDADOS\nELIMINA GRUPOS PARA HACER SITIO A LOS NUEVOS"
    ],
