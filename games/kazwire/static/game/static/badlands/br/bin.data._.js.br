    "WARNING_TOD_CHANGE": [
        "BY CHANGING THE TIME OF DAY NOW YOU WILL LOSE ALL BACKGROUND OBJECTS!\r\nARE YOU SURE YOU WANT TO CONTINUE?",
        "\u73b0\u5728\u66f4\u6539\u4e00\u5929\u4e2d\u7684\u65f6\u95f4\uff0c\u60a8\u5c06\u4f1a\u5931\u53bb\u6240\u6709\u80cc\u666f\u7269\u4f53\uff01\n\u786e\u5b9a\u8981\u7ee7\u7eed\u5417\uff1f",
        "\u73fe\u6642\u70b9\u30671\u65e5\u306e\u3046\u3061\u306e\u6642\u9593\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304c\u5931\u308f\u308c\u307e\u3059\uff01\r\n\u672c\u5f53\u306b\u7d9a\u884c\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3059\u304b\uff1f",
        "EN MODIFIANT MAINTENANT L'HEURE DU JOUR, VOUS PERDREZ TOUS LES OBJETS DE L\u2019ARRI\u00c8RE-PLAN\u00a0!\r\nVOULEZ-VOUS VRAIMENT CONTINUER\u00a0?",
        "DURCH \u00c4NDERN DER TAGESZEIT GEHEN S\u00c4MTLICHE HINTERGRUNDOBJEKTE VERLOREN!\r\nBIST DU SICHER, DASS DU FORTFAHREN M\u00d6CHTEST?",
        "\uc9c0\uae08 \ub0a0\uc758 \uc2dc\uac04\uc744 \ubcc0\uacbd\ud558\uba74 \ubaa8\ub4e0 \ubc30\uacbd \uac1c\uccb4\ub97c \uc783\uc2b5\ub2c8\ub2e4!\r\n\uacc4\uc18d\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",
        "MODIFICANDO ADESSO L'ORA PERDERAI TUTTI GLI OGGETTI SULLO SFONDO! \r\nSEI SICURO DI VOLER PROCEDERE?",
        "\u0415\u0421\u041b\u0418 \u0412\u042b \u0418\u0417\u041c\u0415\u041d\u0418\u0422\u0415 \u0421\u0415\u0419\u0427\u0410\u0421 \u0412\u0420\u0415\u041c\u042f \u0414\u041d\u042f, \u0422\u041e \u041f\u041e\u0422\u0415\u0420\u042f\u0415\u0422\u0415 \u0412\u0421\u0415 \u0424\u041e\u041d\u041e\u0412\u042b\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b!\r\n\u0412\u042b \u0423\u0412\u0415\u0420\u0415\u041d\u042b, \u0427\u0422\u041e \u0425\u041e\u0422\u0418\u0422\u0415 \u041f\u0420\u041e\u0414\u041e\u041b\u0416\u0418\u0422\u042c?",
        "ZM\u011aNOU DENN\u00cd DOBY ZTRAT\u00cd\u0160 V\u0160ECHNY OBJEKTY NA POZAD\u00cd!\r\nOPRAVDU CHCE\u0160 POKRA\u010cOVAT?",
        "VUOROKAUDENAIKAA VAIHDETTAESSA KAIKKI TAUSTAN OBJEKTIT MENETET\u00c4\u00c4N!\r\nHALUATKO VARMASTI JATKAA?",
        "AO ALTERAR A HORA DO DIA, VOC\u00ca PERDER\u00c1 TODOS OS OBJETOS EM SEGUNDO PLANO!\r\nVOC\u00ca DESEJA MESMO CONTINUAR?",
        "\u00a1AL CAMBIAR LA HORA DEL D\u00cdA PERDER\u00c1S LOS OBJETOS DEL FONDO!\r\n\u00bfSEGURO QUE QUIERES CONTINUAR?"
    ],
    "WARNING_BG_CHANGE": [
        "BY CHANGING THE BACKGROUND NOW YOU WILL LOSE ALL BACKGROUND OBJECTS!\r\nARE YOU SURE YOU WANT TO CONTINUE?",
        "\u73b0\u5728\u66f4\u6539\u80cc\u666f\uff0c\u60a8\u5c06\u4f1a\u5931\u53bb\u6240\u6709\u80cc\u666f\u7269\u4f53\uff01\n\u786e\u5b9a\u8981\u7ee7\u7eed\u5417\uff1f",
        "\u73fe\u6642\u70b9\u3067\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304c\u5931\u308f\u308c\u307e\u3059\uff01\r\n\u672c\u5f53\u306b\u7d9a\u884c\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3059\u304b\uff1f",
        "EN MODIFIANT MAINTENANT L\u2019ARRI\u00c8RE-PLAN, VOUS PERDREZ TOUS LES OBJETS DE L\u2019ARRI\u00c8RE-PLAN\u00a0!\r\nVOULEZ-VOUS VRAIMENT CONTINUER\u00a0?",
        "WENN DU DEN HINTERGRUND JETZT \u00c4NDERST, GEHEN ALLE HINTERGRUNDOBJEKTE VERLOREN!\r\nBIST DU SICHER, DASS DU FORTFAHREN M\u00d6CHTEST?",
        "\uc9c0\uae08 \ubc30\uacbd\uc744 \ubcc0\uacbd\ud558\uba74 \ubaa8\ub4e0 \ubc30\uacbd \uac1c\uccb4\ub97c \uc783\uc2b5\ub2c8\ub2e4.\r\n\uacc4\uc18d\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",
        "MODIFICANDO ADESSO LO SFONDO PERDERAI TUTTI GLI OGGETTI SULLO SFONDO!\r\nSEI SICURO DI VOLER PROCEDERE?",
        "\u0415\u0421\u041b\u0418 \u0412\u042b \u0418\u0417\u041c\u0415\u041d\u0418\u0422\u0415 \u0421\u0415\u0419\u0427\u0410\u0421 \u0424\u041e\u041d, \u0422\u041e \u041f\u041e\u0422\u0415\u0420\u042f\u0415\u0422\u0415 \u0412\u0421\u0415 \u0424\u041e\u041d\u041e\u0412\u042b\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b!\r\n\u0412\u042b \u0423\u0412\u0415\u0420\u0415\u041d\u042b, \u0427\u0422\u041e \u0425\u041e\u0422\u0418\u0422\u0415 \u041f\u0420\u041e\u0414\u041e\u041b\u0416\u0418\u0422\u042c?",
        "ZM\u011aNOU POZAD\u00cd ZTRAT\u00cd\u0160 V\u0160ECHNY OBJEKTY NA POZAD\u00cd!\r\nOPRAVDU CHCE\u0160 POKRA\u010cOVAT?",
        "TAUSTAA VAIHDETTAESSA KAIKKI TAUSTAN OBJEKTIT MENETET\u00c4\u00c4N!\r\nHALUATKO VARMASTI JATKAA?",
        "AO ALTERAR O SEGUNDO PLANO, VOC\u00ca PERDER\u00c1 TODOS OS OBJETOS EM SEGUNDO PLANO!\r\nVOC\u00ca DESEJA MESMO CONTINUAR?",
        "\u00a1AL CAMBIAR EL FONDO PERDER\u00c1S TODOS LOS OBJETOS DEL FONDO!\r\n\u00bfSEGURO QUE QUIERES CONTINUAR?"
    ],
