    "HELP_OBJECTPROPERTIES_84_3": [
        "SHAKES THE GAME CAMERA",
        "\u6643\u52a8\u6e38\u620f\u955c\u5934",
        "\u30b2\u30fc\u30e0\u30ab\u30e1\u30e9\u3092\u30d6\u30ec\u3055\u305b\u307e\u3059",
        "SECOUE LA CAM\u00c9RA",
