    "DLC_END_SCREEN_DESC": [
        "GET THE FULL DOOMSDAY PACK\nWITH 7 MORE LEVELS AND\nTEST YOUR SKILLS",
        "\u83b7\u5f97\u5b8c\u6574\u7684\u4e16\u754c\u672b\u65e5\u5173\u5361\u5305\n\u65b0\u589e7\u4e2a\u5173\u5361\n\u8003\u9a8c\u4f60\u7684\u6280\u80fd",
        "\u7d42\u672b\u306e\u65e5\u30d1\u30c3\u30af\u5b8c\u5168\u7248\u3092\u5165\u624b\n7\u3064\u306e\u8ffd\u52a0\u30ec\u30d9\u30eb\u3067\n\u81ea\u3089\u306e\u5b9f\u529b\u3092\u8a66\u305d\u3046",
        "ACHETEZ LES 7 AUTRES\nNIVEAUX DU PACK FIN DU \nMONDE ET RELEVEZ LE D\u00c9FI",
        "HOL DIR DAS J\u00dcNGSTER-TAG-PAKET\nMIT 7 WEITEREN LEVELN\nUND ZEIG, WAS DU KANNST",
        "\ub460\uc2a4\ub370\uc774 \ud480 \ud329\uc73c\ub85c\n7\uac1c\uc758 \ucd94\uac00 \ub808\ubca8\uacfc\n\ub3c4\uc804\uc801 \ub09c\uc774\ub3c4\ub97c \uc990\uae30\uc138\uc694",
