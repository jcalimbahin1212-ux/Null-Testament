    "NO_SAVE_DATA_CREATING_NEW": [
        "THERE IS NO SAVE DATA IN THIS SYSTEM. CREATING A NEW ONE.",
        "\u5728\u7cfb\u7edf\u4e2d\u6ca1\u6709\u4fdd\u5b58\u7684\u6570\u636e\u3002\u6b63\u5728\u521b\u5efa\u65b0\u6570\u636e\u3002",
        "\u30b7\u30b9\u30c6\u30e0\u5185\u306b\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u65b0\u3057\u304f\u4f5c\u6210\u4e2d\u3067\u3059\u3002",
