    "EDITOR_TIP_01": [
        "DON'T BE AFRAID OF PUBLISHING YOUR LEVEL! YOU CAN ALWAYS UPDATE IT LATER",
        "\u4e0d\u8981\u6015\u53d1\u5e03\u81ea\u5df1\u7684\u5173\u5361\uff01\u60a8\u540e\u7eed\u53ef\u4ee5\u968f\u65f6\u66f4\u65b0",
        "\u3042\u306a\u305f\u306e\u30ec\u30d9\u30eb\u306f\u3044\u3064\u3067\u3082\u6c17\u697d\u306b\u516c\u958b\u3057\u3066\u3044\u305f\u3060\u3051\u307e\u3059\uff01 \u516c\u958b\u5f8c\u306b\u3044\u3064\u3067\u3082\u66f4\u65b0\u3067\u304d\u307e\u3059",
        "N'H\u00c9SITEZ PAS \u00c0 PUBLIER VOTRE NIVEAU ! VOUS POURREZ TOUJOURS LE METRE \u00c0 JOUR PLUS TARD",
        "HAB KEINE ANGST DAVOR, DEINEN LEVEL ZU VER\u00d6FFENTLICHEN! DU KANNST IHN SP\u00c4TER JEDERZEIT AKTUALISIEREN.",
        "\ub808\ubca8 \uac8c\uc2dc\ub97c \ub450\ub824\uc6cc\ud558\uc9c0 \ub9c8\uc138\uc694! \ub098\uc911\uc5d0 \uc5b8\uc81c\ub4e0\uc9c0 \uc5c5\ub370\uc774\ud2b8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "NON AVER PAURA DI PUBBLICARE IL TUO LIVELLO! PUOI SEMPRE AGGIORNARLO PI\u00d9 TARDI",
        "\u041d\u0415 \u0411\u041e\u0419\u0422\u0415\u0421\u042c \u041f\u0423\u0411\u041b\u0418\u041a\u041e\u0412\u0410\u0422\u042c \u0421\u0412\u041e\u0418 \u0423\u0420\u041e\u0412\u041d\u0418! \u0412\u042b \u0412\u0421\u0415\u0413\u0414\u0410 \u0421\u041c\u041e\u0416\u0415\u0422\u0415 \u041e\u0422\u0420\u0415\u0414\u0410\u041a\u0422\u0418\u0420\u041e\u0412\u0410\u0422\u042c \u0418\u0425 \u041f\u041e\u0417\u0414\u041d\u0415\u0415",
        "NEBOJ SE PUBLIKOVAT SV\u00c9 \u00daROVN\u011a! M\u016e\u017dE\u0160 JE KDYKOLIV UPRAVIT A AKTUALIZOVAT",
        "\u00c4L\u00c4 ARASTELE KENTT\u00c4SI JULKAISEMISTA! VOIT AINA P\u00c4IVITT\u00c4\u00c4 SIT\u00c4 MY\u00d6HEMMIN",
        "N\u00c3O TENHA RECEIO DE PUBLICAR O SEU N\u00cdVEL! VOC\u00ca SEMPRE PODE ATUALIZ\u00c1-LO MAIS TARDE",
        "\u00a1NO TENGAS MIEDO A PUBLICAR TU NIVEL! SIEMPRE PUEDES ACTUALIZARLO DESPU\u00c9S"
    ],
