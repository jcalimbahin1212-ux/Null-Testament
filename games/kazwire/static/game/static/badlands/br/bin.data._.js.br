    "EDITOR_HINT_0": [
        "GROUP OBJECTS TO MOVE THEM ALL AS ONE OBJECT",
        "\u5c06\u7269\u4f53\u52a0\u5165\u7fa4\u7ec4\uff0c\u4ee5\u4fbf\u4f5c\u4e3a\u4e00\u4e2a\u7269\u4f53\u6574\u4f53\u79fb\u52a8",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3059\u308b\u3053\u3068\u30671\u3064\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u3057\u3066\u4e00\u5ea6\u306b\u52d5\u304b\u305b\u307e\u3059",
        "REGROUPER LES OBJETS POUR LES D\u00c9PLACER COMME UN SEUL OBJET",
        "GRUPPENOBJEKTE, UM SIE ALS EIN OBJEKT ZU VERSCHIEBEN",
        "\ud558\ub098\uc758 \uac1c\uccb4\ucc98\ub7fc \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \uac1c\uccb4\ub97c \uadf8\ub8f9\uc73c\ub85c \ub9cc\ub4dc\uc138\uc694.",
        "RAGGRUPPA OGGETTI PER SPOSTARLI TUTTI INSIEME",
        "\u0413\u0420\u0423\u041f\u041f\u0418\u0420\u0423\u0419\u0422\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b, \u0427\u0422\u041e\u0411\u042b \u041f\u0415\u0420\u0415\u0414\u0412\u0418\u0413\u0410\u0422\u042c \u0418\u0425 \u0412\u0421\u0415 \u0420\u0410\u0417\u041e\u041c",
        "SESKUP\u00cd OBJEKTY, ABY BYLO MO\u017dN\u00c9 POHNOUT SE V\u0160EMI Z\u00c1ROVE\u0147",
        "RYHMIT\u00c4 OBJEKTIT SIIRT\u00c4\u00c4KSESI NIIT\u00c4 YHTEN\u00c4",
        "AGRUPE OBJETOS PARA MOVER TODOS ELES COMO UM \u00daNICO OBJETO",
        "AGRUPA OBJETOS PARA MOVERLOS COMO SI FUERAN UNO"
    ],
    "EDITOR_HINT_1": [
        "CHANGE THE SCALE OF THE EDITOR BUTTONS FROM THE EDITOR SETTINGS TO YOUR LIKING",
        "\u5728\u7f16\u8f91\u5668\u8bbe\u7f6e\u4e2d\u6309\u81ea\u5df1\u7684\u559c\u597d\u66f4\u6539\u7f16\u8f91\u5668\u6309\u94ae\u7684\u5927\u5c0f",
        "\u30a8\u30c7\u30a3\u30bf\u306e\u30dc\u30bf\u30f3\u306e\u5927\u304d\u3055\u306f\u30a8\u30c7\u30a3\u30bf\u306e\u8a2d\u5b9a\u753b\u9762\u304b\u3089\u304a\u597d\u307f\u306e\u30b5\u30a4\u30ba\u306b\u5909\u66f4\u3067\u304d\u307e\u3059",
        "MODIFIER L'\u00c9CHELLE DES BOUTONS DE L'\u00c9DITEUR \u00c0 PARTIR DES PARAM\u00c8TRES DE L'\u00c9DITEUR SELON VOS BESOINS",
        "\u00c4NDERE DEN MASSSTAB DER EDITOR-BUTTONS BEI DEN EDITOR-EINSTELLUNGEN NACH BELIEBEN",
        "\ud3b8\uc9d1\uae30 \uc124\uc815\uc5d0\uc11c \ud3b8\uc9d1\uae30 \ubc84\ud2bc\uc758 \ud06c\uae30\ub97c \ubcc0\uacbd\ud558\uc138\uc694.",
        "CAMBIA A PIACIMENTO LA SCALA DEI PULSANTI DELL'EDITOR DALLE IMPOSTAZIONI EDITOR",
        "\u0412\u042b\u0411\u0415\u0420\u0418\u0422\u0415 \u0423\u0414\u041e\u0411\u041d\u042b\u0419 \u0414\u041b\u042f \u0412\u0410\u0421 \u0420\u0410\u0417\u041c\u0415\u0420 \u041a\u041d\u041e\u041f\u041e\u041a \u0420\u0415\u0414\u0410\u041a\u0422\u041e\u0420\u0410 \u0412 \u0415\u0413\u041e \u041d\u0410\u0421\u0422\u0420\u041e\u0419\u041a\u0410\u0425",
        "ZM\u011a\u0147 \u0160K\u00c1LU TLA\u010c\u00cdTEK EDITORU V NASTAVEN\u00cd EDITORU PODLE SV\u00ddCH P\u0158EDSTAV",
        "MUUTA HALUTESSASI EDITORIN PAINIKKEIDEN KOKOA EDITORIN ASETUKSISTA",
        "ALTERE A ESCALA DOS BOT\u00d5ES DO EDITOR COMO DESEJAR A PARTIR DAS CONFIGURA\u00c7\u00d5ES DO EDITOR",
        "CAMBIA LA ESCALA DE LOS BOTONES DEL EDITOR DESDE LA CONFIGURACI\u00d3N DEL EDITOR A TU GUSTO"
    ],
    "EDITOR_HINT_2": [
        "VERSUS LEVELS DO NOT HAVE TO END IN THE END TUBE",
        "\u5bf9\u6297\u5173\u5361\u65e0\u9700\u5728\u672b\u7aef\u7ba1\u5b50\u4e2d\u7ed3\u675f",
        "\u5bfe\u6226\u30ec\u30d9\u30eb\u306f\u5fc5\u305a\u3057\u3082\u30a8\u30f3\u30c9\u30c1\u30e5\u30fc\u30d6\u3067\u7d42\u4e86\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093",
        "LES NIVEAUX DUEL N'ONT PAS \u00c0 SE TERMINER DANS LE TUBE FINAL",
        "VERSUS-LEVEL M\u00dcSSEN NICHT IM ROHRENDE ENDEN",
        "\ub300\uacb0 \ub808\ubca8\uc5d0\ub294 \ub05d \ud29c\ube0c\uc5d0 \ub05d\uc774 \uc788\uc744 \ud544\uc694\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.",
        "I LIVELLI SFIDA NON DEVONO NECESSARIAMENTE TERMINARE NEL TUBO FINALE",
        "\u0423\u0420\u041e\u0412\u041d\u0418 \u0421 \u0423\u0427\u0410\u0421\u0422\u0418\u0415\u041c \u0421\u041e\u041f\u0415\u0420\u041d\u0418\u041a\u041e\u0412 \u041d\u0415 \u041e\u0411\u042f\u0417\u0410\u0422\u0415\u041b\u042c\u041d\u041e \u0414\u041e\u041b\u0416\u041d\u042b \u0417\u0410\u0412\u0415\u0420\u0428\u0410\u0422\u042c\u0421\u042f \u0412 \u041a\u041e\u041d\u0415\u0427\u041d\u041e\u0419 \u0422\u0420\u0423\u0411\u0415",
        "\u00daROVN\u011a HRY VERSUS NEMUS\u00cd KON\u010cIT V TRUBICI",
        "PVP-KENTTIEN EI TARVITSE P\u00c4\u00c4TTY\u00c4 ULOSMENOPUTKEEN",
        "OS N\u00cdVEIS VERSUS N\u00c3O PRECISAM TERMINAR NO TUBO FINAL",
        "LOS NIVELES VERSUS NO TIENEN QUE ACABAR EN EL CONDUCTO FINAL"
    ],
    "EDITOR_HINT_3": [
        "HOLD TO SELECT INDIVIDUAL OBJECTS INSIDE A GROUP",
        "\u6309\u4f4f\u4ee5\u9009\u62e9\u4e00\u4e2a\u7fa4\u7ec4\u4e2d\u7684\u5355\u4e2a\u7269\u4f53",
        "\u30b0\u30eb\u30fc\u30d7\u5185\u306e\u5404\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u9078\u629e\u3059\u308b\u306b\u306f\u3001\u305d\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u9577\u62bc\u3057\u3057\u307e\u3059",
        "MAINTENIR APPUY\u00c9 POUR S\u00c9LECTIONNER LES OBJETS INDIVIDUELS DANS UN GROUPE",
        "HALTEN, UM EINZELNE OBJEKTE IN EINER GRUPPE AUSZUW\u00c4HLEN",
        "\ub20c\ub7ec\uc11c \uadf8\ub8f9 \ub0b4\uc758 \uac1c\ubcc4 \uac1c\uccb4\ub97c \uc120\ud0dd\ud558\uc138\uc694.",
        "TIENI PREMUTO PER SELEZIONARE OGGETTI SINGOLI IN UN GRUPPO",
        "\u0423\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0419\u0422\u0415, \u0427\u0422\u041e\u0411\u042b \u0412\u042b\u0411\u0420\u0410\u0422\u042c \u041e\u0422\u0414\u0415\u041b\u042c\u041d\u042b\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b \u0418\u0417 \u0413\u0420\u0423\u041f\u041f\u042b",
        "DR\u017dEN\u00cdM OZNA\u010c\u00cd\u0160 JEDNOTLIV\u00c9 OBJEKTY UVNIT\u0158 SKUPINY",
        "PID\u00c4 VALITAKSESI RYHM\u00c4ST\u00c4 YKSITT\u00c4ISI\u00c4 OBJEKTEJA",
        "SEGURE PARA SELECIONAR OBJETOS INDIVIDUAIS DENTRO DE UM GRUPO",
        "MANT\u00c9N PULSADO PARA SELECCIONAR OBJETOS INDIVIDUALES DENTRO DE UN GRUPO"
    ],
    "EDITOR_HINT_4": [
        "USE A FULL SCREEN TONER TO CREATE A UNIQUE VISUAL LOOK FOR YOUR LEVEL",
        "\u4f7f\u7528\u5168\u5c4f\u8c03\u8272\u5242\u4e3a\u5173\u5361\u521b\u9020\u72ec\u7279\u7684\u5916\u89c2",
        "\u30ec\u30d9\u30eb\u306b\u30e6\u30cb\u30fc\u30af\u306a\u898b\u305f\u76ee\u306e\u96f0\u56f2\u6c17\u3092\u4e0e\u3048\u308b\u306b\u306f\u3001\u30d5\u30eb\u30b9\u30af\u30ea\u30fc\u30f3\u30c8\u30ca\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046",
        "UTILISER UNE ENCRE D'\u00c9CRAN POUR CR\u00c9ER UNE APPARENCE UNIQUE POUR VOTRE NIVEAU",
        "BENUTZE EINEN VOLLBILDSCHIRM-TONER, UM DEINEM LEVEL EINEN EINMALIGEN LOOK ZU VERLEIHEN",
        "\uc804\uccb4 \ud654\uba74 \ud1a0\ub108\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub808\ubca8\uc5d0 \uace0\uc720\ud55c \ube44\uc8fc\uc5bc\uc744 \ub9cc\ub4dc\uc138\uc694.",
        "USA UN TONER A TUTTO SCHERMO PER CREARE UN LOOK UNICO PER IL TUO LIVELLO",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u041d\u0410\u0421\u042b\u0429\u0415\u041d\u041d\u042b\u0419 \u0420\u0410\u0421\u0422\u0420, \u0427\u0422\u041e\u0411\u042b \u0421\u041e\u0417\u0414\u0410\u0422\u042c \u0423\u041d\u0418\u041a\u0410\u041b\u042c\u041d\u042b\u0419 \u041e\u0411\u0420\u0410\u0417 \u0414\u041b\u042f \u0412\u0410\u0428\u0415\u0413\u041e \u0423\u0420\u041e\u0412\u041d\u042f",
        "POU\u017dIJ T\u00d3NOV\u00c1N\u00cd CEL\u00c9 OBRAZOVKY, ABYS VYTVO\u0158IL JEDINE\u010cN\u00dd VIZU\u00c1LN\u00cd VZHLED SV\u00c9 \u00daROVN\u011a",
        "K\u00c4YT\u00c4 KOKO N\u00c4YT\u00d6N S\u00c4VY\u00c4 JA LUO KENT\u00c4LLESI AINUTLAATUINEN ILME",
        "USE UM TOM EM TELA CHEIA PARA CRIAR UM VISUAL \u00daNICO PARA O SEU N\u00cdVEL",
        "USA UN TONO DE COLOR EN PANTALLA COMPLETA PARA CREAR UN ASPECTO VISUAL \u00daNICO PARA TU NIVEL"
    ],
    "EDITOR_HINT_5": [
        "SET FRICTION TO ZERO FOR ICE-LIKE FEEL",
        "\u5c06\u6469\u64e6\u8bbe\u4e3a\u96f6\u6765\u5b9e\u73b0\u51b0\u4e00\u822c\u7684\u611f\u89c9",
        "\u6c37\u307f\u305f\u3044\u306a\u611f\u3058\u3092\u6f14\u51fa\u3059\u308b\u306b\u306f\u6469\u64e6\u3092\u30bc\u30ed\u306b\u8a2d\u5b9a\u3057\u307e\u3059",
        "D\u00c9FINIR LA FRICTION SUR Z\u00c9RO POUR UN EFFET SEMBLABLE \u00c0 LA GLACE",
        "STELLE DIE REIBUNG AUF NULL, UM EIN EISGEF\u00dcHL ZU ERZEUGEN",
        "\uc5bc\uc74c\uac19\uc740 \ub290\ub08c\uc744 \uc704\ud574 \ub9c8\ucc30\uc744 0\uc73c\ub85c \uc124\uc815\ud558\uc138\uc694.",
        "IMPOSTA ATTRITO A ZERO PER UN EFFETTO GHIACCIO",
        "\u0423\u0421\u0422\u0410\u041d\u041e\u0412\u0418\u0422\u0415 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u0415 \u0422\u0420\u0415\u041d\u0418\u042f \u0412 \u041d\u041e\u041b\u042c,  \u0427\u0422\u041e\u0411\u042b \u0414\u041e\u0411\u0418\u0422\u042c\u0421\u042f \u042d\u0424\u0424\u0415\u041a\u0422\u0410 \u041b\u042c\u0414\u0410",
        "NASTAV T\u0158EN\u00cd NA NULU PRO DOJEM KLOUZ\u00c1N\u00cd PO LEDU",
        "ASETA KITKA NOLLAAN JA SAAT J\u00c4ISEN TUNTUMAN",
        "DEFINA O ATRITO PARA ZERO PARA FORNECER UMA SENSA\u00c7\u00c3O DE GELO",
        "ESTABLECER FRICCI\u00d3N A CERO PARA SENSACI\u00d3N DE HIELO"
    ],
    "EDITOR_HINT_6": [
        "IF JOINTED OBJECTS BEHAVE WEIRDLY, TRY TO INCREASE THE MASS OF THE JOINTED OBJECTS",
        "\u5982\u679c\u8fde\u63a5\u7684\u7269\u4f53\u8868\u73b0\u602a\u5f02\uff0c\u5c1d\u8bd5\u589e\u52a0\u8fde\u63a5\u7269\u4f53\u7684\u8d28\u91cf",
        "\u30b8\u30e7\u30a4\u30f3\u30c8\u5316\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u6319\u52d5\u304c\u304a\u304b\u3057\u3044\u3068\u304d\u306f\u3001\u30b8\u30e7\u30a4\u30f3\u30c8\u5316\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u8cea\u91cf\u3092\u5897\u3084\u3057\u3066\u307f\u307e\u3057\u3087\u3046",
        "SI LES OBJETS ASSOCI\u00c9S SE COMPORTENT BIZARREMENT, ESSAYEZ D'AUGMENTER LA MASSE DES OBJETS ASSOCI\u00c9S",
        "WENN SICH VERBUNDENE OBJEKTE MERKW\u00dcRDIG VERHALTEN, SOLLTEST DU VERSUCHEN, DIE MASSE DIESER OBJEKTE ZU ERH\u00d6HEN",
        "\uc5f0\uacb0\ub41c \uac1c\uccb4\uac00 \uc774\uc0c1\ud558\uac8c \ud589\ub3d9\ud558\uba74 \uc5f0\uacb0\ub41c \uac1c\uccb4\uc758 \uc591\uc744 \ub298\ub824\ubcf4\uc138\uc694.",
        "SE GLI OGGETTI CONGIUNTI SI COMPORTANO STRANAMENTE, PROVA AD AUMENTARNE LA MASSA",
        "\u0415\u0421\u041b\u0418 \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u041d\u042b\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b \u0412\u0415\u0414\u0423\u0422 \u0421\u0415\u0411\u042f \u0421\u0422\u0420\u0410\u041d\u041d\u041e, \u041f\u041e\u041f\u0420\u041e\u0411\u0423\u0419\u0422\u0415 \u0423\u0412\u0415\u041b\u0418\u0427\u0418\u0422\u042c \u041c\u0410\u0421\u0421\u0423 \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u041d\u042b\u0425 \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412",
        "POKUD SE SPOJEN\u00c9 OBJEKTY CHOVAJ\u00cd DIVN\u011a, ZKUS ZV\u00dd\u0160IT HMOTNOST SPOJEN\u00ddCH OBJEKT\u016e",
        "JOS LIITETYT OBJEKTIT K\u00c4YTT\u00c4YTYV\u00c4T OUDOSTI, KOKEILE LIS\u00c4T\u00c4 LIITETTYJEN OBJEKTIEN MASSAA",
        "SE OBJETOS CONECTADOS SE COMPORTAREM DE FORMA ESTRANHA, TENTE AUMENTAR A MASSA DOS OBJETOS CONECTADOS",
        "SI LOS OBJETOS UNIDOS SE COMPORTAN DE FORMA EXTRA\u00d1A, INTENTA AUMENTAR LA MASA DE LOS OBJETOS UNIDOS"
    ],
    "EDITOR_HINT_7": [
        "USE JOINTS TO MOVE PHYSICAL OBJECTS",
        "\u7528\u63a5\u5934\u79fb\u52a8\u5b9e\u4f53\u7269\u4f53",
        "\u7269\u7406\u7684\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u52d5\u304b\u3059\u306b\u306f\u30b8\u30e7\u30a4\u30f3\u30c8\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046",
        "UTILISER DES ASSOCIATIONS POUR D\u00c9PLACER DES OBJETS PHYSIQUES",
        "BENUTZE VERBINDUNGEN, UM PHYSISCHE OBJEKTE ZU BEWEGEN",
        "\uc5f0\uacb0\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubb3c\ub9ac \uac1c\uccb4\uc744 \uc774\ub3d9\ud558\uc138\uc694.",
        "USA LE GIUNTURE PER MUOVERE OGGETTI FISICI",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u0418\u042f, \u0427\u0422\u041e\u0411\u042b \u041f\u0415\u0420\u0415\u0414\u0412\u0418\u0413\u0410\u0422\u042c \u0424\u0418\u0417\u0418\u0427\u0415\u0421\u041a\u0418\u0415 \u041e\u0411\u042a\u0415\u041a\u0422\u042b",
        "POU\u017dIJ SPOJE K P\u0158EM\u00cdST\u011aN\u00cd FYZICK\u00ddCH OBJEKT\u016e",
        "K\u00c4YT\u00c4 LIIT\u00c4NT\u00d6J\u00c4 SIIRT\u00c4\u00c4KSESI FYYSISI\u00c4 OBJEKTEJA",
        "USE CONEX\u00d5ES PARA MOVER OBJETOS F\u00cdSICOS",
        "USA JUNTAS PARA MOVER LOS OBJETOS F\u00cdSICOS"
    ],
    "EDITOR_HINT_8": [
        "USE LOOK AT VALUE WITH EMITTERS TO CREATE YOUR OWN CUSTOM TURRETS",
        "\u4f7f\u7528\u67e5\u770b\u503c\u548c\u53d1\u5c04\u5668\u81ea\u5236\u70ae\u5854",
        "\u5024\u300c\u898b\u308b\u300d\u3092\u30a8\u30df\u30c3\u30bf\u3068\u4f7f\u3046\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u3060\u3051\u306e\u30ab\u30b9\u30bf\u30e0\u30bf\u30ec\u30c3\u30c8\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059",
        "UTILISER LA VALEUR 'LOOK AT' AVEC LES \u00c9METTEURS POUR CR\u00c9ER VOS PROPRES TOURELLES PERSONNALIS\u00c9ES",
        "NUTZE LOOK AT-WERT MIT SENDERN, UM DEINEN EIGENEN, BENUTZERDEFINIERTEN TURM ZU KREIEREN",
        "\ud45c\uc2dc\uae30\ub85c \uac12\uc744 \ubcf4\uace0 \ub098\ub9cc\uc758 \ucee4\uc2a4\ud140 \ud130\ub81b\uc744 \ub9cc\ub4dc\uc138\uc694.",
        "USA VALORE DI \"GUARDA\" CON GLI EMISSORI PER CREARE TORRETTE PERSONALIZZATE",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u0415 \"\u0421\u041c\u041e\u0422\u0420\u0415\u0422\u042c \u041d\u0410\" \u0421 \u0413\u0415\u041d\u0415\u0420\u0410\u0422\u041e\u0420\u0410\u041c\u0418, \u0427\u0422\u041e\u0411\u042b \u0421\u041e\u0417\u0414\u0410\u0412\u0410\u0422\u042c \u0421\u041e\u0411\u0421\u0422\u0412\u0415\u041d\u041d\u042b\u0415 \u0421\u0422\u0420\u0415\u041b\u041a\u041e\u0412\u042b\u0415 \u0411\u0410\u0428\u041d\u0418",
        "POU\u017dIJ HODNOTU PRO SLEDOV\u00c1N\u00cd SPOLU S VYS\u00cdLA\u010cI K VYTVO\u0158EN\u00cd VLASTN\u00cdCH V\u011a\u017d\u00cd",
        "K\u00c4YT\u00c4 \"KATSO\"-ARVOA L\u00c4HETT\u00c4VIEN OBJEKTIEN KANSSA LUODAKSESI KUSTOMOITUJA TYKKITORNEJA",
        "USE O VALOR DE OBSERVA\u00c7\u00c3O COM EMISSORES PARA CRIAR SUAS TORRES PERSONALIZADAS",
        "USA LOOK AT VALUE CON EMISORES PARA CREAR TUS PROPIAS TORRETAS PERSONALIZADAS"
    ],
    "EDITOR_HINT_9": [
        "CREATE SEQUENTIAL MOVEMENTS OR EFFECTS WITH VALUE DELAY",
        "\u4ee5\u503c\u5ef6\u8fdf\u521b\u9020\u8fde\u7eed\u8fd0\u52a8\u6216\u6548\u679c",
        "\u6570\u5024\u9045\u5ef6\u3092\u4f7f\u3046\u3053\u3068\u3067\u4e00\u9023\u306e\u9806\u5e8f\u3067\u5b9f\u884c\u3055\u308c\u308b\u52d5\u4f5c\u3084\u52b9\u679c\u3092\u4f5c\u308a\u51fa\u3057\u307e\u3057\u3087\u3046",
        "CR\u00c9ER DES MOUVEMENTS OU DES EFFETS S\u00c9QUENTIELS AVEC LA VALEUR DE RETARDEMENT",
        "ERSTELLE AUFEINANDERFOLGENDE BEWEGUNGEN ODER EFFEKTE MIT VERZ\u00d6GERTEN WERTEN",
        "\uac12 \uc9c0\uc5f0\uc73c\ub85c \uc5f0\uc18d \uc774\ub3d9 \ub610\ub294 \ud6a8\uacfc\ub97c \ub9cc\ub4dc\uc138\uc694.",
        "CREA MOVIMENTI O EFFETTI SEQUENZIALI CON RITARDO DI VALORE",
        "\u0421\u041e\u0417\u0414\u0410\u0422\u042c \u041f\u041e\u0421\u041b\u0415\u0414\u041e\u0412\u0410\u0422\u0415\u041b\u042c\u041d\u042b\u0415 \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u042f \u0418\u041b\u0418 \u042d\u0424\u0424\u0415\u041a\u0422\u042b \u0421 \u0417\u0410\u0414\u0415\u0420\u0416\u041a\u041e\u0419 \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u042f",
        "VYTVO\u0158 POSTUPN\u00c9 POHYBY NEBO EFEKTY POMOC\u00cd ZPO\u017dD\u011aN\u00cd",
        "LUO JAKSOTTAISTA LIIKETT\u00c4 TAI EFEKTEJ\u00c4 K\u00c4YTT\u00c4M\u00c4LL\u00c4 VIIVE-ARVOA",
        "CRIE MOVIMENTOS OU EFEITOS SEQUENCIAIS COM VALOR DE RETARDO",
        "CREA MOVIMIENTOS SECUENCIALES O EFECTOS CON VALOR DE DEMORA"
    ],
    "EDITOR_HINT_10": [
        "OPEN AND EXAMINE OFFICIAL LEVELS IN THE EDITOR TO LEARN NEW TRICKS",
        "\u5728\u7f16\u8f91\u5668\u4e2d\u6253\u5f00\u548c\u68c0\u67e5\u5b98\u65b9\u5173\u5361\u6765\u4e86\u89e3\u66f4\u591a\u6280\u5de7",
        "\u30a8\u30c7\u30a3\u30bf\u5185\u3067\u516c\u5f0f\u30ec\u30d9\u30eb\u3092\u958b\u3044\u3066\u773a\u3081\u3066\u3001\u65b0\u3057\u3044\u30b3\u30c4\u3092\u5b66\u3073\u53d6\u308a\u307e\u3057\u3087\u3046",
        "OUVRIR ET CONSULTER LES NIVEAUX OFFICIELS DANS L'\u00c9DITEUR POUR APPRENDRE DE NOUVELLES ASTUCES",
        "\u00d6FFNE OFFIZIELLE LEVEL IM EDITOR UND SIEH SIE DIR GENAU AN, UM NEUE TRICKS ZU LERNEN",
        "\ud3b8\uc9d1\uae30\uc5d0\uc11c \uacf5\uc2dd \ub808\ubca8\uc744 \uc5f4\uace0 \uc2dc\ud5d8\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ud2b8\ub9ad \ubc30\uc6b0\uae30",
        "APRI ED ESAMINA I LIVELLI UFFICIALI NELL'EDITOR PER IMPARARE NUOVI TRUCCHI",
        "\u041e\u0422\u041a\u0420\u042b\u0422\u042c \u0412 \u0420\u0415\u0414\u0410\u041a\u0422\u041e\u0420\u0415 \u0418 \u0418\u0421\u0421\u041b\u0415\u0414\u041e\u0412\u0410\u0422\u042c \u041e\u0424\u0418\u0426\u0418\u0410\u041b\u042c\u041d\u042b\u0415 \u0423\u0420\u041e\u0412\u041d\u0418, \u0427\u0422\u041e\u0411\u042b \u041d\u0410\u0423\u0427\u0418\u0422\u042c\u0421\u042f \u041d\u041e\u0412\u042b\u041c \u0412\u0415\u0429\u0410\u041c",
        "OTEV\u0158I A PROZKOUMEJ OFICI\u00c1LN\u00cd \u00daROVN\u011a V EDITORU, ABY SES NAU\u010cIL NOV\u00c9 TRIKY",
        "AVAA JA TUTKI VIRALLISIA TASOJA EDITORIN AVULLA, NIIN VOIT SAADA UUSIA IDEOITA",
        "ABRA E EXAMINE N\u00cdVEIS OFICIAIS NO EDITOR PARA APRENDER NOVOS TRUQUES",
        "ABRE Y EXAMINA LOS NIVELES OFICIALES EN EL EDITOR PARA APRENDER NUEVOS TRUCOS"
    ],
    "EDITOR_HINT_11": [
        "CREATE AN AWESOME LEVEL AND HAVE A CHANCE TO BE PART OF THE ETERNAL DAY",
        "\u521b\u9020\u7cbe\u5f69\u7edd\u4f26\u7684\u5173\u5361\uff0c\u6709\u673a\u4f1a\u6210\u4e3a\u6c38\u6052\u65e5\u7684\u4e00\u90e8\u5206",
        "\u3059\u3054\u3044\u30ec\u30d9\u30eb\u3092\u4f5c\u6210\u3059\u308c\u3070\u3001\u300c\u6c38\u9060\u306e\u65e5\u300d\u306b\u53c2\u52a0\u3067\u304d\u308b\u30c1\u30e3\u30f3\u30b9",
        "CR\u00c9EZ UN NIVEAU G\u00c9NIAL ET POUR ESSAYER DE FAIRE PARTIE DU JOUR \u00c9TERNEL",
        "ERSTELLE EIN UNGLAUBLICHES LEVEL UND NUTZE DIE CHANCE, TEIL DES EWIGEN TAGS ZU WERDEN",
        "\uba4b\uc9c4 \ub808\ubca8\uc744 \ub9cc\ub4e4\uace0 \uc601\uc6d0\uc758 \ub0a0\uc758 \uc77c\uc6d0\uc774 \ub420 \uae30\ud68c\ub97c \uac00\uc9c0\uc138\uc694.",
        "CREA UN FAVOLOSO LIVELLO E OTTIENI UNA CHANCE DI PARTECIPARE AL GIORNO ETERNO",
        "\u0421\u041e\u0417\u0414\u0410\u0419\u0422\u0415 \u0417\u0410\u041c\u0415\u0427\u0410\u0422\u0415\u041b\u042c\u041d\u042b\u0419 \u0423\u0420\u041e\u0412\u0415\u041d\u042c \u0418 \u041f\u041e\u041b\u0423\u0427\u0418\u0422\u0415 \u0428\u0410\u041d\u0421 \u0421\u0422\u0410\u0422\u042c \u0427\u0410\u0421\u0422\u042c\u042e \u0412\u0415\u0427\u041d\u041e\u0413\u041e \u0414\u041d\u042f",
        "VYTVO\u0158 \u00da\u017dASNOU \u00daROVE\u0147 A Z\u00cdSKEJ TAK \u0160ANCI ST\u00c1T SE SOU\u010c\u00c1ST\u00cd V\u011a\u010cN\u00c9HO DNE",
        "LUO MAHTAVA KENTT\u00c4, JA IKUINEN P\u00c4IV\u00c4 VOI OLLA SINUNKIN PAIKKASI",
        "CRIE UM N\u00cdVEL ESPETACULAR E TENHA A CHANCE DE FAZER PARTE DO DIA ETERNO",
        "CREA UN NIVEL INCRE\u00cdBLE PARA TENER LA OPORTUNIDAD DE FORMAR PARTE DEL D\u00cdA ETERNO"
    ],
    "EDITOR_HINT_12": [
        "FILLERS DO NOT HAVE ANY COLLISIONS. USE THEM TO FILL NON-REACHABLE PARTS OF YOUR LEVEL",
        "\u586b\u5145\u5668\u6ca1\u6709\u4efb\u4f55\u78b0\u649e\u3002\u7528\u5b83\u4eec\u586b\u5145\u5173\u5361\u4e2d\u65e0\u6cd5\u5230\u8fbe\u7684\u90e8\u5206",
        "\u30d5\u30a3\u30e9\u30fc\u306b\u306f\u885d\u7a81\u5224\u5b9a\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u30ec\u30d9\u30eb\u306e\u5230\u9054\u4e0d\u53ef\u80fd\u306a\u30a8\u30ea\u30a2\u306b\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046",
        "LES REMPLISSEURS N'ONT PAS DE COLLISIONS. UTILISEZ-LES POUR REMPLIR LES PARTIES NON ATTEIGNABLES DE VOTRE NIVEAU",
        "BEI F\u00dcLLERN GIBT ES KEINE ZUSAMMENST\u00d6SSE. NUTZE SIE, UM UNERREICHBARE TEILE DEINES LEVELS ZU F\u00dcLLEN",
        "\ud544\ub7ec\uc5d0\ub294 \ucda9\ub3cc\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \ub808\ubca8\uc5d0\uc11c \ub2ff\uc744 \uc218 \uc5c6\ub294 \ubd80\ubd84\uc744 \ucc44\uc6b8 \ub54c \uc0ac\uc6a9\ud558\uc138\uc694.",
        "I RIEMPITIVI NON SUBISCONO COLLISIONI. USALI PER RIEMPIRE LE PARTI NON RAGGIUNGIBILI DEL TUO LIVELLO",
        "\u041d\u0410\u041f\u041e\u041b\u041d\u0418\u0422\u0415\u041b\u0418 \u041d\u0415 \u041c\u041e\u0413\u0423\u0422 \u0418\u041c\u0415\u0422\u042c \u0417\u041d\u0410\u0427\u0415\u041d\u0418\u0419 \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f. \u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0418\u0425 \u0414\u041b\u042f \u0417\u0410\u041f\u041e\u041b\u041d\u0415\u041d\u0418\u042f \u041f\u0423\u0421\u0422\u042b\u0425 \u041d\u0415\u0414\u041e\u0421\u0422\u0423\u041f\u041d\u042b\u0425 \u041f\u0420\u041e\u0421\u0422\u0420\u0410\u041d\u0421\u0422\u0412 \u041d\u0410 \u0412\u0410\u0428\u0415\u041c \u0423\u0420\u041e\u0412\u041d\u0415",
        "V\u00ddPLN\u011a NEMAJ\u00cd \u017d\u00c1DN\u00c9 KOLIZE. POU\u017dIJ JE K VYPLN\u011aN\u00cd NEDOSTUPN\u00ddCH \u010c\u00c1ST\u00cd TV\u00c9 \u00daROVN\u011a",
        "T\u00c4YTEOBJEKTEIHIN EI VOI T\u00d6RM\u00c4T\u00c4. K\u00c4YT\u00c4 NIIT\u00c4 T\u00c4YTT\u00c4M\u00c4\u00c4N P\u00c4\u00c4SYKELVOTTOMAT PAIKAT KENT\u00c4SS\u00c4",
        "OS OBJETOS DE PREENCHIMENTO N\u00c3O POSSUEM COLIS\u00d5ES. USE-OS PARA PREENCHER PARTES INACESS\u00cdVEIS DO SEU N\u00cdVEL",
        "LOS OBJETOS DE RELLENO NO COLISIONAN. \u00daSALOS PARA RELLENAR LAS PARTES NO ALCANZABLES DE TU NIVEL"
    ],
    "EDITOR_HINT_13": [
        "SET BOUNCINESS TO ZERO AND INCREASE MASS TO MAKE OBJECTS FEEL MORE HEAVY",
        "\u5c06\u5f39\u6027\u8bbe\u4e3a\u96f6\u5e76\u589e\u52a0\u8d28\u91cf\uff0c\u8ba9\u7269\u4f53\u611f\u89c9\u66f4\u91cd",
        "\u8df3\u306d\u3084\u3059\u3055\u3092\u30bc\u30ed\u306b\u8a2d\u5b9a\u3057\u3066\u8cea\u91cf\u3092\u5897\u3084\u305b\u3070\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u3082\u3063\u3068\u91cd\u305f\u305d\u3046\u306b\u3067\u304d\u307e\u3059",
        "D\u00c9FINIR LE REBOND SUR Z\u00c9RO ET AUGMENTER LA MASSE POUR QUE LES OBJETS SEMBLENT PLUS LOURDS",
        "LEGE DIE ABPRALLST\u00c4RKE AUF NULL FEST UND ERH\u00d6HE DIE MASSE, DAMIT OBJEKTE SICH SCHWERER ANF\u00dcHLEN",
        "\ud295\uae40\uc744 0\uc73c\ub85c \uc124\uc815\ud558\uace0 \uc591\uc744 \uc99d\uac00\uc2dc\ucf1c\uc11c \uac1c\uccb4\ub97c \ub354 \ubb34\uac81\uc138 \ub9cc\ub4dc\uc138\uc694.",
        "IMPOSTA RIMBALZO A ZERO E AUMENTA LA MASSA PER RENDERE PI\u00d9 PESANTI GLI OGGETTI",
        "\u0423\u0421\u0422\u0410\u041d\u041e\u0412\u0418\u0422\u0415 \u041f\u0410\u0420\u0410\u041c\u0415\u0422\u0420 \u0421\u041a\u041e\u041b\u042c\u0417\u041a\u041e\u0421\u0422\u0418 \u0412 \u041d\u041e\u041b\u042c \u0418 \u0423\u0412\u0415\u041b\u0418\u0427\u042c\u0422\u0415 \u041c\u0410\u0421\u0421\u0423, \u0427\u0422\u041e\u0411\u042b \u041e\u0411\u042a\u0415\u041a\u0422\u042b \u0421\u0422\u0410\u041b\u0418 \u0422\u042f\u0416\u0415\u041b\u0415\u0415",
        "NASTAV ODR\u00c1\u017dEN\u00cd NA NULU A ZVY\u0160 HMOTNOST, ABY OBJEKT P\u016eSOBIL JAKO T\u011a\u017d\u0160\u00cd",
        "ASETA KIMMOISUUS NOLLAAN JA LIS\u00c4\u00c4 MASSAA, JOTTA OBJEKTIT TUNTUISIVAT PAINAVAMMILTA",
        "DEFINA O RICOCHETE PARA ZERO E AUMENTE A MASSA PARA TORNAR OS OBJETOS MAIS PESADOS",
        "ESTABLECE EL REBOTE A CERO Y AUMENTA LA MASA PARA QUE LOS OBJETOS  PAREZCAN M\u00c1S PESADOS"
    ],
    "EDITOR_HINT_14": [
        "DESTROYABLE OBJECTS ARE DESTROYED BY DEADLY OBJECTS",
        "\u53ef\u6467\u6bc1\u7684\u7269\u4f53\u88ab\u81f4\u547d\u7269\u4f53\u6467\u6bc1",
        "\u7834\u58ca\u53ef\u80fd\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u300c\u81f4\u6b7b\u6027\u300d\u306e\u3042\u308b\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3067\u7834\u58ca\u3067\u304d\u307e\u3059",
        "LES OBJETS DESTRUCTIBLES SONT D\u00c9TRUITS PAR LES OBJETS MORTELS",
        "ZERST\u00d6REBARE OBJEKTE WERDEN VON T\u00d6DLICHEN OBJEKTEN ZERST\u00d6RT",
        "\ud30c\uad34 \uac00\ub2a5 \uac1c\uccb4\ub294 \uadf9\ub3c4\uc758 \uac1c\uccb4\ub85c \ud30c\uad34\ub429\ub2c8\ub2e4.",
        "GLI OGGETTI DISTRUTTIBILI VENGONO DISTRUTTI DAGLI OGGETTI MORTALI",
        "\u041e\u0411\u042a\u0415\u041a\u0422\u042b, \u041a\u041e\u0422\u041e\u0420\u042b\u0415 \u041c\u041e\u0413\u0423\u0422 \u0411\u042b\u0422\u042c \u0420\u0410\u0417\u0420\u0423\u0428\u0415\u041d\u042b, \u0420\u0410\u0417\u0420\u0423\u0428\u0410\u042e\u0422\u0421\u042f \u041e\u0422 \u0412\u041e\u0417\u0414\u0415\u0419\u0421\u0422\u0412\u0418\u042f \u0421\u041c\u0415\u0420\u0422\u041e\u041d\u041e\u0421\u041d\u042b\u0425 \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412",
        "ZNI\u010cITELN\u00c9 OBJEKTY JSOU ZNI\u010cENY SMRT\u00cdC\u00cdMI OBJEKTY",
        "TAPPAVAT OBJEKTIT TUHOAVAT OBJEKTIT, JOTKA VOIVAT TUHOUTUA",
        "OS OBJETOS DESTRUT\u00cdVEIS S\u00c3O DESTRU\u00cdDOS POR OBJETOS MORT\u00cdFEROS",
        "LOS OBJETOS MORTALES DESTRUYEN LOS OBJETOS DESTRUIBLES"
    ],
    "EDITOR_HINT_15": [
        "SIMPLE COLLISION CHANGES THE OBJECT'S COLLISION TO A ROUND SHAPE",
        "\u7b80\u5355\u7684\u78b0\u649e\u5c06\u7269\u4f53\u53d8\u6210\u5706\u5f62",
        "\u30b7\u30f3\u30d7\u30eb\u885d\u7a81\u5224\u5b9a\u306f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u885d\u7a81\u5224\u5b9a\u3092\u5186\u5f62\u306b\u8a2d\u5b9a\u3057\u307e\u3059",
        "LA COLLISION SIMPLE MODIFIE LA COLLISION DES OBJETS EN UNE FORME ARRONDIE",
        "EIN EINFACHER ZUSAMMENSTOSS \u00c4NDERT DIE KOLLISION EINES OBJEKTS IN EINE RUNDE FORM",
        "\ub2e8\uc21c\ud55c \ucda9\ub3cc\uc740 \uac1c\uccb4\uc758 \ucda9\ub3cc\uc740 \ub465\uadfc \ubaa8\uc591\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4.",
        "LA COLLISIONE SEMPLICE D\u00c0 UNA FORMA ROTONDA ALLA COLLISIONE DELL'OGGETTO",
        "\u041f\u0420\u041e\u0421\u0422\u042b\u0415 \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f \u041c\u0415\u041d\u042f\u042e\u0422 \u041c\u041e\u0414\u0415\u041b\u042c \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f \u041e\u0411\u042a\u0415\u041a\u0422\u0410 \u041d\u0410 \u041a\u0420\u0423\u0413\u041b\u0423\u042e \u0424\u041e\u0420\u041c\u0423",
        "JEDNODUCH\u00c1 KOLIZE ZM\u011aN\u00cd KOLIZI OBJEKTU NA KRUHOV\u00dd TVAR",
        "YKSINKERTAINEN T\u00d6RM\u00c4YS MUUTTAA OBJEKTIN T\u00d6RM\u00c4YSALUEEN YMPYR\u00c4N MUOTOISEKSI",
        "A COLIS\u00c3O SIMPLES ALTERA A COLIS\u00c3O DO OBJETO PARA UMA FORMA ARREDONDADA",
        "UNA COLISI\u00d3N SIMPLE CAMBIA LA COLISI\u00d3N DE UN OBJETO A FORMA DE C\u00cdRCULO"
    ],
    "EDITOR_HINT_16": [
        "ADD SMALL DYNAMIC BRANCHES AND FALLING ROCKS OVER THE LEVEL TO MAKE IT FEEL MORE ALIVE",
        "\u5728\u5173\u5361\u4e0a\u6dfb\u52a0\u5c0f\u52a8\u6001\u6811\u679d\u548c\u843d\u77f3\uff0c\u8ba9\u5b83\u66f4\u6709\u751f\u6c14",
        "\u30ec\u30d9\u30eb\u5185\u306b\u5c0f\u3055\u3044\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u679d\u3084\u843d\u3061\u3066\u3044\u304f\u5ca9\u3092\u52a0\u3048\u308b\u3053\u3068\u3067\u3001\u30ec\u30d9\u30eb\u3092\u3088\u308a\u300c\u751f\u304d\u3066\u3044\u308b\u300d\u3088\u3046\u306b\u898b\u305b\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059",
        "AJOUTER DE PETITES BRANCHES ET PIERRES TOMBANTES DYNAMIQUES SUR LE NIVEAU POUR QU'IL SOIT PLUS VIVANT",
        "F\u00dcGE KLEINE DYNAMISCHE \u00c4STE UND HERUNTERFALLENDE STEINE \u00dcBER DEM LEVEL HINZU, UM IHN LEBENDIGER ZU GESTALTEN",
        "\uc791\uc740 \ub3d9\uc801 \uac00\uc9c0\uc640 \ub5a8\uc5b4\uc9c0\ub294 \ubc14\uc704\ub97c \ub808\ubca8\uc5d0 \ucd94\uac00\ud558\uc5ec \uc0dd\uc874\uc758 \ub290\ub08c\uc744 \ub354 \uc8fc\uc138\uc694.",
        "AGGIUNGI PICCOLI RAMI DINAMICI E ROCCE CADENTI: IL LIVELLO SEMBRER\u00c0 PI\u00d9 VIVO",
        "\u0414\u041e\u0411\u0410\u0412\u042c\u0422\u0415 \u0414\u0418\u041d\u0410\u041c\u0418\u0427\u0415\u0421\u041a\u0418\u0415 \u0412\u0415\u0422\u0412\u0418 \u0418 \u041f\u0410\u0414\u0410\u042e\u0429\u0418\u0415 \u041e\u0411\u041b\u041e\u041c\u041a\u0418 \u0421\u041a\u0410\u041b \u041a \u0412\u0410\u0428\u0415\u041c\u0423 \u0423\u0420\u041e\u0412\u041d\u042e, \u0427\u0422\u041e\u0411\u042b \u0421\u0414\u0415\u041b\u0410\u0422\u042c \u0415\u0413\u041e \u0411\u041e\u041b\u0415\u0415 \u041e\u0416\u0418\u0412\u041b\u0415\u041d\u041d\u042b\u041c",
        "P\u0158ID\u00c1 DO \u00daROVN\u011a MAL\u00c9 DYNAMICK\u00c9 V\u011aTVE A PADAJ\u00cdC\u00cd KAMEN\u00cd, ABY P\u016eSOBILA \u017dIV\u011aJ\u0160\u00cdM DOJMEM",
        "LIS\u00c4\u00c4 PIENI\u00c4 LIIKKUVIA OKSIA JA PUTOAVIA KIVI\u00c4 KENTT\u00c4\u00c4N, NIIN SAAT SEN EL\u00c4V\u00c4MM\u00c4N TUNTUISEKSI",
        "ADICIONE PEQUENOS GALHOS DIN\u00c2MICOS E PEDRAS QUE CAEM AO LONGO DO N\u00cdVEL PARA QUE ELE FIQUE MAIS ATIVO",
        "A\u00d1ADE PEQUE\u00d1AS RAMAS DIN\u00c1MICAS Y CA\u00cdDAS DE ROCAS EN EL NIVEL PARA DARLE VIDA"
    ],
    "EDITOR_HINT_17": [
        "YOUR LEVEL IS ALWAYS SAVED BY AUTO-SAVE",
        "\u5173\u5361\u603b\u662f\u4f1a\u81ea\u52a8\u4fdd\u5b58",
        "\u3042\u306a\u305f\u306e\u30ec\u30d9\u30eb\u306f\u5e38\u6642\u30aa\u30fc\u30c8\u30bb\u30fc\u30d6\u306b\u3088\u3063\u3066\u4fdd\u5b58\u3055\u308c\u307e\u3059",
        "VOTRE NIVEAU EST TOUJOURS ENREGISTR\u00c9 PAR ENREGISTREMENT AUTOMATIQUE",
        "DEIN LEVEL WIRD IMMER DURCH AUTOSAVE GESPEICHERT",
        "\ub808\ubca8\uc740 \ud56d\uc0c1 \uc790\ub3d9 \uc800\uc7a5\ub429\ub2c8\ub2e4.",
        "IL TUO LIVELLO VIENE SEMPRE SALVATO AUTOMATICAMENTE",
        "\u0412\u0410\u0428 \u0423\u0420\u041e\u0412\u0415\u041d\u042c \u0412\u0421\u0415\u0413\u0414\u0410 \u0421\u041e\u0425\u0420\u0410\u041d\u042f\u0415\u0422\u0421\u042f \u0410\u0412\u0422\u041e\u041c\u0410\u0422\u0418\u0427\u0415\u0421\u041a\u0418",
        "TVOJE \u00daROVE\u0147 JE NEUST\u00c1LE UKL\u00c1D\u00c1NA AUTOMATICK\u00ddM UKL\u00c1D\u00c1N\u00cdM",
        "AUTOMAATTINEN TALLENNUS TALLENTAA AINA KENTT\u00c4SI",
        "O SEU N\u00cdVEL \u00c9 SEMPRE SALVO AUTOMATICAMENTE",
        "TU NIVEL SIEMPRE SE GUARDA CON EL GUARDADO AUTOM\u00c1TICO"
    ],
    "EDITOR_HINT_18": [
        "CREATING A RESTORE POINT IS NOT NECESSARY TO SAVE YOUR LEVEL",
        "\u65e0\u9700\u4e3a\u4fdd\u5b58\u5173\u5361\u800c\u521b\u5efa\u8fd8\u539f\u70b9",
        "\u30ec\u30d9\u30eb\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u5fa9\u5143\u30dd\u30a4\u30f3\u30c8\u306e\u4f5c\u6210\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093",
        "LA CR\u00c9ATION D'UN POINT DE RESTAURATION N'EST PAS N\u00c9CESSAIRE POUR ENREGISTRER VOTRE NIVEAU",
        "ES IST NICHT ERFORDERLICH, EINEN WIEDERHERSTELLUNGSPUNKT ZU ERSTELLEN, UM DEINEN LEVEL ZU SPEICHERN",
        "\ubcf5\uc6d0 \uc9c0\uc810 \ub9cc\ub4e4\uae30\ub294 \ub808\ubca8 \uc800\uc7a5\uc5d0 \ud544\uc218\uc801\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
        "PER SALVARE IL LIVELLO NON \u00c8 NECESSARIO CREARE UN PUNTO DI RIPRISTINO",
        "\u0414\u041b\u042f \u0422\u041e\u0413\u041e, \u0427\u0422\u041e\u0411\u042b \u0421\u041e\u0425\u0420\u0410\u041d\u0418\u0422\u042c \u0423\u0420\u041e\u0412\u0415\u041d\u042c, \u041d\u0415\u041e\u0411\u042f\u0417\u0410\u0422\u0415\u041b\u042c\u041d\u041e \u0421\u041e\u0417\u0414\u0410\u0412\u0410\u0422\u042c \u0422\u041e\u0427\u041a\u0423 \u0412\u041e\u0421\u0421\u0422\u0410\u041d\u041e\u0412\u041b\u0415\u041d\u0418\u042f",
        "VYTVO\u0158EN\u00cd BODU OBNOVY NEN\u00cd NUTN\u00c9 PRO ULO\u017dEN\u00cd TV\u00c9 \u00daROVN\u011a",
        "PALAUTUSPISTEEN LUONTI KENT\u00c4N TALLENTAMISEKSI EI OLE TARPEEN",
        "CRIAR UM PONTO DE RESTAURA\u00c7\u00c3O N\u00c3O \u00c9 NECESS\u00c1RIO PARA SALVAR O SEU N\u00cdVEL",
        "NO HACE FALTA CREAR UN PUNTO DE RESTAURACI\u00d3N PARA GUARDAR TU NIVEL"
    ],
    "EDITOR_HINT_19": [
        "USE \"IS SPECIAL\" PROPERTY TO BETTER MANAGE COLLISIONS BETWEEN OBJECTS",
        "\u4f7f\u7528\u201c\u7279\u522b\u201d\u5c5e\u6027\u66f4\u597d\u5730\u7ba1\u7406\u7269\u4f53\u95f4\u7684\u78b0\u649e",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u9593\u306e\u885d\u7a81\u5224\u5b9a\u3092\u5de7\u304f\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u300c\u7279\u6b8a\u300d\u30d7\u30ed\u30d1\u30c6\u30a3\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046",
        "UTILISEZ LA PROPRI\u00c9T\u00c9 'EST SP\u00c9CIAL' POUR MIEUX G\u00c9RER LES COLLISIONS ENTRE LES OBJETS",
        "NUTZE DIE EIGENSCHAFT \"IST SPEZIAL\", UM ZUSAMMENST\u00d6SSE ZWISCHEN OBJEKTEN BESSER VERWALTEN ZU K\u00d6NNEN",
        "\"\uc2a4\ud398\uc15c\" \uc18d\uc131\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac1c\uccb4 \uac04 \ucda9\ub3cc\uc744 \ub354 \uc798 \uad00\ub9ac\ud558\uc138\uc694.",
        "USA LA PROPRIET\u00c0 \"\u00c8 SPECIALE\" PER GESTIRE MEGLIO LE COLLISIONI TRA OGGETTI",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0421\u0412\u041e\u0419\u0421\u0422\u0412\u041e \"\u041e\u0421\u041e\u0411\u0415\u041d\u041d\u042b\u0419\", \u0427\u0422\u041e\u0411\u042b \u041b\u0423\u0427\u0428\u0415 \u0423\u041f\u0420\u0410\u0412\u041b\u042f\u0422\u042c \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f\u041c\u0418 \u041f\u0420\u0415\u0414\u041c\u0415\u0422\u041e\u0412",
        "POU\u017dIJ VLASTNOST \"JE SPECI\u00c1LN\u00cd\", ABYS MOHL L\u00c9PE \u0158\u00cdDIT KOLIZE MEZI OBJEKTY",
        "K\u00c4YT\u00c4 \"ERITYINEN\"-OMINAISUUTTA HALLITAKSESI OBJEKTIEN V\u00c4LIST\u00c4 T\u00d6RM\u00c4YST\u00c4 PAREMMIN",
        "USE A PROPRIEDADE \"\u00c9 ESPECIAL\" PARA GERENCIAR MELHOR AS COLIS\u00d5ES ENTRE OBJETOS",
        "USA LA PROPIEDAD \"ES ESPECIAL\" PARA GESTIONAR MEJOR LAS COLISIONES ENTRE OBJETOS"
    ],
    "EDITOR_HINT_20": [
        "USE \"HIT NOTHING\" PROPERTY FOR FULLY DECORATIVE OBJECTS TO FOR BETTER PERFORMANCE",
        "\u4f7f\u7528\u5b8c\u5168\u88c5\u9970\u6027\u7269\u4f53\u7684\u201c\u4ec0\u4e48\u90fd\u6ca1\u78b0\u5230\u201d\u5c5e\u6027\u5b9e\u73b0\u66f4\u4f73\u7684\u6027\u80fd",
        "\u5b8c\u5168\u306b\u88c5\u98fe\u7528\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306b\u7740\u3044\u3066\u306f\u3001\u300c\u4f55\u3082\u5f53\u305f\u3089\u306a\u3044\u300d\u30d7\u30ed\u30d1\u30c6\u30a3\u3092\u4f7f\u3046\u3053\u3068\u3067\u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u3092\u8efd\u304f\u51fa\u6765\u307e\u3059",
        "UTILISER LA PROPRI\u00c9T\u00c9 'NE RIEN TOUCHER' POUR LES OBJETS ENTI\u00c8REMENT D\u00c9CORATIFS AFIN D'OBTENIR DE MEILLEURES PERFORMANCES",
        "NUTZE DIE EIGENSCHAFT \"NICHTS TREFFEN\" F\u00dcR REIN DEKORATIVE OBJEKTE, UM DIE PERFORMANCE ZU VERBESSERN",
        "\"\uc544\ubb34\uac83\ub3c4 \uc548 \ub9de\uc74c\" \uc18d\uc131\uc744 \uc804\uccb4 \uc7a5\uc2dd \uac1c\uccb4\uc5d0 \uc0ac\uc6a9\ud558\uc5ec \uc131\ub2a5\uc744 \uc99d\uac00\uc2dc\ud0a4\uc138\uc694.",
        "USA LA PROPRIET\u00c0 \"NESSUNA COLLISIONE\" PER UNA MIGLIORE PRESTAZIONE DEGLI OGGETTI DECORATIVI",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0421\u0412\u041e\u0419\u0421\u0422\u0412\u041e \"\u041d\u0415 \u0421\u0422\u0410\u041b\u041a\u0418\u0412\u0410\u0422\u042c\u0421\u042f\" \u0414\u041b\u042f \u041f\u041e\u041b\u041d\u041e\u0421\u0422\u042c\u042e \u0414\u0415\u041a\u041e\u0420\u0410\u0422\u0418\u0412\u041d\u042b\u0425 \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412, \u0427\u0422\u041e\u0411\u042b \u0423\u041b\u0423\u0427\u0428\u0418\u0422\u042c \u041f\u0420\u041e\u0418\u0417\u0412\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c \u0418\u0413\u0420\u042b",
        "POU\u017dIJ VLASTNOST \"NIC NEZAS\u00c1HNI\" PRO ZCELA OZDOBN\u00c9 OBJEKTY A ZLEP\u0160EN\u00cd V\u00ddKONU",
        "K\u00c4YT\u00c4 \"EI OSUMAA\"-OMINAISUUTTA T\u00c4YSIN KORISTETARKOITUKSESSSA OLEVILLE OBJEKTEILLE, NIIN SUORITUSKYKY PARANEE",
        "USE A PROPRIEDADE \"ATINGIR NADA\" PARA OBJETOS TOTALMENTE DECORATIVOS PARA UM MELHOR DESEMPENHO",
        "USA LA PROPIEDAD \"NO CHOQUES CON NADA\" PARA OBJETOS TOTALMENTE DECORATIVOS Y UN MEJOR RENDIMIENTO"
    ],
    "EDITOR_HINT_21": [
        "DON'T BE AFRAID TO PUBLISH YOUR LEVEL - REPUBLISHING IS ALWAYS POSSIBLE",
        "\u4e0d\u8981\u6015\u53d1\u5e03\u81ea\u5df1\u7684\u5173\u5361 - \u60a8\u53ef\u4ee5\u968f\u65f6\u91cd\u65b0\u53d1\u5e03",
        "\u30ec\u30d9\u30eb\u306e\u516c\u958b\u306f\u6c17\u8efd\u306b\u884c\u3048\u307e\u3059\u3002\u307e\u305f\u518d\u516c\u958b\u3082\u3044\u3064\u3067\u3082\u3067\u304d\u307e\u3059\u306e\u3067\u3054\u5fc3\u914d\u306a\u304f",
        "N'H\u00c9SITEZ PAS \u00c0 PUBLIER VOTRE NIVEAU : VOUS POURREZ TOUJOURS LE PUBLIER DE NOUVEAU",
        "HAB KEINE ANGST DAVOR, DEINEN LEVEL ZU VER\u00d6FFENTLICHEN - EINE ERNEUTE VER\u00d6FFENTLICHUNG IST IMMER M\u00d6GLICH",
        "\ub808\ubca8 \uac8c\uc2dc\ub97c \ub450\ub824\uc6cc \ub9c8\uc138\uc694. \uc5b8\uc81c\ub4e0\uc9c0 \ub2e4\uc2dc \uac8c\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "NON AVER PAURA DI PUBBLICARE IL TUO LIVELLO: PUOI SEMPRE RIPUBBLICARLO!",
        "\u041d\u0415 \u0411\u041e\u0419\u0422\u0415\u0421\u042c \u041e\u041f\u0423\u0411\u041b\u0418\u041a\u041e\u0412\u0410\u0422\u042c \u0421\u0412\u041e\u0419 \u0423\u0420\u041e\u0412\u0415\u041d\u042c \u2014 \u0412\u042b \u0412\u0421\u0415\u0413\u0414\u0410 \u0421\u041c\u041e\u0416\u0415\u0422\u0415 \u041e\u0411\u041d\u041e\u0412\u0418\u0422\u042c \u0415\u0413\u041e \u0418 \u041e\u041f\u0423\u0411\u041b\u0418\u041a\u041e\u0412\u0410\u0422\u042c \u0417\u0410\u041d\u041e\u0412\u041e",
        "NEBOJ SE PUBLIKOVAT SV\u00c9 \u00daROVN\u011a - JE V\u017dDY MO\u017dN\u00c9 JE VYDAT ZNOVU",
        "\u00c4L\u00c4 ARASTELE KENTT\u00c4SI JULKAISEMISTA - VOIT AINA JULKAISTA SEN UUDELLEEN",
        "N\u00c3O TENHA RECEIO DE PUBLICAR O SEU N\u00cdVEL - \u00c9 SEMPRE POSS\u00cdVEL PUBLIC\u00c1-LO NOVAMENTE",
        "NO TENGAS MIEDO A PUBLICAR TU NIVEL - SIEMPRE PUEDES VOLVER A PUBLICARLO"
    ],
    "EDITOR_HINT_22": [
        "MAKE SURE THE PLAYER CAN GET ALL THE NECESSARY POWER-UPS REGARDLESS OF THE STARTING CHECKPOINT",
        "\u786e\u4fdd\u73a9\u5bb6\u53ef\u4ee5\u83b7\u5f97\u6240\u6709\u5fc5\u8981\u7684\u8f85\u52a9\u9053\u5177\uff0c\u4e0d\u8bba\u8d77\u59cb\u5b58\u6863\u70b9\u5728\u54ea\u91cc",
        "\u958b\u59cb\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306b\u95a2\u4fc2\u306a\u304f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5fc5\u8981\u3068\u3059\u308b\u3042\u3089\u3086\u308b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u5165\u624b\u3067\u304d\u308b\u3088\u3046\u306b\u7528\u610f\u3057\u3066\u304a\u304d\u307e\u3057\u3087\u3046",
        "V\u00c9RIFIER QUE LE JOUEUR PEUT OBTENIR TOUS LES BONUS N\u00c9CESSAIRES QUEL QUE SOIT LE POINT DE CONTR\u00d4LE DE D\u00c9MARRAGE",
        "STELL SICHER, DASS DER SPIELER ALLE ERFORDERLICHEN POWER-UPS BEKOMMT, UNGEACHTET DES STARTKONTROLLPUNKTS",
        "\ud50c\ub808\uc774\uc5b4\uac00 \uc2dc\uc791 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc5d0 \uad00\uacc4 \uc5c6\uc774 \ud544\uc694\ud55c \ud30c\uc6cc\uc5c5\uc744 \ubaa8\ub450 \ubc1b\uc744 \uc218 \uc788\uac8c \ub9cc\ub4dc\uc138\uc694.",
        "ASSICURATI CHE IL GIOCATORE POSSA OTTENERE TUTTI I POTENZIAMENTI NECESSARI, INDIPENDENTEMENTE DAL CHECKPOINT D'INIZIO",
        "\u0423\u0411\u0415\u0414\u0418\u0422\u0415\u0421\u042c, \u0427\u0422\u041e \u0418\u0413\u0420\u041e\u041a \u041c\u041e\u0416\u0415\u0422 \u041f\u041e\u041b\u0423\u0427\u0418\u0422\u042c \u0412\u0421\u0415 \u041d\u0415\u041e\u0411\u0425\u041e\u0414\u0418\u041c\u042b\u0415 \u0423\u0421\u0418\u041b\u0415\u041d\u0418\u042f \u041c\u041e\u0429\u041d\u041e\u0421\u0422\u0418 \u0412\u041d\u0415 \u0417\u0410\u0412\u0418\u0421\u0418\u041c\u041e\u0421\u0422\u0418 \u041e\u0422 \u041d\u0410\u0427\u0410\u041b\u042c\u041d\u041e\u0419 \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c\u041d\u041e\u0419 \u0422\u041e\u0427\u041a\u0418",
        "UJISTI SE, \u017dE HR\u00c1\u010c M\u016e\u017dE Z\u00cdSKAT V\u0160ECHNA POT\u0158EN\u00c1 POS\u00cdLEN\u00cd BEZ OHLEDU NA STARTOVAC\u00cd Z\u00c1CHYTN\u00dd BOD",
        "VARMISTA, ETT\u00c4 PELAAJA SAA KAIKKI TARVITSEMANSA LIS\u00c4VOIMAT  JATKOPISTEEST\u00c4 RIIPPUMATTA",
        "ASSEGURE QUE O JOGADOR POSSA OBTER TODOS OS POWERUPS NECESS\u00c1RIOS, INDEPENDENTEMENTE DO PONTO DE CONTROLE INICIAL",
        "ASEG\u00daRATE DE QUE EL JUGADOR PUEDE USAR TODOS LOS PODERES NECESARIOS SIN IMPORTAR EL PUNTO DE CONTROL DE COOMIENZO"
    ],
    "EDITOR_HINT_23": [
        "USE OBJECT FILTERING TO SELECT OR VIEW ONLY CERTAIN TYPES OF OBJECTS",
        "\u4f7f\u7528\u7269\u4f53\u7b5b\u9009\u6765\u9009\u62e9\u6216\u67e5\u770b\u67d0\u79cd\u7c7b\u578b\u7684\u7269\u4f53",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u30d5\u30a3\u30eb\u30bf\u30ea\u30f3\u30b0\u3092\u4f7f\u3048\u3070\u3001\u7279\u5b9a\u306e\u7a2e\u985e\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u307f\u3092\u9078\u629e\u307e\u305f\u306f\u8868\u793a\u3067\u304d\u307e\u3059",
        "UTILISER LES FILTRES D'OBJET POUR S\u00c9LECTIONNER OU VISUALISER UNIQUEMENT CERTAINS TYPES D'OBJETS",
        "NUTZE OBJEKTFILTER, UM BESTIMMTE OBJEKTARTEN AUSZUW\u00c4HLEN ODER NUR ANZUSEHEN",
        "\uac1c\uccb4 \ud544\ud130\ub9c1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud2b9\uc815 \uc720\ud615\uc758 \uac1c\uccb4\ub9cc \uc120\ud0dd\ud558\uace0 \ubcf4\uc138\uc694.",
        "USA FILTRO OGGETTI PER SELEZIONARE O VISUALIZZARE SOLO CERTI TIPI DI OGGETTO",
        "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0419\u0422\u0415 \u0424\u0418\u041b\u042c\u0422\u0420\u0410\u0426\u0418\u042e \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412, \u0427\u0422\u041e\u0411\u042b \u0412\u042b\u0411\u0418\u0420\u0410\u0422\u042c \u0418\u041b\u0418 \u041f\u0420\u041e\u0421\u041c\u0410\u0422\u0420\u0418\u0412\u0410\u0422\u042c \u0422\u041e\u041b\u042c\u041a\u041e \u041e\u041f\u0420\u0415\u0414\u0415\u041b\u0415\u041d\u041d\u042b\u0415 \u0422\u0418\u041f\u042b \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412",
        "POU\u017dIJ FILTROV\u00c1N\u00cd OBJEKT\u016e K OZNA\u010cEN\u00cd NEBO ZOBRAZEN\u00cd POUZE UR\u010cIT\u00c9HO DRUHU OBJEKT\u016e",
        "K\u00c4YT\u00c4 OBJEKTIEN SUODATUSTA VALITAKSESI TAI TARKISTELLAKSESI VAIN TIETYN TYYPPISI\u00c4 OBJEKTEJA",
        "USE A FILTRAGEM DE OBJETOS PARA SELECIONAR OU EXIBIR APENAS DETERMINADOS TIPOS DE OBJETOS",
        "USA EL FILTRO DE OBJETOS PARA SELECCIONAR O VER SOLO CIERTOS TIPOS DE OBJETOS"
    ],
