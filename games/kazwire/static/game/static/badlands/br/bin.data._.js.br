    "HINT_FLOW_01": [
        "FINISHED A LEVEL?\nPLAY IT AGAIN TO\nCOMPLETE MISSIONS!",
        "\u7ed3\u675f\u4e86\u4e00\u5173\uff1f\n\u518d\u73a9\u4e00\u6b21\n\u5b8c\u6210\u4efb\u52a1\uff01",
