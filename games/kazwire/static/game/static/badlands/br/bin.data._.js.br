    "ACH_79": [
        "PLAY 10 LEVELS IN THE LEVEL WORLD",
        "\u73a9\u5173\u5361\u4e16\u754c\u4e2d\u768410\u4e2a\u5173\u5361",
        "\u300c\u30ec\u30d9\u30eb\u30ef\u30fc\u30eb\u30c9\u300d\u306710\u500b\u306e\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b",
        "JOUER \u00c0 10 NIVEAUX DANS LE MONDE DES NIVEAUX",
        "SPIELE 10 LEVEL IN DER LEVELWELT",
        "\ub808\ubca8 \uc6d4\ub4dc\uc5d0\uc11c \ub808\ubca8 10\uac1c \ud50c\ub808\uc774",
        "GIOCA 10 LIVELLI NEL MONDO DEI LIVELLI",
        "\u0418\u0413\u0420\u0410\u0422\u042c 10 \u0423\u0420\u041e\u0412\u041d\u0415\u0419 \u0412 \u041c\u0418\u0420\u0415 \u0423\u0420\u041e\u0412\u041d\u0415\u0419",
        "HREJ 10 \u00daROVN\u00cd ZE SV\u011aTA \u00daROVN\u00cd",
        "PELAA 10 KENTT\u00c4\u00c4 KENTT\u00c4MAAILMASSA",
        "JOGUE 10 N\u00cdVEIS NO MUNDO DE N\u00cdVEIS",
        "JUEGA 10 NIVELES EN EL MUNDO DE LOS NIVELES"
    ],
    "ETERNAL DAY": [
        "ETERNAL DAY",
        "\u6c38\u6052\u65e5",
        "\u6c38\u9060\u306e\u65e5",
        "JOUR \u00c9TERNEL",
        "EWIGER TAG",
        "\uc601\uc6d0\uc758 \ub0a0",
        "GIORNO ETERNO",
        "\u0412\u0415\u0427\u041d\u042b\u0419 \u0414\u0415\u041d\u042c",
        "V\u011a\u010cN\u00dd DEN",
        "IKUINEN P\u00c4IV\u00c4",
        "DIA ETERNO",
        "D\u00cdA ETERNO"
    ],
    "ETERNAL_DAY_HELP_1": [
        "ETERNAL DAY CONTAINS\r\nTHE FUNNIEST AND MOST CREATIVE\r\nPLAYER CREATED LEVELS",
        "\u6c38\u6052\u65e5\u5305\u542b\n\u6700\u6709\u8da3\u548c\u6700\u5177\u521b\u610f\u7684\n\u73a9\u5bb6\u81ea\u521b\u5173\u5361",
        "\u300c\u6c38\u9060\u306e\u65e5\u300d\u306b\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u624b\u3067\r\n\u4f5c\u6210\u3055\u308c\u305f\u3001\u6700\u3082\u9762\u767d\u304f\r\n\u30af\u30ea\u30a8\u30a4\u30c6\u30a3\u30d6\u306a\u4f5c\u54c1\u304c\u63c3\u3063\u3066\u3044\u307e\u3059",
        "JOUR \u00c9TERNEL CONTIENT\r\nLES NIVEAUX LES PLUS DR\u00d4LES ET LES PLUS ORIGINAUX\r\nCR\u00c9\u00c9S PAR LES JOURS",
        "DER EWIGE TAG ENTH\u00c4LT\r\nDIE LUSTIGSTEN UND KREATIVSTEN\r\nLEVEL DER SPIELER",
        "\uc601\uc6d0\uc758 \ub0a0 \ud2b9\uc9d5\r\n\uac00\uc7a5 \uc7ac\ubbf8\uc788\uace0 \uac00\uc7a5 \ucc3d\uc870\uc801\uc778\r\n\ud50c\ub808\uc774\uc5b4 \uc81c\uc791 \ub808\ubca8",
        "GIORNO ETERNO CONTIENE\nI PI\u00d9 CREATIVI E DIVERTENTI\nLIVELLI CREATI DAI GIOCATORI",
        "\u0412\u0415\u0427\u041d\u042b\u0419 \u0414\u0415\u041d\u042c \u0421\u041e\u0414\u0415\u0420\u0416\u0418\u0422\r\n\u0421\u0410\u041c\u042b\u0415 \u0421\u041c\u0415\u0428\u041d\u042b\u0415 \u0418 \u0418\u041d\u0422\u0415\u0420\u0415\u0421\u041d\u042b\u0415\r\n\u0423\u0420\u041e\u0412\u041d\u0418 \u041e\u0422 \u0418\u0413\u0420\u041e\u041a\u041e\u0412",
        "V\u011a\u010cN\u00dd DEN OBSAHUJE\r\nNEJZ\u00c1BAVN\u011aJ\u0160\u00cd A NEJTVO\u0158IV\u011aJ\u0160\u00cd\r\n\u00daRON\u011a VYTVO\u0158EN\u00c9 HR\u00c1\u010cI",
        "IKUINEN P\u00c4IV\u00c4 SIS\u00c4LT\u00c4\u00c4\r\nHAUSKIMMAT JA MIELIKUVITUKSELLISIMMAT\r\nPELAAJIEN LUOMAT KENT\u00c4T",
        "O DIA ETERNO CONT\u00c9M\r\nOS MAIS DIVERTIDOS E CRIATIVOS\r\nN\u00cdVEIS CRIADOS POR JOGADORES",
        "D\u00cdA ETERNO CONTIENE\r\nLOS NIVELES CREADOS POR JUGADORES\r\nM\u00c1S DIVERTIDOS Y CREATIVOS"
    ],
    "ETERNAL_DAY_HELP_2": [
        "YOU TOO CAN BE PART OF THE ETERNAL DAY\r\nBY CREATING AWESOME LEVELS\r\nWITH THE LEVEL EDITOR!",
        "\u60a8\u4e5f\u53ef\u4ee5\u7528\u5173\u5361\u7f16\u8f91\u5668\n\u521b\u5efa\u7cbe\u5f69\u7684\u5173\u5361\n\u5e76\u6210\u4e3a\u6c38\u6052\u65e5\u7684\u4e00\u5458\uff01",
        "\u3042\u306a\u305f\u3082\u300c\u30ec\u30d9\u30eb\u30a8\u30c7\u30a3\u30bf\u300d\u3067\r\n\u3059\u3054\u3044\u30ec\u30d9\u30eb\u3092\u4f5c\u6210\u3067\u304d\u308c\u3070\r\n\u300c\u6c38\u9060\u306e\u65e5\u300d\u306b\u4ef2\u9593\u5165\u308a\u3067\u304d\u308b\u304b\u3082\uff01",
        "VOUS POUVEZ \u00c9GALEMENT PARTICIPER AU JOUR \u00c9TERNEL\r\nEN CR\u00c9ANT DES NIVEAUX G\u00c9NIAUX\r\nAVEC L'\u00c9DITEUR DE NIVEAUX !",
        "WERDE AUCH TEIL DES EWIGEN TAGS,\r\nINDEM DU MIT DEM LEVEL-EDITOR\r\nFANTASTISCHE LEVEL KREIERST!",
        "\ub2f9\uc2e0\ub3c4 \uc601\uc6d0\uc758 \ub0a0\uc758 \uc77c\ubd80\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\r\n\uba4b\uc9c4 \ub808\ubca8\uc744\r\n\ub808\ubca8 \ud3b8\uc9d1\uae30\ub85c \uc81c\uc791\ud558\uc138\uc694!",
        "ANCHE TU PUOI FAR PARTE DEL GIORNO ETERNO\nCREANDO SPLENDIDI LIVELLI\nCON L'EDITOR!",
        "\u0412\u042b \u0422\u041e\u0416\u0415 \u041c\u041e\u0416\u0415\u0422\u0415 \u0421\u0422\u0410\u0422\u042c \u0427\u0410\u0421\u0422\u042c\u042e \u0412\u0415\u0427\u041d\u041e\u0413\u041e \u0414\u041d\u042f,\r\n\u0421\u041e\u0417\u0414\u0410\u0412\u0410\u042f \u041e\u0422\u041b\u0418\u0427\u041d\u042b\u0415 \u0423\u0420\u041e\u0412\u041d\u0418\r\n\u0421 \u041f\u041e\u041c\u041e\u0429\u042c\u042e \u0420\u0415\u0414\u0410\u041a\u0422\u041e\u0420\u0410 \u0423\u0420\u041e\u0412\u041d\u0415\u0419!",
        "I TY M\u016e\u017dE\u0160 B\u00ddT SOU\u010c\u00c1ST\u00cd V\u011a\u010cN\u00c9HO DNE\r\nVYTV\u00c1\u0158EN\u00cdM \u00da\u017dASN\u00ddCH \u00daROVN\u00cd\r\nPOMOC\u00cd EDITORU \u00daROVN\u00cd",
        "IKUINEN P\u00c4IV\u00c4 VOI OLLA SINUNKIN PAIKKASI,\r\nLUOT VAIN MAKEITA KENTTI\u00c4\r\nKENTT\u00c4EDITORILLA!",
        "VOC\u00ca TAMB\u00c9M PODE FAZER PARTE DO DIA ETERNO\r\nAO CRIAR N\u00cdVEIS ESPETACULARES\r\nCOM O EDITOR DE N\u00cdVEIS!",
        "\u00a1T\u00da TAMBI\u00c9N PUEDES FORMAR PARTE DEL D\u00cdA ETERNO\r\nAL CREAR NIVELES INCRE\u00cdBLES\r\nCON EL EDITOR DE NIVELES!"
    ],
