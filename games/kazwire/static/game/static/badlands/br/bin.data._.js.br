    "IAP_DAYDREAM_DESC": [
        "- 10 NEW LEVELS\n- 30 NEW MISSIONS\n- 4 NEW ACHIEVEMENTS\n- REMOVE ALL ADS\n- PLAY INSTANTLY",
        "- 10 \u4e2a\u65b0\u5173\u5361\n- 30 \u4e2a\u65b0\u4efb\u52a1\n- 4 \u4e2a\u65b0\u6210\u5c31\n- \u79fb\u9664\u6240\u6709\u5e7f\u544a\n- \u7acb\u5373\u6e38\u620f",
        "\uff0d10\u306e\u65b0\u3057\u3044\u30ec\u30d9\u30eb\n\uff0d30\u306e\u65b0\u3057\u3044\u30df\u30c3\u30b7\u30e7\u30f3\n\uff0d4\u3064\u306e\u65b0\u3057\u3044\u5b9f\u7e3e \n\uff0d\u5168\u3066\u306e\u5e83\u544a\u3092\u6392\u9664\n\uff0d\u4eca\u3059\u3050\u30d7\u30ec\u30a4\u53ef\u80fd",
        "- 10 NOUVEAUX NIVEAUX\n- 30 NOUVELLES MISSIONS\n- 4 NOUVEAUX SUCC\u00c8S\n- PUBS SUPPRIM\u00c9ES\n- JOUEZ INSTANTAN\u00c9MENT",
        "- 10 NEUE LEVEL\n- 30 NEUE MISSIONEN\n- 4 NEUE ERFOLGE\n- ALLE WERBUNG ENTFERNEN\n- SOFORT ZU SPIELEN",
        "- \uc2e0\uaddc \ub808\ubca8 10\uac1c\n- \uc2e0\uaddc \ubbf8\uc158 30\uac1c\n- \uc2e0\uaddc \ub3c4\uc804\uacfc\uc81c 4\uac1c\n- \uad11\uace0 \ubaa8\ub450 \uc81c\uac70\n- \uc989\uc2dc \ud50c\ub808\uc774",
        "- 10 NUOVI LIVELLI\n- 30 NUOVE MISSIONI\n- 4 NUOVI OBIETTIVI\n- RIMUOVI LE PUBBLICIT\u00c0\n- GIOCA IMMEDIATAMENTE",
        "- 10 \u041d\u041e\u0412\u042b\u0425 \u0423\u0420\u041e\u0412\u041d\u0415\u0419\n- 30 \u041d\u041e\u0412\u042b\u0425 \u0417\u0410\u0414\u0410\u041d\u0418\u0419\n- 4 \u041d\u041e\u0412\u042b\u0425 \u0414\u041e\u0421\u0422\u0418\u0416\u0415\u041d\u0418\u0419\n- \u0423\u0411\u0420\u0410\u0422\u042c \u0412\u0421\u042e \u0420\u0415\u041a\u041b\u0410\u041c\u0423\n- \u0418\u0413\u0420\u0410\u0419\u0422\u0415 \u0411\u0415\u0417 \u041f\u0420\u041e\u041c\u0415\u0414\u041b\u0415\u041d\u0418\u042f",
        "- 10 NOV\u00ddCH \u00daROVN\u00cd\n- 30 NOV\u00ddCH MIS\u00cd\n- 4 NOV\u00c1 OCEN\u011aN\u00cd\n- BEZ REKLAM\n- OKAM\u017dIT\u00c9 HRAN\u00cd",
        "- 10 UUTTA KENTT\u00c4\u00c4\n- 30 UUTTA TEHT\u00c4V\u00c4\u00c4\n- 4 UUTTA SAAVUTUSTA\n- MAINOSTEN POISTO\n- PELAA HETI",
        "- 10 NOVOS N\u00cdVEIS\n- 30 NOVAS MISS\u00d5ES\n- 4 NOVAS CONQUISTAS\n- SEM AN\u00daNCIOS\n- JOGUE AGORA",
        "- 10 NUEVOS NIVELES\n- 30 NUEVAS MISIONES\n- 4 NUEVOS LOGROS\n- SIN PUBLICIDAD\n- JUEGA AL INSTANTE"
    ],
