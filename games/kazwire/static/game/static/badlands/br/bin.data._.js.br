    "ACH_78": [
        "PUBLISH A LEVEL TO THE LEVEL WORLD",
        "\u5c06\u4e00\u4e2a\u5173\u5361\u53d1\u5e03\u5230\u5173\u5361\u4e16\u754c",
        "\u30ec\u30d9\u30eb\u3092\u300c\u30ec\u30d9\u30eb\u30ef\u30fc\u30eb\u30c9\u300d\u306b\u516c\u958b\u3059\u308b",
        "PUBLIER UN NIVEAU DANS LE MONDE DES NIVEAUX",
        "VER\u00d6FFENTLICHE EINEN LEVEL IN DER LEVELWELT",
        "\ub808\ubca8 \uc6d4\ub4dc\uc5d0 \ub808\ubca8 \uac8c\uc2dc",
        "PUBBLICA UN LIVELLO NEL MONDO DEI LIVELLI",
        "\u041f\u0423\u0411\u041b\u0418\u041a\u0423\u0415\u0422 \u0423\u0420\u041e\u0412\u0415\u041d\u042c \u0412 \u041c\u0418\u0420\u0415 \u0423\u0420\u041e\u0412\u041d\u0415\u0419",
