        "DR\u00dcCKE IM LEVEL NIE DR\u00dcCKEN! KEINE KN\u00d6PFE (EINZELSPIELER)",
        "\uc2f1\uae00\ud50c\ub808\uc774\uc5d0\uc11c\uc5b8\ubc84\ud2bc \ub808\ubca8\uc5d0\uc11c \uc544\ubb34 \ubc84\ud2bc\ub3c4 \ub204\ub974\uc9c0 \uc54a\uae30",
