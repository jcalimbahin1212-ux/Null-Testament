    "HELP_OBJECTPROPERTIES_7": [
        "ENABLES\/DISABLES THE OBJECT'S FUNCTION",
        "\u542f\u7528\/\u7981\u7528\u7269\u4f53\u7684\u529f\u80fd",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u6a5f\u80fd\u3092\u30aa\u30f3\u30fb\u30aa\u30d5\u3057\u307e\u3059",
        "ACTIVE\/D\u00c9SACTIVE LA FONCTION DE L'OBJET",
        "AKTIVIERT\/DEAKTIVIERT DIE FUNKTION DES OBJEKTS",
        "\uac1c\uccb4\uc758 \uae30\ub2a5 \uc0ac\uc6a9\/\uc0ac\uc6a9 \uc548 \ud568",
        "ABILITA\/DISABILITA LA FUNZIONE DELL'OGGETTO",
        "\u0412\u041a\u041b\u042e\u0427\u0410\u0415\u0422\/\u041e\u0422\u041a\u041b\u042e\u0427\u0410\u0415\u0422 \u0424\u0423\u041d\u041a\u0426\u0418\u042e \u041e\u0411\u042a\u0415\u041a\u0422\u0410",
        "POVOL\u00cd\/ZAK\u00c1\u017dE FUNKCI OBJEKTU",
        "OTTAA OBJEKTIN TOIMINNON K\u00c4YTT\u00d6\u00d6N\/POIS K\u00c4YT\u00d6ST\u00c4",
        "HABILITA\/DESABILITA A FUN\u00c7\u00c3O DO OBJETO",
        "ACTIVA\/DESACTIVA LA FUNCI\u00d3N DEL OBJETO"
    ],
    "HELP_OBJECTPROPERTIES_0": [
        "IF ENABLED, THE OBJECT IS AFFECTED BY PHYSICAL FORCES, SUCH AS GRAVITY",
        "\u5982\u542f\u7528\uff0c\u7269\u4f53\u5c06\u53d7\u7269\u7406\u4f5c\u7528\u529b\uff08\u5982\u91cd\u529b\uff09\u7684\u5f71\u54cd",
        "\u30aa\u30f3\u306b\u306a\u308b\u3068\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u91cd\u529b\u306a\u3069\u306e\u7269\u7406\u6cd5\u5247\u306b\u5f71\u97ff\u3055\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002",
        "SI ACTIV\u00c9, DES FORCES PHYSIQUES, TELLES QUE LA GRAVIT\u00c9, SONT ATTRIBU\u00c9ES \u00c0 L'OBJET",
        "DAS OBJEKT WIRD BEI AKTIVIERUNG VON PHYSIKALISCHEN KR\u00c4FTEN WIE GRAVITATION BEEINFLUSST",
        "\uc0ac\uc6a9\ub418\uba74 \uac1c\uccb4\uac00 \uc911\ub825\uacfc \uac19\uc740 \ubb3c\ub9ac\ub825\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4.",
        "SE ABILITATO, L'OGGETTO SUBISCE FORZE FISICHE COME LA GRAVIT\u00c0",
        "\u0415\u0421\u041b\u0418 \u0412\u041a\u041b\u042e\u0427\u0415\u041d\u041e, \u041e\u0411\u042a\u0415\u041a\u0422 \u0411\u0423\u0414\u0415\u0422 \u041f\u041e\u0414\u0412\u0415\u0420\u0416\u0415\u041d \u0424\u0418\u0417\u0418\u0427\u0415\u0421\u041a\u041e\u041c\u0423 \u0412\u0417\u0410\u0418\u041c\u041e\u0414\u0415\u0419\u0421\u0422\u0412\u0418\u042e, \u041d\u0410\u041f\u0420\u0418\u041c\u0415\u0420, \u0413\u0420\u0410\u0412\u0418\u0422\u0410\u0426\u0418\u0418",
        "POKUD POVOLENO, OBJEKT JE OVLIVN\u011aN FYZIK\u00c1LN\u00cd SILOU, JAKO JE GRAVITACE",
        "JOS K\u00c4YT\u00d6SS\u00c4, OBJEKTIIN VAIKUTTAVAT FYYSISET VOIMAT, KUTEN PAINOVOIMA",
        "SE HABILITADO, O OBJETO \u00c9 AFETADO POR FOR\u00c7AS F\u00cdSICAS, COMO A GRAVIDADE",
        "SI SE ACTIVA, AL OBJETO LE AFECTAN LAS LEYES F\u00cdSICAS COMO LA GRAVEDAD"
    ],
    "HELP_OBJECTPROPERTIES_2": [
        "OBJECT COLLISION CUSTOM TAG. CAN BE USED TO DISABLE OR ENABLE COLLISIONS WITH OTHER OBJECTS.",
        "\u7269\u4f53\u78b0\u649e\u81ea\u5b9a\u4e49\u6807\u7b7e\u3002\u53ef\u7528\u4e8e\u7981\u7528\u6216\u542f\u7528\u4e0e\u5176\u4ed6\u7269\u4f53\u7684\u78b0\u649e\u3002",
        "\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u30ab\u30b9\u30bf\u30e0\u885d\u7a81\u5224\u5b9a\u30bf\u30b0\u3002\u4ed6\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u885d\u7a81\u5224\u5b9a\u306e\u6709\u52b9\u30fb\u7121\u52b9\u306e\u8a2d\u5b9a\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002",
        "\u00c9TIQUETTE DE COLLISION D'OBJET PERSONNALIS\u00c9. PEUT \u00caTRE UTILIS\u00c9E POUR ACTIVER OU D\u00c9SACTIVER LES COLLISIONS AVEC D'AUTRES OBJETS.",
        "KOLLISIONSMARKIERUNG VON SPEZIELLEM OBJEKT. KANN GENUTZT WERDEN, UM ZUSAMMENST\u00d6SSE MIT ANDEREN OBJEKTEN ZU AKTIVIEREN ODER DEAKTIVIEREN.",
        "\ucee4\uc2a4\ud140 \uac1c\uccb4 \ucda9\ub3cc \ud0dc\uadf8. \ub2e4\ub978 \uac1c\uccb4\uc640\uc758 \ucda9\ub3cc \ube44\ud65c\uc131\ud654 \ub610\ub294 \ud65c\uc131\ud654\uc5d0 \uc0ac\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "TAG COLLISIONE OGGETTI PERSONALIZZATI. SI PU\u00d2 USARE PER ABILITARE O DISABILITARE LE COLLISIONI CON ALTRI OGGETTI.",
        "\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u0422\u0415\u041b\u042c\u0421\u041a\u0418\u0419 \u0422\u0415\u0413 \u0414\u041b\u042f \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u0419 \u041e\u0411\u042a\u0415\u041a\u0422\u0410. \u041c\u041e\u0416\u0415\u0422 \u0411\u042b\u0422\u042c \u0418\u0421\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u041d, \u0427\u0422\u041e\u0411\u042b \u0420\u0410\u0417\u0420\u0415\u0428\u0410\u0422\u042c \u0418 \u0417\u0410\u041f\u0420\u0415\u0429\u0410\u0422\u042c \u0412\u041e\u0417\u041c\u041e\u0416\u041d\u041e\u0421\u0422\u042c \u0421\u0422\u041e\u041b\u041a\u041d\u041e\u0412\u0415\u041d\u0418\u042f \u0421 \u0414\u0420\u0423\u0413\u0418\u041c\u0418 \u041e\u0411\u042a\u0415\u041a\u0422\u0410\u041c\u0418.",
        "VLASTN\u00cd OZNA\u010cEN\u00cd KOLIZE OBJEKTU. M\u016e\u017dE B\u00ddT VYU\u017dITO K ZAK\u00c1Z\u00c1N\u00cd NEBO POVOLEN\u00cd KOLIZ\u00cd S DAL\u0160\u00cdMI OBJEKTY.",
        "MUKAUTETTU OBJEKTIN T\u00d6RM\u00c4YST\u00c4GI. T\u00c4LL\u00c4 OTETAAN K\u00c4YTT\u00d6\u00d6N\/POIS K\u00c4YT\u00d6ST\u00c4 T\u00d6RM\u00c4YSMAHDOLLISUUS MUIDEN OBJEKTIEN KANSSA",
        "MARCA DE COLIS\u00c3O DE OBJETO PERSONALIZADA. PODE SER USADA PARA HABILITAR OU DESABILITAR COLIS\u00d5ES COM OUTROS OBJETOS.",
        "ETIQUETA DE COLISI\u00d3N DE OBJETOS PERSONALIZADA. SE PUEDE USAR PARA ACTIVAR O DESACTIVAR LAS COLISIONES CON OTROS OBJETOS."
    ],
    "HELP_OBJECTPROPERTIES_129": [
        "IF ENABLED, THE PIVOT POINT IS AFFECTED BY PHYSICAL FORCES",
        "\u5982\u542f\u7528\uff0c\u8f74\u5fc3\u70b9\u5c06\u53d7\u7269\u7406\u4f5c\u7528\u529b\u7684\u5f71\u54cd",
        "\u6709\u52b9\u306e\u72b6\u614b\u3060\u3068\u3001\u56de\u8ee2\u306e\u4e2d\u5fc3\u70b9\u304c\u7269\u7406\u6cd5\u5247\u306b\u5f71\u97ff\u3055\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059",
        "SI ACTIV\u00c9, DES FORCES PHYSIQUES SONT ATTRIBU\u00c9ES AU POINT DE PIVOTEMENT",
        "BEI AKTIVIERUNG WIRD DER DREHPUNKT VON PHYSIKALISCHEN KR\u00c4FTEN BEEINFLUSST",
        "\ud65c\uc131\ud654\ub418\uba74 \ud53c\ubd07 \ud3ec\uc778\ud2b8\uac00 \ubb3c\ub9ac\ub825\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4.",
        "SE ABILITATO, IL FULCRO SUBISCE FORZE FISICHE",
        "\u0415\u0421\u041b\u0418 \u0412\u041a\u041b\u042e\u0427\u0415\u041d\u041e, \u041e\u0421\u042c \u0412\u0420\u0410\u0429\u0415\u041d\u0418\u042f \u0411\u0423\u0414\u0415\u0422 \u041f\u041e\u0414\u0412\u0415\u0420\u0416\u0415\u041d\u0410 \u0414\u0415\u0419\u0421\u0422\u0412\u0418\u042e \u0424\u0418\u0417\u0418\u0427\u0415\u0421\u041a\u0418\u0425 \u0421\u0418\u041b",
        "POKUD JE POVOLENO, BOD OT\u00c1\u010cEN\u00cd JE OVLIVN\u011aN FYZIK\u00c1LN\u00cd SILOU",
        "JOS K\u00c4YT\u00d6SS\u00c4,  FYYSISET VOIMAT VAIKUTTAVAT TUKIPISTEESEEN",
        "SE HABILITADO, O PONTO DE PIV\u00d4 \u00c9 AFETADO POR FOR\u00c7AS F\u00cdSICAS",
        "SI SE ACTIVA, LAS FUERZAS F\u00cdSICAS AFECTAN AL PUNTO DE PIVOTE."
    ],
    "HELP_OBJECTPROPERTIES_123": [
        "DELAY TIME BEFORE SENDING SIGNAL FORWARD",
        "\u5ef6\u8fdf\u53d1\u9001\u4fe1\u53f7\u524d\u7684\u65f6\u95f4",
        "\u30b7\u30b0\u30ca\u30eb\u3092\u9001\u308a\u51fa\u3059\u307e\u3067\u306e\u9045\u5ef6\u6642\u9593",
        "RETARD AVANT DE TRANSMETTRE LE SIGNAL",
        "ZEITVERZ\u00d6GERUNG VOR SIGNALWEITERLEITUNG",
        "\uc2e0\ud638\ub97c \ubcf4\ub0b4\uae30 \uc804\uc758 \uc9c0\uc5f0 \uc2dc\uac04",
        "RITARDO PRIMA DELLA TRASMISSIONE DEL SEGNALE",
        "\u0412\u0420\u0415\u041c\u042f \u0417\u0410\u0414\u0415\u0420\u0416\u041a\u0418 \u041e\u0422\u041f\u0420\u0410\u0412\u041b\u0415\u041d\u0418\u042f \u0421\u0418\u0413\u041d\u0410\u041b\u0410 \u0412\u041f\u0415\u0420\u0415\u0414",
        "ZPOZD\u00cd \u010cAS P\u0158ED POSL\u00c1N\u00cdM SIGN\u00c1LU VP\u0158ED",
        "VIIVEAIKA ENNEN SIGNAALIN V\u00c4LITT\u00c4MIST\u00c4",
        "TEMPO DE RETARDO ANTES DE ENVIAR O SINAL ADIANTE",
        "TIEMPO ANTES DE MANDAR LA SE\u00d1AL"
    ],
    "HELP_OBJECTPROPERTIES_84_0": [
        "GAME CAMERA TO NORMAL MODE",
        "\u6e38\u620f\u955c\u5934\u4e3a\u6b63\u5e38\u6a21\u5f0f",
        "\u30b2\u30fc\u30e0\u30ab\u30e1\u30e9\u3092\u901a\u5e38\u30e2\u30fc\u30c9\u3078",
        "CAM\u00c9RA EN MODE NORMAL",
        "SPIELKAMERA AUF NORMAL-MODUS",
        "\uc77c\ubc18 \ubaa8\ub4dc\uc758 \uac8c\uc784 \uce74\uba54\ub77c",
        "VISUALE DI GIOCO IN MODALIT\u00c0 NORMALE",
        "\u0412\u0415\u0420\u041d\u0423\u0422\u042c \u041a\u0410\u041c\u0415\u0420\u0423 \u0418\u0413\u0420\u042b \u0412 \u041d\u041e\u0420\u041c\u0410\u041b\u042c\u041d\u042b\u0419 \u0420\u0415\u0416\u0418\u041c",
