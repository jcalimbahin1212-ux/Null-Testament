    "HINT_RERUN_03": [
        "READY FOR EXTREME CHALLENGE?\nTRY AND SURVIVE THE DOOMSDAY LEVELS",
        "\u51c6\u5907\u597d\u8fce\u63a5\u7ec8\u6781\u6311\u6218\u4e86\u5417\uff1f\n\u5c1d\u8bd5\u5728\u4e16\u754c\u672b\u65e5\u5173\u5361\u4e2d\u751f\u5b58\u4e0b\u6765",
        "\u6700\u51f6\u306e\u8a66\u7df4\u306b\u7acb\u3061\u5411\u304b\u3046\u899a\u609f\u306f\u3044\u3044\u304b\uff1f\n\u300c\u7d42\u672b\u306e\u65e5\u300d\u30ec\u30d9\u30eb\u306b\u6311\u6226\u3057\u3066\u751f\u304d\u6b8b\u308c",
        "PR\u00caT POUR UN D\u00c9FI EXTR\u00caME ?\nESSAYEZ DE SURVIVRE AUX NIVEAUX DE FIN DU MONDE",
        "BEREIT F\u00dcR DIE ULTIMATIVE HERAUSFORDERUNG?\nVERSUCHE, DIE J\u00dcNGSTER-TAG-LEVEL ZU \u00dcBERLEBEN",
        "\uadf9\ud55c \ub3c4\uc804\uc5d0 \uc900\ube44\ub418\uc168\ub098\uc694?\nDOOMSDAY \ub808\ubca8\uc5d0 \ub3c4\uc804\ud558\uace0 \uc0b4\uc544\ub0a8\uc73c\uc138\uc694.",
        "SEI PRONTO PER UNA SFIDA ESTREMA?\nCERCA DI SOPRAVVIVERE AI LIVELLI APOCALISSE",
        "\u0413\u041e\u0422\u041e\u0412\u042b \u041a \u042d\u041a\u0421\u0422\u0420\u0415\u041c\u0410\u041b\u042c\u041d\u041e\u041c\u0423 \u0418\u0421\u041f\u042b\u0422\u0410\u041d\u0418\u042e?\n\u041f\u041e\u041f\u0420\u041e\u0411\u0423\u0419\u0422\u0415 \u0412\u042b\u0416\u0418\u0422\u042c \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u042f\u0425  \u00ab\u0421\u0423\u0414\u041d\u042b\u0419 \u0414\u0415\u041d\u042c\u00bb",
        "P\u0158IPRAVEN NA EXTR\u00c9MN\u00cd V\u00ddZVU?\nZKUS A P\u0158E\u017dIJ \u00daROVN\u011a SOUDN\u00c9HO DNE",
        "OLETKO VALMIINA EXTREME-HAASTEESEEN?\nL\u00c4P\u00c4ISE TUOMIOP\u00c4IV\u00c4N KENT\u00c4T",
        "PRONTO PARA UM DESAFIO EXTREMO?\nTENTE SOBREVIVER AOS N\u00cdVEIS DO JU\u00cdZO FINAL",
        "\u00bfLISTO PARA UN DESAF\u00cdO EXTREMO?\nINTENTA SOBREVIVIR A LOS NIVELES DEL D\u00cdA DEL JUICIO"
    ],
