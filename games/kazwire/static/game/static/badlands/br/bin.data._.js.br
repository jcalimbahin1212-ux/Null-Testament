    "ACH_63": [
        "MISS ALL DECREASE SIZE POWERUPS IN THE LEVEL CLONEFEST IN COOP WITHOUT DYING",
        "\u5728\u5408\u4f5c\u6a21\u5f0f\u4e0b\uff0c\u8eb2\u8fc7\u514b\u9686\u8282\u5173\u7684\u6240\u6709\u4e2a\u4f53\u7f29\u5c0f\u9053\u5177\u800c\u672a\u6b7b\u4ea1",
        "\u5354\u529b\u30e2\u30fc\u30c9\u306e\u300cCLONEFEST\u300d\u3067\u6b7b\u306a\u305a\u306b\u5c0f\u3055\u304f\u306a\u308b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30921\u3064\u3082\u53d6\u3089\u306a\u3044",
        "\u00c9VITEZ LES POWER-UPS DE MINIMISATION AU NIVEAU CLONEFEST SANS MOURIR",
        "ALLE VERKLEINERN-POWERUPS IM LEVEL  KLONFEST IN KOOP AUSGELASSEN, OHNE ZU STERBEN",
        "\ud611\ub3d9 \ubaa8\ub4dc \ub808\ubca8 \ud074\ub860\ud398\uc2a4\ud2b8\uc5d0\uc11c \uc8fd\uc9c0 \uc54a\uace0 \ubaa8\ub4e0 \ud30c\uc6cc\uc5c5 \uc2a4\ud0b5",
        "MANCA TUTTI I POWER-UP RIMPICCIOLENTI NEL LIVELLO CLONEMANIA IN COOP SENZA MORIRE",
        "\u041f\u0420\u041e\u041f\u0423\u0429\u0415\u041d\u042b \u0412\u0421\u0415 \u0423\u041c\u0415\u041d\u042c\u0428\u0415\u041d\u0418\u042f \u0420\u0410\u0417\u041c\u0415\u0420\u0410 \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u0415 \u00ab\u0424\u0415\u0421\u0422\u0418\u0412\u0410\u041b\u042c\u00bb \u0412 \u0421\u041e\u0412\u041c\u0415\u0421\u0422\u041d\u041e\u041c \u0420\u0415\u0416\u0418\u041c\u0415.",
        "MINUL JSI V\u0160ECHNY ZMEN\u0160OVAC\u00cd BONUSY V \u00daROVNI KLONFEST V KOOPERACI BEZ UM\u0158EN\u00cd",
        "OHITA PIENENNYSLIS\u00c4VOIMAT KENT\u00c4SS\u00c4 KLOONIRY\u00d6PPY YHTEISPELISS\u00c4 KUOLEMATTA",
        "PULOU B\u00d4NUS DIM. FESTA CLONE EM COOP SEM MORRER",
        "EVITA LOS PODERES REDUCTORES EN EL NIVEL CLONEFEST DEL MODO COOPERATIVO SIN MORIR"
    ],
    "ACH_68": [
        "EXPLODE THE HIDDEN MINE IN THE LEVEL SWITCH IN SINGLE PLAYER",
        "\u5728\u5355\u4eba\u6e38\u620f\u4e2d\u5728\u5f00\u5173\u4e00\u5173\u5f15\u7206\u9690\u85cf\u7684\u5730\u96f7",
        "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30fb\u30e2\u30fc\u30c9\u3067\u30ec\u30d9\u30eb\u300cSWITCH\u300d\u3067\u96a0\u3055\u308c\u305f\u5730\u96f7\u3092\u7206\u767a\u3055\u305b\u308b",
        "FAITES EXPLOSER LA MINE CACH\u00c9E DANS LE NIVEAU SWITCH EN MODE SOLO",
        "SPRENGE DIE VERBORGENE MINE IM LEVEL WECHSEL (EINZELSPIELER)",
        "\uc2f1\uae00\ud50c\ub808\uc774\uc5d0\uc11c\uc2a4\uc704\uce58\ub808\ubca8\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc9c0\ub8b0 \ud3ed\ubc1c",
        "FAI ESPLODERE LA MINA NASCOSTA NEL LIVELLO INTERRUTTORE DA GIOCATORE SINGOLO",
        "\u0418\u0421\u0421\u041b\u0415\u0414\u0423\u0419\u0422\u0415 \u041f\u041e\u0422\u0410\u0419\u041d\u0423\u042e \u0428\u0410\u0425\u0422\u0423 \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u0415 \u00ab\u0422\u0423\u041c\u0411\u041b\u0415\u0420\u00bb \u0412 \u0420\u0415\u0416\u0418\u041c\u0415 \u041e\u0414\u0418\u041d\u041e\u0427\u041d\u041e\u0419 \u0418\u0413\u0420\u042b",
        "NECH VYBUCHNOUT TAJNOU BOMBU V \u00daROVNI VYP\u00cdNA\u010c (JEDNOHO HR\u00c1\u010cE)",
        "R\u00c4J\u00c4YT\u00c4 PIILOTETTU MIINA KYTKIN-KENT\u00c4SS\u00c4 YKSINPELISS\u00c4",
        "EXPLODA A MINA OCULTA NO N\u00cdVEL COMUTA\u00c7\u00c3O EM SINGLE PLAYER",
        "EXPLOTA LA MINA OCULTA EN EL NIVEL SWITCH EN EL MODO DE 1 JUGADOR"
    ],
