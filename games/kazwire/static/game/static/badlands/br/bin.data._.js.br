    "POP_PUSH_DISABLED_NOTE": [
        "YOU CAN RE-ENABLE PUSH NOTIFICATIONS\nAT ANY TIME TO RECEIVE NEWS",
        "\u60a8\u53ef\u4ee5\u968f\u65f6\u91cd\u65b0\u542f\u7528\n\u63a8\u9001\u901a\u77e5\u6765\u83b7\u53d6\u5f00\u53d1\u8005\n\u7684\u6700\u65b0\u52a8\u6001",
        "\u958b\u767a\u30c1\u30fc\u30e0\u304b\u3089\u30cb\u30e5\u30fc\u30b9\u3092\u53d7\u3051\u53d6\u308a\u305f\u3044\u5834\u5408\u306f\u3001\n\u3044\u3064\u3067\u3082\u30d7\u30c3\u30b7\u30e5\u901a\u77e5\u3092\u518d\u3073\u6709\u52b9\u5316\u3067\u304d\u307e\u3059\u3002",
        "VOUS POUVEZ R\u00c9ACTIVER LES NOTIFICATIONS PUSH\n\u00c0 TOUT MOMENT POUR RECEVOIR DES INFORMATIONS\nDES D\u00c9VELOPPEURS.",
        "DU KANNST DIE PUSH-BENACHRICHTIGUNGEN\nJEDERZEIT WIEDER AKTIVIEREN,\nUM NEWS ZU BEKOMMEN",
        "\uac1c\ubc1c\uc790\ub85c\ubd80\ud130 \uc0c8 \uc18c\uc2dd\uc744 \ubc1b\uc73c\ub824\uba74\n\uc5b8\uc81c\ub4e0\uc9c0 \ud478\uc2dc \uc54c\ub9bc\uc744\n\ub2e4\uc2dc \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "PUOI RIATTIVARE LE NOTIFICHE PUSH\nIN QUALSIASI MOMENTO PER RICEVERE NOTIZIE\nDAGLI SVILUPPATORI.",
        "PUSH-\u0423\u0412\u0415\u0414\u041e\u041c\u041b\u0415\u041d\u0418\u042f \u041c\u041e\u0416\u041d\u041e \u0412\u041a\u041b\u042e\u0427\u0418\u0422\u042c\n\u0412 \u041b\u042e\u0411\u041e\u0415 \u0412\u0420\u0415\u041c\u042f, \u0427\u0422\u041e\u0411\u042b \u041f\u041e\u041b\u0423\u0427\u0410\u0422\u042c \u041d\u041e\u0412\u041e\u0421\u0422\u0418\n\u041e\u0422 \u0420\u0410\u0417\u0420\u0410\u0411\u041e\u0422\u0427\u0418\u041a\u041e\u0412.",
        "UPOZORN\u011aN\u00cd TYPU PUSH M\u016e\u017dE\u0160\nKDYKOLIV ZAPNOUT",
        "VOIT OTTAA PUSH-ILMOITUKSET\nUUDELLEEN K\u00c4YTT\u00d6\u00d6N KOSKA TAHANSA",
        "VOC\u00ca PODE HABILITAR NOVAMENTE AS NOTIFICA\u00c7\u00d5ES\nPOR PUSH A QUALQUER MOMENTO PARA RECEBER\nNOT\u00cdCIAS DOS DESENVOLVEDORES.",
        "PUEDES VOLVER A ACTIVAR LAS NOTIFICACIONES\nEN CUALQUIER MOMENTO PARA RECIBIR NOTICIAS"
