    "HINT_RERUN_00": [
        "FINISHED A LEVEL?\nWATCH YOUR REPLAY AND SHARE\nIT TO THE WORLD!",
        "\u7ed3\u675f\u4e86\u4e00\u5173\uff1f\n\u89c2\u770b\u60a8\u7684\u6e38\u620f\u91cd\u64ad\n\u5e76\u5411\u5168\u4e16\u754c\u5206\u4eab\uff01",
        "\u30ec\u30d9\u30eb\u3092\u7d42\u4e86\u3057\u307e\u3057\u305f\u304b\uff1f\n\u81ea\u5206\u306e\u30ea\u30d7\u30ec\u30a4\u3092\u898b\u3066\n\u4e16\u754c\u4e2d\u306b\u30b7\u30a7\u30a2\u3057\u3088\u3046\uff01",
        "VOUS AVEZ TERMIN\u00c9 UN NIVEAU\u00a0?\nREGARDEZ VOTRE REPLAY ET PARTAGEZ-\nLE AVEC LE MONDE ENTIER\u00a0!",
        "EIN LEVEL BEENDET?\nSIEH DIR DIE WIEDERHOLUNG AN UND TEILE\nSIE MIT DER WELT!",
        "\ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub098\uc694?\n\ub9ac\ud50c\ub808\uc774\ub97c \uac10\uc0c1\ud558\uace0\n\uc804 \uc138\uacc4\uc5d0 \uacf5\uc720\ud558\uc138\uc694!",
        "HAI TERMINATO UN LIVELLO?\nGUARDA IL TUO REPLAY E\nCONDIVIDILO CON TUTTI!",
        "\u0423\u0420\u041e\u0412\u0415\u041d\u042c \u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041d?\n\u041f\u041e\u0421\u041c\u041e\u0422\u0420\u0418\u0422\u0415 \u041f\u041e\u0412\u0422\u041e\u0420 \u0418\u0413\u0420\u042b \u0418 \u041f\u041e\u041a\u0410\u0416\u0418\u0422\u0415\n\u0415\u0413\u041e \u0412\u0421\u0415\u041c\u0423 \u041c\u0418\u0420\u0423!",
        "DOKON\u010cIL JSI \u00daROVE\u0147?\nPROHL\u00c9DNI SI Z\u00c1ZNAM\nA SD\u00cdLEJ HO!",
        "KENTT\u00c4 L\u00c4PI?\nKATSO UUSINTA JA \nJAA SE MAAILMALLE!",
        "TERMINOU UM N\u00cdVEL?\nASSISTA O REPLAY E COMPARTILHE\nCOM TODO MUNDO!",
        "\u00bfHAS FINALIZADO UN NIVEL?\n\u00a1MIRA LA REPETICI\u00d3N Y\nCOMP\u00c1RTELA CON EL MUNDO!"
    ],
