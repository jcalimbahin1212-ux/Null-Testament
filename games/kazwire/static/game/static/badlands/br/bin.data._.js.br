        "- FULL SINGLE PLAYER CAMPAIGN WITH %d LEVELS\n- ALL %d CRAZY MULTIPLAYER LEVELS",
        "- \u5b8c\u6574\u7684\u5355\u4eba\u6a21\u5f0f\u7b80\u5355\u7ade\u6280\uff0c\u5305\u542b%d\u4e2a\u5173\u5361\n- \u6240\u6709 %d \u7cbe\u5f69\u523a\u6fc0\u7684\u591a\u4eba\u6a21\u5f0f\u5173\u5361",
        "- %d\u306e\u30ec\u30d9\u30eb\u304c\u697d\u3057\u3081\u308b\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\n- %d\u3064\u306e\u65b0\u3057\u3044\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30ec\u30d9\u30eb",
        "- CAMPAGNE SOLO COMPL\u00c8TE AVEC %d NIVEAUX\n- LES %d NIVEAUX MULTIJOUEURS MABOULS",
        "- KOMPLETTE EINZELSPIELER-KAMPGANE MIT %d LEVELN\n- ALLE %d MULTIPLAYER-LEVEL",
        "- %d\uac1c\uc758 \ub808\ubca8\uc774 \ud3ec\ud568\ub41c \uc644\uc804\ud55c \uc2f1\uae00\ud50c\ub808\uc774 \ucea0\ud398\uc778\n- \ubaa8\ub4e0 %d\uac1c\uc758 \uc885\ud6a1\ubb34\uc9c4 \uba40\ud2f0\ud50c\ub808\uc774 \ub808\ubca8",
        "- CAMPAGNA COMPLETA GIOCATORE SINGOLO CON %d LIVELLI\n- TUTTI I %d LIVELLI MULTIGIOCATORE",
        "- \u041f\u041e\u041b\u041d\u0410\u042f \u041e\u0414\u041d\u041e\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u0422\u0415\u041b\u042c\u0421\u041a\u0410\u042f \u041a\u0410\u041c\u041f\u0410\u041d\u0418\u042f \u041d\u0410 %d \u0423\u0420\u041e\u0412\u041d\u0415\u0419\n- \u0412\u0421\u0415 \u0421\u0423\u041c\u0410\u0421\u0428\u0415\u0414\u0428\u0418\u0415 \u041c\u041d\u041e\u0413\u041e\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u0422\u0415\u041b\u042c\u0421\u041a\u0418\u0415 \u0423\u0420\u041e\u0412\u041d\u0418 (%d)",
        "- CEL\u00c1 KAMPA\u0147 JEDNOHO HR\u00c1\u010cE S %d LEVELY\n- V\u0160ECH %d \u0160\u00cdLEN\u00ddCH \u00daROVN\u00cd PRO V\u00cdCE HR\u00c1\u010c\u016e",
        "\u2013 T\u00c4YSIMITTAINEN YKSINPELIKAMPANJA, JOSSA ON %d KENTT\u00c4\u00c4\n\u2013 KAIKKI %d HULLUA MONINPELIKENTT\u00c4\u00c4.",
