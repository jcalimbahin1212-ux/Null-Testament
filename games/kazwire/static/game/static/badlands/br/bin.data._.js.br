    "EDITOR_WARNING_CHECKPOINT_LIMIT_TITLE": [
        "CHECKPOINT LIMIT REACHED!",
        "\u5df2\u8fbe\u5230\u5b58\u6863\u70b9\u4e0a\u9650\uff01",
        "\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u4e0a\u9650\u306b\u5230\u9054\uff01",
        "LIMITE DE POINT DE CONTR\u00d4LE ATTEINTE !",
        "KONTROLLPUNKTLIMIT ERREICHT!",
        "\uccb4\ud06c\ud3ec\uc778\ud2b8 \ud55c\ub3c4 \ub3c4\ub2ec!",
        "RAGGIUNTO LIMITE CHECKPOINT!",
        "\u0414\u041e\u0421\u0422\u0418\u0413\u041d\u0423\u0422\u041e \u041c\u0410\u041a\u0421\u0418\u041c\u0410\u041b\u042c\u041d\u041e\u0415 \u0427\u0418\u0421\u041b\u041e \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c\u041d\u042b\u0425 \u0422\u041e\u0427\u0415\u041a!",
        "DOS\u00c1HL JSI LIMITU Z\u00c1CHYTN\u00ddCH BOD\u016e!",
        "MAKSIMIM\u00c4\u00c4R\u00c4 JATKOPISTEIT\u00c4!",
        "LIMITE DE PONTOS DE CONTROLE ATINGIDO!",
        "\u00a1L\u00cdMITE DE PUNTOS DE CONTROL ALCANZADO!"
    ],
    "EDITOR_WARNING_CHECKPOINT_LIMIT_MESSAGE": [
        "REMOVE UNNECESSARY CHECKPOINTS TO ADD NEW ONES",
        "\u79fb\u9664\u4e0d\u5fc5\u8981\u7684\u5b58\u6863\u70b9\u6765\u6dfb\u52a0\u65b0\u5b58\u6863\u70b9",
        "\u65b0\u3057\u3044\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u3092\u8ffd\u52a0\u3059\u308b\u306b\u306f\u53e4\u3044\u3082\u306e\u3092\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044",
        "SUPPRIME LES POINTS DE CONTR\u00d4LE INUTILES POUR EN ACHETER DE NOUVEAUX",
        "ENTFERNE NICHT BEN\u00d6TIGTE KONTROLLPUNKTE, UM NEUE HINZUZUF\u00dcGEN",
        "\ubd88\ud544\uc694\ud55c \uccb4\ud06c\ud3ec\uc778\ud2b8\ub97c \uc81c\uac70\ud558\uc5ec \uc0c8\ub85c \ucd94\uac00",
        "RIMUOVI CHECKPOINT INUTILI PER AGGIUNGERNE DI NUOVI",
        "\u0423\u0414\u0410\u041b\u0418\u0422\u0415 \u041d\u0415\u041d\u0423\u0416\u041d\u042b\u0415 \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c\u041d\u042b\u0415 \u0422\u041e\u0427\u041a\u0418, \u0427\u0422\u041e\u0411\u042b \u0414\u041e\u0411\u0410\u0412\u0418\u0422\u042c \u041d\u041e\u0412\u042b\u0415",
        "ODSTRA\u0147 NEPOT\u0158EBN\u00c9 Z\u00c1CHYTN\u00c9 BODY, ABYS MOHL P\u0158IDAT NOV\u00c9.",
        "POISTA TARPEETTOMIA JATKOPISTEIT\u00c4, JOTTA VOIT LIS\u00c4T\u00c4 UUSIA",
        "REMOVA PONTOS DE CONTROLE DESNECESS\u00c1RIOS PARA ADICIONAR NOVOS",
        "ELIMINA LOS PUNTOS DE CONTROL INNECESARIOS PARA A\u00d1ADIR NUEVOS"
    ],
    "EDITOR_WARNING_CHECKPOINT_LIMIT_WARNING_TITLE": [
        "CHECKPOINT LIMIT WARNING!",
        "\u5b58\u6863\u70b9\u9650\u5236\u8b66\u544a\uff01",
        "\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u4e0a\u9650\u8b66\u544a\uff01",
