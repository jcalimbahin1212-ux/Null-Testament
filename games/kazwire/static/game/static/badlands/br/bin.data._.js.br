        "LA VISUALE DI GIOCO SEGUE I CLONI",
        "\u041a\u0410\u041c\u0415\u0420\u0410 \u0418\u0413\u0420\u042b \u0421\u041b\u0415\u0414\u0423\u0415\u0422 \u0417\u0410 \u041a\u041b\u041e\u041d\u0410\u041c\u0418",
