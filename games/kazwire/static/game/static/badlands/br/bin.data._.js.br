        "STOPPE NICHT DIE ZEIT IM LEVEL DURCHGEDREHT (EINZELSPIELER)",
        "\uc2f1\uae00\ud50c\ub808\uc774\uc5d0\uc11c\ud50c\ub9ac\ud551 \ub808\ubca8\uc5d0\uc11c \uc2dc\uac04\uc744 \uba48\ucd94\uc9c0 \uc54a\uae30",
        "NON FERMARE IL TEMPO IN SOTTOSOPRA DA GIOCATORE SINGOLO",
        "\u041d\u0415 \u041e\u0421\u0422\u0410\u041d\u0410\u0412\u041b\u0418\u0412\u0410\u0419\u0422\u0415 \u0412\u0420\u0415\u041c\u042f \u041d\u0410 \u0423\u0420\u041e\u0412\u041d\u0415  \u00ab\u041f\u0415\u0420\u0415\u0411\u0420\u041e\u0421\u00bb \u0412 \u0420\u0415\u0416\u0418\u041c\u0415 \u041e\u0414\u0418\u041d\u041e\u0427\u041d\u041e\u0419 \u0418\u0413\u0420\u042b",
        "NEZASTAVUJ \u010cAS V \u00daROVNI HOD (JEDNOHO HR\u00c1\u010cE)",
        "\u00c4L\u00c4 PYS\u00c4YT\u00c4 AIKAA FLIPPAUS-KENT\u00c4SS\u00c4 YKSINPELISS\u00c4",
        "N\u00c3O PARE O TEMPO NO N\u00cdVEL FLIPANDO EM SINGLE PLAYER",
        "NO DETENGAS EL TIEMPO EN EL NIVEL FLIPPING EN EL MODO DE 1 JUGADOR"
    ],
